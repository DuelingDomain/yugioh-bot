{
 "name": "Sign in from new device",
 "subject": "New sign in to your Dueling Domain account",
 "markup": "<re-html>\n<re-head>\n    <re-title>\n        New sign in to your Dueling Domain account\n    </re-title>\n</re-head>\n<re-body background-color=\"#0A0E1A\" padding=\"28px 16px 40px 16px\">\n    <re-preheader>\n        A new device just signed in to your account.\n    </re-preheader>\n    <re-header padding=\"0px 0px 20px 22px\">\n        <re-image src=\"https://duelingdomain.com/logo-512.png\" width=\"44\" alt=\"Dueling Domain\" href=\"https://duelingdomain.com\"></re-image>\n    </re-header>\n    <re-main background-color=\"#141929\" border-radius=\"12px\">\n        <re-block border-radius=\"12px\" align=\"left\" padding=\"36px 32px 40px 32px\" background-color=\"#141929\" font-size=\"16px\">\n            <re-text margin=\"0px 0px 0px 0px\" font-size=\"12px\" line-height=\"16px\" font-weight=\"bold\" color=\"#C9A45C\">SECURITY NOTICE</re-text>\n            <re-heading margin=\"10px 0px 0px 0px\" level=\"h1\" align=\"left\" color=\"#E8ECF4\" font-size=\"28px\" line-height=\"34px\">New sign in to your account</re-heading>\n            <re-text margin=\"16px 0px 0px 0px\" align=\"left\" font-size=\"16px\" line-height=\"26px\" color=\"#C9D0E4\">A new device just signed in to your Dueling Domain account. If that was you, you can ignore this email.</re-text>\n            <re-block margin=\"24px 0px 0px 0px\" padding=\"0px\" background-color=\"#0E1224\" border-radius=\"10px\">\n                {{#if sign_in_method}}\n                <re-grid>\n                    <re-column width=\"38%\" padding=\"10px 8px 10px 16px\" background-color=\"#0E1224\"><re-text font-size=\"14px\" color=\"#AEB7D0\">Sign in type</re-text></re-column>\n                    <re-column width=\"62%\" padding=\"10px 16px 10px 0\" background-color=\"#0E1224\"><re-text font-size=\"14px\" font-weight=\"bold\" color=\"#E8ECF4\">{{sign_in_method}}</re-text></re-column>\n                </re-grid>\n                {{/if}}\n                <re-grid>\n                    <re-column width=\"38%\" padding=\"10px 8px 10px 16px\" background-color=\"#0E1224\"><re-text font-size=\"14px\" color=\"#AEB7D0\">Device</re-text></re-column>\n                    <re-column width=\"62%\" padding=\"10px 16px 10px 0\" background-color=\"#0E1224\"><re-text font-size=\"14px\" font-weight=\"bold\" color=\"#E8ECF4\">{{browser_name}} on {{operating_system}}</re-text></re-column>\n                </re-grid>\n                <re-grid>\n                    <re-column width=\"38%\" padding=\"10px 8px 10px 16px\" background-color=\"#0E1224\"><re-text font-size=\"14px\" color=\"#AEB7D0\">Location</re-text></re-column>\n                    <re-column width=\"62%\" padding=\"10px 16px 10px 0\" background-color=\"#0E1224\"><re-text font-size=\"14px\" font-weight=\"bold\" color=\"#E8ECF4\">{{location}}</re-text></re-column>\n                </re-grid>\n                <re-grid>\n                    <re-column width=\"38%\" padding=\"10px 8px 10px 16px\" background-color=\"#0E1224\"><re-text font-size=\"14px\" color=\"#AEB7D0\">IP</re-text></re-column>\n                    <re-column width=\"62%\" padding=\"10px 16px 10px 0\" background-color=\"#0E1224\"><re-text font-size=\"14px\" font-weight=\"bold\" color=\"#E8ECF4\">{{ip_address}}</re-text></re-column>\n                </re-grid>\n                <re-grid>\n                    <re-column width=\"38%\" padding=\"10px 8px 10px 16px\" background-color=\"#0E1224\"><re-text font-size=\"14px\" color=\"#AEB7D0\">Time</re-text></re-column>\n                    <re-column width=\"62%\" padding=\"10px 16px 10px 0\" background-color=\"#0E1224\"><re-text font-size=\"14px\" font-weight=\"bold\" color=\"#E8ECF4\">{{session_created_at}}</re-text></re-column>\n                </re-grid>\n            </re-block>\n            {{#if revoke_session_url}}\n            <re-text margin=\"16px 0px 0px 0px\" align=\"left\" font-size=\"16px\" line-height=\"26px\" color=\"#C9D0E4\">Don't recognize it? Sign out of that device now.</re-text>\n            <re-button padding=\"14px 28px\" href=\"{{revoke_session_url}}\" font-size=\"16px\" border-radius=\"8px\" margin=\"28px 0px 0px 0px\" background-color=\"#6D2BDB\" color=\"#ffffff\">Sign out of that device</re-button>\n            <re-text margin=\"16px 0px 0px 0px\" align=\"left\" font-size=\"14px\" line-height=\"22px\" color=\"#AEB7D0\"><a href=\"{{revoke_session_url}}\" style=\"color:#A78BFA;text-decoration:underline;\">Button not working? Sign out of that device</a></re-text>\n            {{/if}}\n        </re-block>\n    </re-main>\n    <re-footer padding=\"24px 32px 0px 32px\">\n        <re-text margin=\"0px 0px 0px 0px\" font-size=\"13px\" line-height=\"20px\" color=\"#8892B0\">You're getting this because a new device signed in to your Dueling Domain account.</re-text>\n        <re-text margin=\"6px 0px 0px 0px\" font-size=\"13px\" line-height=\"20px\" color=\"#8892B0\">Questions? Email <a href=\"mailto:support@duelingdomain.com\" style=\"color:#AEB7D0;text-decoration:underline;\">support@duelingdomain.com</a>.</re-text>\n    </re-footer>\n</re-body>\n</re-html>\n",
 "body": "<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<meta name=\"supported-color-schemes\" content=\"dark light\">\n<title>New sign in to your Dueling Domain account</title>\n<style type=\"text/css\">\n@font-face{font-family:'Russo One';font-style:normal;font-weight:400;src:url(https://duelingdomain.com/fonts/russo-one-400-latin.woff2) format('woff2');}\n@font-face{font-family:'Russo One';font-style:normal;font-weight:700;src:url(https://duelingdomain.com/fonts/russo-one-400-latin.woff2) format('woff2');}\n@font-face{font-family:'Chakra Petch';font-style:normal;font-weight:400;src:url(https://duelingdomain.com/fonts/chakra-petch-400-latin.woff2) format('woff2');}\n@font-face{font-family:'Chakra Petch';font-style:normal;font-weight:700;src:url(https://duelingdomain.com/fonts/chakra-petch-700-latin.woff2) format('woff2');}\n:root{color-scheme:dark light;supported-color-schemes:dark light;}\nbody,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}\ntable,td{mso-table-lspace:0;mso-table-rspace:0;}\nimg{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;}\nbody{margin:0;padding:0;width:100%!important;background-color:#0A0E1A;}\na{color:#A78BFA;}\n@media all and (max-width:599px){\n  .container{width:100%!important;}\n  .pad{padding:28px 20px 32px 20px!important;}\n  .otp p{font-size:36px!important;letter-spacing:7px!important;line-height:44px!important;}\n  .lg{padding-left:16px!important;}\n  .ft{padding-left:20px!important;padding-right:20px!important;}\n  .btn-table{width:100%!important;}\n  .btn{display:block!important;padding-left:12px!important;padding-right:12px!important;white-space:normal!important;}\n  h1{font-size:26px!important;line-height:32px!important;}\n}\n</style>\n<!--[if mso]><style type=\"text/css\">body,table,td,a,p,h1{font-family:Arial,Helvetica,sans-serif!important;}</style><![endif]-->\n</head>\n<body bgcolor=\"#0A0E1A\" style=\"margin:0;padding:0;background-color:#0A0E1A;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;\">\n<span style=\"display:none;max-height:0;max-width:0;opacity:0;overflow:hidden;visibility:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#0A0E1A;\">A new device just signed in to your account.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</span>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#0A0E1A\" style=\"width:100%;background-color:#0A0E1A;\"><tr>\n<td align=\"center\" valign=\"top\" style=\"padding:28px 16px 40px 16px;background-color:#0A0E1A;\">\n<!--[if mso]><table role=\"presentation\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"560\"><tr><td><![endif]--><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"560\" class=\"container\" style=\"width:560px;max-width:560px;\"><tr><td align=\"left\" valign=\"top\" class=\"lg\" style=\"padding:0 0 20px 22px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td valign=\"middle\" style=\"padding:0;\"><a href=\"https://duelingdomain.com\" target=\"_blank\" style=\"text-decoration:none;\"><img src=\"https://duelingdomain.com/logo-512.png\" width=\"44\" height=\"44\" alt=\"\" style=\"display:block;width:44px;height:44px;border:0;border-radius:10px;\"></a></td><td valign=\"middle\" style=\"padding:0 0 0 12px;\"><a href=\"https://duelingdomain.com\" target=\"_blank\" style=\"text-decoration:none;font-family:'Russo One','Arial Black','Segoe UI',Helvetica,Arial,sans-serif;font-size:17px;line-height:22px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#E8ECF4;\">Dueling <span style=\"color:#C9A45C;\">Domain</span></a></td></tr></table></td></tr></table><!--[if mso]></td></tr></table><![endif]-->\n<!--[if mso]><table role=\"presentation\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"560\"><tr><td><![endif]--><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"560\" class=\"container\" style=\"width:560px;max-width:560px;\"><tr><td align=\"left\" valign=\"top\" class=\"\" style=\"background-color:#141929;border:1px solid #2A3150;border-radius:12px;padding:0;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr><td class=\"pad\" bgcolor=\"#141929\" style=\"padding:36px 32px 40px 32px;background-color:#141929;border-radius:12px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tbody>\n<tr><td style=\"padding:0px 0 0 0;\"><p style=\"margin:0;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:16px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#C9A45C;\">Security notice</p></td></tr>\n<tr><td style=\"padding:12px 0 0 0;\"><h1 style=\"margin:0;padding:0;font-family:'Russo One','Arial Black','Segoe UI',Helvetica,Arial,sans-serif;font-size:28px;line-height:34px;font-weight:700;color:#E8ECF4;\">New sign in to your account</h1></td></tr>\n<tr><td style=\"padding:16px 0 0 0;\"><p style=\"margin:0;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:26px;color:#C9D0E4;\">A new device just signed in to your Dueling Domain account. If that was you, you can ignore this email.</p></td></tr>\n<tr><td style=\"padding:24px 0 0 0;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#0E1224\" style=\"width:100%;border-collapse:separate;background-color:#0E1224;border:1px solid #2A3150;border-radius:10px;\"><tbody>\n{{#if sign_in_method}}<tr><td valign=\"top\" style=\"width:38%;padding:11px 8px 11px 16px;border-bottom:1px solid #1E2440;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#AEB7D0;\">Sign in type</td><td valign=\"top\" style=\"padding:11px 16px 11px 0;border-bottom:1px solid #1E2440;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:700;color:#E8ECF4;word-break:break-word;\">{{sign_in_method}}</td></tr>\n{{/if}}\n<tr><td valign=\"top\" style=\"width:38%;padding:11px 8px 11px 16px;border-bottom:1px solid #1E2440;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#AEB7D0;\">Device</td><td valign=\"top\" style=\"padding:11px 16px 11px 0;border-bottom:1px solid #1E2440;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:700;color:#E8ECF4;word-break:break-word;\">{{browser_name}} on {{operating_system}}</td></tr>\n<tr><td valign=\"top\" style=\"width:38%;padding:11px 8px 11px 16px;border-bottom:1px solid #1E2440;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#AEB7D0;\">Location</td><td valign=\"top\" style=\"padding:11px 16px 11px 0;border-bottom:1px solid #1E2440;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:700;color:#E8ECF4;word-break:break-word;\">{{location}}</td></tr>\n<tr><td valign=\"top\" style=\"width:38%;padding:11px 8px 11px 16px;border-bottom:1px solid #1E2440;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#AEB7D0;\">IP</td><td valign=\"top\" style=\"padding:11px 16px 11px 0;border-bottom:1px solid #1E2440;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:700;color:#E8ECF4;word-break:break-word;\">{{ip_address}}</td></tr>\n<tr><td valign=\"top\" style=\"width:38%;padding:11px 8px 11px 16px;border-bottom:none;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#AEB7D0;\">Time</td><td valign=\"top\" style=\"padding:11px 16px 11px 0;border-bottom:none;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:700;color:#E8ECF4;word-break:break-word;\">{{session_created_at}}</td></tr>\n</tbody></table></td></tr>\n{{#if revoke_session_url}}\n<tr><td style=\"padding:16px 0 0 0;\"><p style=\"margin:0;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:26px;color:#C9D0E4;\">Don't recognize it? Sign out of that device now.</p></td></tr>\n<tr><td style=\"padding:28px 0 0 0;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"btn-table\" style=\"border-collapse:separate;\"><tr><td align=\"center\" bgcolor=\"#6D2BDB\" style=\"background-color:#6D2BDB;border:1px solid #8B4DF6;border-radius:8px;\"><a href=\"{{revoke_session_url}}\" target=\"_blank\" class=\"btn\" style=\"display:inline-block;padding:14px 28px;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:20px;font-weight:700;color:#FFFFFF;text-decoration:none;border-radius:8px;white-space:nowrap;\">Sign out of that device</a></td></tr></table></td></tr>\n<tr><td style=\"padding:16px 0 0 0;\"><p style=\"margin:0;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#AEB7D0;\"><a href=\"{{revoke_session_url}}\" target=\"_blank\" style=\"color:#A78BFA;text-decoration:underline;\">Button not working? Sign out of that device</a></p></td></tr>\n{{/if}}\n</tbody></table></td></tr></table></td></tr></table><!--[if mso]></td></tr></table><![endif]-->\n<!--[if mso]><table role=\"presentation\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"560\"><tr><td><![endif]--><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"560\" class=\"container\" style=\"width:560px;max-width:560px;\"><tr><td align=\"left\" valign=\"top\" class=\"ft\" style=\"padding:24px 32px 0 32px;\"><p style=\"margin:0;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#8892B0;\">You're getting this because a new device signed in to your Dueling Domain account.</p><p style=\"margin:6px 0 0 0;font-family:'Chakra Petch','Segoe UI',Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#8892B0;\">Questions? Email <a href=\"mailto:support@duelingdomain.com\" style=\"color:#AEB7D0;text-decoration:underline;\">support@duelingdomain.com</a>.</p></td></tr></table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table>\n</body>\n</html>\n"
