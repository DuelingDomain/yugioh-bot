 "markup": "<re-html>\n<re-head>\n    <re-title>\n        Your Dueling Domain invite\n    </re-title>\n</re-head>\n<re-body background-color=\"#0A0E1A\" padding=\"28px 16px 40px 16px\">\n    <re-preheader>\n        Create your account to join the closed alpha.\n    </re-preheader>\n    <re-header padding=\"0px 0px 20px 22px\">\n        <re-image src=\"https://duelingdomain.com/logo-512.png\" width=\"44\" alt=\"Dueling Domain\" href=\"https://duelingdomain.com\"></re-image>\n    </re-header>\n    <re-main background-color=\"#141929\" border-radius=\"12px\">\n        <re-block border-radius=\"12px\" align=\"left\" padding=\"36px 32px 40px 32px\" background-color=\"#141929\" font-size=\"16px\">\n            <re-text margin=\"0px 0px 0px 0px\" font-size=\"12px\" line-height=\"16px\" font-weight=\"bold\" color=\"#C9A45C\">CLOSED ALPHA INVITE</re-text>\n            <re-heading margin=\"10px 0px 0px 0px\" level=\"h1\" align=\"left\" color=\"#E8ECF4\" font-size=\"28px\" line-height=\"34px\">Your spot is ready</re-heading>\n            <re-text margin=\"16px 0px 0px 0px\" align=\"left\" font-size=\"16px\" line-height=\"26px\" color=\"#C9D0E4\">You're invited to the Dueling Domain closed alpha. Create your account with this email address, or sign up with Discord.</re-text>\n            <re-text margin=\"12px 0px 0px 0px\" align=\"left\" font-size=\"14px\" line-height=\"22px\" color=\"#AEB7D0\">The invite expires in {{invitation.expires_in_days}} days.</re-text>\n            <re-button padding=\"14px 28px\" href=\"{{action_url}}\" font-size=\"16px\" border-radius=\"8px\" margin=\"28px 0px 0px 0px\" background-color=\"#6D2BDB\" color=\"#ffffff\">Create your account</re-button>\n            <re-text margin=\"16px 0px 0px 0px\" align=\"left\" font-size=\"14px\" line-height=\"22px\" color=\"#AEB7D0\"><a href=\"{{action_url}}\" style=\"color:#A78BFA;text-decoration:underline;\">Button not working? Open your invite</a></re-text>\n        </re-block>\n    </re-main>\n    <re-footer padding=\"24px 32px 0px 32px\">\n        <re-text margin=\"0px 0px 0px 0px\" font-size=\"13px\" line-height=\"20px\" color=\"#8892B0\">You're getting this because you joined the waitlist at duelingdomain.com.</re-text>\n        <re-text margin=\"6px 0px 0px 0px\" font-size=\"13px\" line-height=\"20px\" color=\"#8892B0\">Questions? Email <a href=\"mailto:support@duelingdomain.com\" style=\"color:#AEB7D0;text-decoration:underline;\">support@duelingdomain.com</a>.</re-text>\n    </re-footer>\n</re-body>\n</re-html>\n",
