{
  "name": "@yugioh-discord-bot/ws",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --import ./dist/instrument.js dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "^10.76.2",
    "@yugidraft/shared": "*",
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "socket.io-client": "^4.8.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
