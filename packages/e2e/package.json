{
  "name": "@yugidraft/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stack:build": "node stack/prepare.mjs",
    "stack:manual": "node stack/manual.mjs",
    "stack:login": "node stack/login.mjs",
    "e2e": "node stack/prepare.mjs && playwright test",
    "e2e:nobuild": "playwright test",
    "e2e:ui": "node stack/prepare.mjs && playwright test --ui",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests-unit/*.test.ts",
    "e2e:index": "node tools/build-index.mjs"
  },
  "devDependencies": {
    "@yugidraft/shared": "*",
    "better-sqlite3": "latest",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  }
}
