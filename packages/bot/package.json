{
  "name": "@yugioh-discord-bot/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
    "build": "tsc -p ../shared/tsconfig.build.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p ../shared/tsconfig.build.json && tsc --noEmit",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "test": "tsc -p ../shared/tsconfig.build.json && vitest run",
    "test:watch": "vitest",
    "commands:deploy": "tsx src/deploy-commands.ts",
    "commands:deploy:prod": "node dist/deploy-commands.js",
    "healthcheck": "node dist/healthcheck.js"
  },
  "dependencies": {
    "@sentry/node": "^10.76.2",
    "@yugidraft/shared": "*",
    "better-sqlite3": "latest",
    "discord.js": "latest",
    "dotenv": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "@types/ws": "^8.18.1",
    "ws": "^8.22.0"
  }
}
