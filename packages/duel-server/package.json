{
  "name": "@yugidraft/duel-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run tests --testTimeout=15000",
    "prepare:data": "tsx scripts/prepare-data.ts",
    "test:scenarios": "vitest run tests/scenarios",
    "test:scenarios:json": "vitest run tests/scenarios --reporter=default --reporter=json --outputFile.json=../../.status/scenarios.json",
    "status": "tsx scripts/status.ts",
    "scenarios:list": "tsx tests/support/list.ts",
    "scenarios:find-card": "tsx tests/support/find-card.ts",
    "scan:multiplayer": "tsx scripts/scan-multiplayer-scripts.ts"
  },
  "dependencies": {
    "@yugidraft/shared": "*",
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "ocgcore-wasm": "0.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
