diff --git a/packages/duel-server/domain-core/multi-scripts/c10852583.lua b/packages/duel-server/domain-core/multi-scripts/c10852583.lua
new file mode 100644
index 0000000..c3603c4
--- /dev/null
+++ b/packages/duel-server/domain-core/multi-scripts/c10852583.lua
@@ -0,0 +1,11 @@
+-- A side-seat summon has no column toward which Yajiro can move.
+if not aux.MPGeometryShared then return end
+local mp_mvcon,mp_mvop=s.mvcon,s.mvop
+function s.mvcon(e,tp,eg,ep,ev,re,r,rp)
+	if aux.MPGeometryShared() and (#eg~=1 or not eg:GetFirst():IsAcross(tp)) then return false end
+	return mp_mvcon(e,tp,eg,ep,ev,re,r,rp)
+end
+function s.mvop(e,tp,eg,ep,ev,re,r,rp)
+	if aux.MPGeometryShared() and (#eg~=1 or not eg:GetFirst():IsAcross(tp)) then return end
+	return mp_mvop(e,tp,eg,ep,ev,re,r,rp)
+end
diff --git a/packages/duel-server/domain-core/multi-scripts/c15967552.lua b/packages/duel-server/domain-core/multi-scripts/c15967552.lua
new file mode 100644
index 0000000..1023d2c
--- /dev/null
+++ b/packages/duel-server/domain-core/multi-scripts/c15967552.lua
@@ -0,0 +1,19 @@
+-- Only the living across opponent has the second zone of this column.
+if not aux.MPGeometryShared then return end
+local mp_sptg,mp_spop=s.sptg,s.spop
+function s.sptg(e,tp,eg,ep,ev,re,r,rp,chk,...)
+	if aux.MPGeometryShared() then
+		-- The geometry read binds the across seat even when a Trap is in hand.
+		-- Its returned mask is not an activation requirement.
+		e:GetHandler():GetColumnZone(LOCATION_MZONE,0,0,1-tp)
+		if not Duel.MPBound() or Duel.MPSeat(1-tp)~=Duel.MPAcrossSeat(Duel.MPSeat(0)) then return false end
+	end
+	return mp_sptg(e,tp,eg,ep,ev,re,r,rp,chk,...)
+end
+function s.spop(e,tp,eg,ep,ev,re,r,rp)
+	-- A Normal Trap still resolves after removal. Use the saved chain binding,
+	-- independent of the handler's current controller or location.
+	if aux.MPGeometryShared() and (not Duel.MPBound()
+		or Duel.MPSeat(1-tp)~=Duel.MPAcrossSeat(Duel.MPSeat(0))) then return end
+	return mp_spop(e,tp,eg,ep,ev,re,r,rp)
+end
