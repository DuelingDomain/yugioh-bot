+// End the suspended cost without resuming Lua past the failed payment.
+// Use the same coroutine and scope cleanup as a normally finished call.
+int32_t interpreter::cancel_coroutine(int32_t function) {
+	params.clear();
+	auto it = coroutines.find(function);
+	if(it != coroutines.end()) {
+		mp_saved.erase(it->second.first);
+		auto ref = it->second.second;
+		coroutines.erase(it);
+		ensure_luaL_stack(luaL_unref, lua_state, LUA_REGISTRYINDEX, ref);
+		--call_depth;
+		if(call_depth == 0)
+			pduel->restore_assumes();
+	}
+	return COROUTINE_ERROR;
+}
