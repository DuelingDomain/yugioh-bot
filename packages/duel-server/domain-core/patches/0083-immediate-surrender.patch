+// Snapshot an action when its event is raised, before later moves change its cards.
+uint8_t field::event_response_participants(const tevent& e, bool include_previous) const {
+	if(n_duelists <= 2 || !e.event_code || e.event_code == EVENT_FREE_CHAIN || e.event_code == EVENT_ADJUST
+		|| e.event_code == EVENT_BREAK_EFFECT || e.event_code == EVENT_CHAIN_END
+		|| e.event_code == EVENT_TURN_END || e.event_code == EVENT_PREDRAW || (e.event_code & 0xfffff000u) == EVENT_PHASE
+		|| (e.event_code & 0xfffff000u) == EVENT_PHASE_START)
+		return 0;
+	uint8_t seats = 0;
+	auto add = [&](uint8_t p) { if(is_duelist(p)) seats |= 1u << p; };
+	auto add_card = [&](card* c, bool moved = false) {
+		if(c && (c->current.location || c->previous.location)) {
+			add(c->owner);
+			add(c->current.controler);
+			if(c->previous.location && (moved || !c->current.location))
+				add(c->previous.controler);
+		}
+	};
+	// SSET has both a real setplayer and a literal-zero trap-reset writer. Its cards name the subject.
+	if(e.event_code != EVENT_SSET && event_player_is_subject(e.event_code)) add(e.event_player);
+	// A rule-only event can have a placeholder reason player, rather than an action actor.
+	if(e.reason_effect || (e.reason & ~REASON_RULE)) add(e.reason_player);
+	if(e.reason_effect) add_card(e.reason_effect->get_handler());
+	bool moved = false;
+	if(include_previous) {
+		switch(e.event_code) {
+		case EVENT_MOVE: case EVENT_CONTROL_CHANGED: case EVENT_LEAVE_FIELD:
+		case EVENT_TO_HAND: case EVENT_TO_DECK: case EVENT_TO_GRAVE: case EVENT_REMOVE:
+		case EVENT_RELEASE: case EVENT_DISCARD: case EVENT_DESTROYED:
+			moved = true;
+		}
+	}
+	add_card(e.trigger_card, moved);
+	if(e.event_cards)
+		for(auto* c : e.event_cards->container) add_card(c, moved);
+	if(event_is_battle(e.event_code)) {
+		add_card(core.attacker);
+		add_card(core.attack_target);
+		add(core.battle_defender);
+	}
+	return seats;
+}
+// Real action events take precedence over phase/free-chain events in the same window.
