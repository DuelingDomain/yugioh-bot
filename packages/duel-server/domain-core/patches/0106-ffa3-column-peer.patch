 #include "group.h"
 #include "interpreter.h"
 
+// R-FFA-THREE-COLUMNS: a selected peer while three live, the sole peer while two live.
+uint8_t field::column_peer_of(uint8_t p) const {
+	if(n_duelists != 3 || n_teams != n_duelists)
+		return across_of(p);
+	if(!is_alive(p))
+		return DUELIST_NONE;
+	uint8_t opponents[MAX_DUELISTS];
+	if(living_opponents(p, opponents) == 1)
+		return opponents[0];
+	const auto* s = pduel->lua->current_scope();
+	if(!s || !s->eff || !s->eff->column_peer || !(s->eff->type & EFFECT_TYPE_ACTIONS) || (s->eff->type & EFFECT_TYPE_CONTINUOUS))
+		return DUELIST_NONE;
+	// A flagged condition can read columns before its target callback runs.
+	pduel->lua->scope_mark_touched();
+	const auto peer = pduel->lua->scope_bound_opp();
+	if(!is_alive(s->P) || !is_alive(peer) || same_team(s->P, peer))
+		return DUELIST_NONE;
+	if(p == s->P)
+		return peer;
+	return p == peer ? s->P : DUELIST_NONE;
+}
+
 bool chain::chain_operation_sort(const chain& c1, const chain& c2) {
 	return c1.triggering_effect->id < c2.triggering_effect->id;
 }
