@@ -1522,13 +1522,17 @@ uint32_t card::get_column_zone(int32_t loc1, int32_t left, int32_t right) {
 	auto chkextra = [seq = current.sequence, mzone = (current.location == LOCATION_MZONE)](uint8_t s)->bool { 
 		return !mzone || seq < 5 || seq != s;
 	};
+	// FFA3 EMZ are independent even when their columns line up. Exclude only
+	// this card below, not the other seat's separately occupied mirrored EMZ.
+	const bool independent_emz = pduel->game_field->n_duelists == 3
+		&& pduel->game_field->n_teams == 3;
 	if (loc1 & LOCATION_MZONE) {
 		for (int32_t s = seq1; s <= seq2; ++s) {
 			zones |= (1u << s) | (1u << (16 + (4 - s)));
 			if (pduel->game_field->is_flag(DUEL_EMZONE)) {
-				if (s == 1 && chkextra(5))
+				if (s == 1 && (chkextra(5) || independent_emz))
 					zones |= (1u << 5) | (1u << (16 + 6));
-				else if (s == 3 && chkextra(6))
+				else if (s == 3 && (chkextra(6) || independent_emz))
 					zones |= (1u << 6) | (1u << (16 + 5));
 			}
 		}
@@ -1538,7 +1542,7 @@ uint32_t card::get_column_zone(int32_t loc1, int32_t left, int32_t right) {
 			zones |= (1u << (8 + s)) | (1u << (16 + 8 + (4 - s)));
 	}
 	// Separate fields keep only their own columns.
-	if(pduel->game_field->across_of(current.controler) == DUELIST_NONE)
+	if(pduel->game_field->column_peer_of(current.controler) == DUELIST_NONE)
 		zones &= 0xffff;
 	zones &= ~((1 << current.sequence) << ((loc2 == LOCATION_SZONE) ? 8 : 0));
 	return zones;
@@ -1550,14 +1554,23 @@ void card::get_column_cards(card_set* cset, int32_t left, int32_t right) {
 	int32_t p = current.controler;
 	uint32_t column_zone = get_column_zone(LOCATION_ONFIELD, left, right);
 	pduel->game_field->get_cards_in_zone(cset, column_zone, p, LOCATION_ONFIELD);
-	if(pduel->game_field->across_of(current.controler) != DUELIST_NONE)
-		pduel->game_field->get_cards_in_zone(cset, column_zone >> 16, pduel->game_field->across_of(p), LOCATION_ONFIELD);
+	if(pduel->game_field->column_peer_of(current.controler) != DUELIST_NONE)
+		pduel->game_field->get_cards_in_zone(cset, column_zone >> 16, pduel->game_field->column_peer_of(p), LOCATION_ONFIELD);
 }
 int32_t card::is_all_column() {
 	if(!(current.location & LOCATION_ONFIELD))
 		return FALSE;
 	card_set cset;
 	get_column_cards(&cset, 0, 0);
+	if(pduel->game_field->n_duelists == 3 && pduel->game_field->n_teams == 3) {
+		// FFA3 has separate EMZ. Count the actual column's available positions,
+		// including both mirrored EMZ when a peer exists; the source is excluded.
+		uint32_t zone = get_column_zone(LOCATION_ONFIELD, 0, 0);
+		uint32_t full = 0;
+		for(; zone; zone &= zone - 1)
+			++full;
+		return full && cset.size() == full;
+	}
 	uint32_t full = 3;
 	if(pduel->game_field->is_flag(DUEL_EMZONE) && (current.sequence == 1 || current.sequence == 3))
 		++full;
