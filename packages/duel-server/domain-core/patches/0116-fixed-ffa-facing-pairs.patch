-	lua_pushboolean(L, f.has_shared_zones() || (f.n_duelists == 3 && f.n_teams == f.n_duelists));
+	lua_pushboolean(L, f.has_shared_zones());
 	return 1;
 }
 LUA_STATIC_FUNCTION(MPColumnPeerSeat) {
