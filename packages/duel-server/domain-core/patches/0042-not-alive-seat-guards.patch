+	// with more than two duelists the place is chosen by a living seat: the owner of the field
+	// chooses when the chooser is not alive (a folded or stale seat)
+	if(n_duelists > 2 && !is_alive(move_player) && is_alive(playerid))
+		move_player = playerid;
 	switch(arg.step) {
 	case 0: {
 		returns.set<int32_t>(0, FALSE);
+		// no card goes onto the field of a seat that is not alive: the move fails like a full zone
+		if(n_duelists > 2 && !is_alive(playerid))
+			return TRUE;
