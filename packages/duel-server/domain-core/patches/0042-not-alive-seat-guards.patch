diff --git a/card.cpp b/card.cpp
index 220d517..0ae15a8 100644
--- a/card.cpp
+++ b/card.cpp
@@ -2118,8 +2118,12 @@ std::pair<uint8_t, effect*> card::refresh_control_status() {
 	if(eset.size()) {
 		effect* peffect = eset.back();
 		if(peffect->id >= last_id) {
-			final = (uint8_t)peffect->get_value(this);
-			ceffect = peffect;
+			const uint8_t controler = (uint8_t)peffect->get_value(this);
+			// with more than two duelists a control effect for a seat that is not alive is ignored
+			if(pduel->game_field->n_duelists == 2 || pduel->game_field->is_alive(controler)) {
+				final = controler;
+				ceffect = peffect;
+			}
 		}
 	}
 	return std::make_pair(final, ceffect);
diff --git a/field.h b/field.h
index 5b54685..4d1f413 100644
--- a/field.h
+++ b/field.h
@@ -483,6 +483,11 @@ public:
 	bool is_alive(int64_t p) const {
 		return is_duelist(p) && !player[p].eliminated;
 	}
+	// A seat that never gets a prompt: it is not alive (eliminated, or not a duelist) with more than
+	// two duelists. With two duelists this is always false, so the stock prompts are unchanged.
+	bool is_skipped_seat(int64_t p) const {
+		return n_duelists > 2 && !is_alive(p);
+	}
 	uint8_t team_of(uint8_t p) const {
 		return player[p].team;
 	}
