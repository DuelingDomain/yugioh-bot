From a5de35f1fc728821a003901b2fe2716711d94fb9 Mon Sep 17 00:00:00 2001
From: yugidraft <dev@yugidraft.local>
Date: Tue, 25 Apr 2000 00:00:00 +0000
Subject: [PATCH] Tag Link departure filters read exact previous seats

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019EpX1AcvnigK9dTsxAa5W9
---
 libduel.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/libduel.cpp b/libduel.cpp
index 5e05b05..b50832b 100644
--- a/libduel.cpp
+++ b/libduel.cpp
@@ -5230,6 +5230,15 @@ LUA_STATIC_FUNCTION(MPSeatOf) {
 	lua_pushinteger(L, (f.n_duelists <= 2 || f.is_duelist(c)) ? c : -1);
 	return 1;
 }
+// Exact previous controller for geometry. No team folding, opponent binding or prompts.
+LUA_STATIC_FUNCTION(MPPreviousSeatOf) {
+	check_param_count(L, 1);
+	const auto pcard = lua_get<card*, true>(L, 1);
+	const auto& f = *pduel->game_field;
+	const uint8_t seat = pcard->previous.controler;
+	lua_pushinteger(L, f.is_duelist(seat) ? seat : -1);
+	return 1;
+}
 // Duel.MPActionSeat([real_seat]): the optional argument is a REAL seat, never folded tp.
 // In a card effect use no argument for the original actor. No argument keeps the original
 // scope player after a Tag rebind. This call does not change the recipient or scope.
