+	// Phase 3 (F5): true when the event code raises its event_player as a real subject (the damaged player, the player
+	// of a chain link, the summoner, the player that draws). Many events pass a literal 0 there (the chain end, the
+	// battle steps, leaving the field) or the turn player (the start of a phase, the end of the turn): those name nobody.
+	static bool event_player_is_subject(uint32_t code) {
+		switch(code) {
+		case EVENT_DRAW: case EVENT_DAMAGE: case EVENT_RECOVER: case EVENT_BATTLE_DAMAGE: case EVENT_PRE_BATTLE_DAMAGE:
+		case EVENT_BE_BATTLE_TARGET: case EVENT_ATTACK_ANNOUNCE: case EVENT_PAY_LPCOST:
+		case EVENT_CHAINING: case EVENT_CHAIN_ACTIVATING: case EVENT_CHAIN_SOLVING: case EVENT_CHAIN_SOLVED:
+		case EVENT_CHAIN_NEGATED: case EVENT_CHAIN_DISABLED:
+		case EVENT_SUMMON: case EVENT_FLIP_SUMMON: case EVENT_SPSUMMON: case EVENT_SUMMON_SUCCESS:
+		case EVENT_FLIP_SUMMON_SUCCESS: case EVENT_SPSUMMON_SUCCESS: case EVENT_MSET: case EVENT_SSET:
+			return true;
+		}
+		// the player of a counter change; a custom event is raised by a script that names its player
+		return (code & ~0xFFFFu) == EVENT_ADD_COUNTER || (code & ~0xFFFFu) == EVENT_REMOVE_COUNTER || code >= EVENT_CUSTOM;
+	}
+	// F5: the battle events (not the damage events: their event player is the damaged duelist). They name no player
+	// ("0" or the turn player in the event), but the battle names the other side: battle_opponent.
+	static bool event_is_battle(uint32_t code) {
+		switch(code) {
+		case EVENT_ATTACK_ANNOUNCE: case EVENT_BE_BATTLE_TARGET: case EVENT_BATTLE_START: case EVENT_BATTLE_CONFIRM:
+		case EVENT_PRE_DAMAGE_CALCULATE: case EVENT_BATTLED: case EVENT_BATTLE_DESTROYING: case EVENT_BATTLE_DESTROYED:
+		case EVENT_DAMAGE_STEP_END:
+			return true;
+		}
+		return false;
+	}
+	// F5, n > 2 only: in a battle, the other side of P. P on the side of the attacker: the controller of the attacked
+	// monster (a direct attack has none: DUELIST_NONE). Any other P: the controller of the attacker. A seat that is not
+	// alive or is on the team of P gives DUELIST_NONE.
+	uint8_t battle_opponent(uint8_t P) const {
+		if(!core.attacker)
+			return DUELIST_NONE;
+		const uint8_t ac = core.attacker->current.controler;
+		uint8_t d = DUELIST_NONE;
+		if(is_duelist(ac) && same_team(P, ac))
+			d = core.attack_target ? core.attack_target->current.controler : DUELIST_NONE;
+		else
+			d = ac;
+		return (is_duelist(d) && is_alive(d) && !same_team(P, d)) ? d : DUELIST_NONE;
+	}
+	// Phase 3 (F5), n > 2 only: the opponent of P that an event names. A battle event: the other side of the battle
+	// (battle_opponent, Yubel). The event player if the event raises a real
+	// one (event_player_is_subject) and it is a living opponent of P, else the reason player if the event has a reason
+	// (an effect or a reason code: without one, reason_player is a literal 0) and it is one, else DUELIST_NONE.
+	// The only place of this rule (Don Zaloog: the damaged player; Dark Bribe: the activator of the link it answers;
+	// Yubel). The default event and nil_event (code 0, EVENT_FREE_CHAIN, a phase) name nobody.
+	uint8_t event_opponent(uint8_t P, const tevent& e) const {
+		if(n_duelists <= 2 || !is_alive(P))
+			return DUELIST_NONE;
+		if(event_is_battle(e.event_code)) {
+			if(const uint8_t b = battle_opponent(P); b != DUELIST_NONE)
+				return b;
+		}
+		if(event_player_is_subject(e.event_code) && is_alive(e.event_player) && !same_team(P, e.event_player))
+			return e.event_player;
+		if((e.reason_effect != nullptr || e.reason != 0) && is_alive(e.reason_player) && !same_team(P, e.reason_player))
+			return e.reason_player;
+		return DUELIST_NONE;
+	}
+	// n > 2: the living duelists that are not on the team of P, in ascending order. Gives the count.
+	uint8_t living_opponents(uint8_t P, uint8_t (&out)[MAX_DUELISTS]) const {
+		uint8_t count = 0;
+		if(n_duelists <= 2 || !is_duelist(P))
+			return count;
+		for(uint8_t q = 0; q < n_duelists; ++q) {
+			if(is_alive(q) && !same_team(P, q))
+				out[count++] = q;
+		}
+		return count;
+	}
+	// F5: the pick of one opponent. ask_opponent puts one option per seat of `mask` (bit q = seat q, in seat
+	// order, desc 0xFFFE0000|seat) in core.select_options and queues the stock option prompt for P (no hint: the
+	// stock strings have none for "choose an opponent"; 0xFFFF0000|seat is the direct-attack pick of the TS layer).
+	// The prompt answers with MSG_RETRY for an out-of-range index (R2). opponent_of_answer gives the seat of an answer.
+	static constexpr uint64_t opponent_pick_desc = 0xFFFE0000ULL;
+	void ask_opponent(uint8_t P, uint8_t mask) {
+		core.select_options.clear();
+		for(uint8_t q = 0; q < MAX_DUELISTS; ++q) {
+			if((mask >> q) & 1)
+				core.select_options.push_back(opponent_pick_desc | q);
+		}
+		emplace_process<Processors::SelectOption>(P);
+	}
+	static uint8_t opponent_of_answer(uint8_t mask, int32_t answer) {
+		int32_t rank = 0;
+		uint8_t first = DUELIST_NONE;
+		for(uint8_t q = 0; q < MAX_DUELISTS; ++q) {
+			if(!((mask >> q) & 1))
+				continue;
+			if(first == DUELIST_NONE)
+				first = q;
+			if(rank++ == answer)
+				return q;
+		}
+		return first;
+	}
 	// Takes p out of the duel (n > 2): message 200, p's cards, chain links and turn. reason = the MSG_WIN reason code
 	// that applies. Does nothing with 2 duelists or when p is already out. marked = the caller set
 	// player[p].eliminated already (several duelists lose in the same check, so every loser is dead before
