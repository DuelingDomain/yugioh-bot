diff --git a/effect.cpp b/effect.cpp
index 9f8850a..778d7a3 100644
--- a/effect.cpp
+++ b/effect.cpp
@@ -397,8 +397,79 @@ int32_t effect::is_activate_ready(effect* reason_effect, uint8_t playerid, const
 	return TRUE;
 }
 int32_t effect::is_activate_ready(uint8_t playerid, const tevent& e, int32_t neglect_cond, int32_t neglect_cost, int32_t neglect_target) {
+	// F5: is_activateable reaches here. At n > 2 the probe binds the opponent (probe_bind falls back to the plain check
+	// when no probe scope is on top, so every other path is unchanged).
+	if(pduel->game_field->n_duelists > 2) {
+		uint8_t bound, mask;
+		return probe_bind(playerid, e, neglect_cond, neglect_cost, neglect_target, bound, mask);
+	}
 	return is_activate_ready(this, playerid, e, neglect_cond, neglect_cost, neglect_target);
 }
+// F5. The pinned scope of is_activateable (P = playerid, eff = this) is on top of the scope stack. Its own_bound
+// is the opponent of the checks. The probe never leaves a binding behind: the caller reads `bound` and `mask`.
+int32_t effect::probe_bind(uint8_t playerid, const tevent& e, int32_t neglect_cond, int32_t neglect_cost, int32_t neglect_target, uint8_t& bound, uint8_t& mask) {
+	auto& f = *pduel->game_field;
+	auto* I = pduel->lua;
+	bound = DUELIST_NONE;
+	mask = 0;
+	// The checks push scopes, so the vector can grow: read the pinned scope again after every call (S()).
+	auto S = [I]() { return I->current_scope(); };
+	auto* s = S();
+	if(f.n_duelists <= 2 || !s || !s->pinned || s->eff != this || s->bound || !f.is_duelist(playerid) || s->P != playerid)
+		return is_activate_ready(this, playerid, e, neglect_cond, neglect_cost, neglect_target);
+	// the event opponent: the damaged player, the activator of the chain link that is answered, ...
+	// Rule: when the event names an opponent, only that one is tried. If the checks fail for it, the effect is not
+	// activateable. No other opponent is tried (the event decides, not the activator).
+	if(const uint8_t ev = f.event_opponent(playerid, e); ev != DUELIST_NONE) {
+		S()->own_bound = ev;
+		bound = ev;
+		const int32_t r = is_activate_ready(this, playerid, e, neglect_cond, neglect_cost, neglect_target);
+		S()->own_bound = DUELIST_NONE;
+		if(r)
+			mask = static_cast<uint8_t>(1u << ev);
+		return r;
+	}
+	// first run: nothing bound. A check that never asked for "an opponent" does not depend on one.
+	S()->touched = false;
+	const int32_t first = is_activate_ready(this, playerid, e, neglect_cond, neglect_cost, neglect_target);
+	if(!first || !S()->touched) {
+		S()->touched = false;
+		return first;
+	}
+	S()->touched = false;
+	uint8_t opp[MAX_DUELISTS];
+	const auto n = f.living_opponents(playerid, opp);
+	for(uint8_t i = 0; i < n; ++i) {
+		S()->own_bound = opp[i];
+		if(is_activate_ready(this, playerid, e, neglect_cond, neglect_cost, neglect_target))
+			mask |= static_cast<uint8_t>(1u << opp[i]);
+	}
+	S()->own_bound = DUELIST_NONE;
+	S()->touched = false;
+	if(mask && !(mask & (mask - 1)))
+		bound = field::opponent_of_answer(mask, 0);
+	return mask != 0;
+}
+void effect::probe_chain(uint8_t playerid, const tevent& e, uint8_t& bound, uint8_t& mask) {
+	auto& f = *pduel->game_field;
+	bound = DUELIST_NONE;
+	mask = 0;
+	if(f.n_duelists <= 2 || !f.is_duelist(playerid) || (type & EFFECT_TYPE_CONTINUOUS))
+		return;
+	// a trigger passed its condition when it was put in the queue
+	const int32_t nc = (type & (EFFECT_TYPE_TRIGGER_O | EFFECT_TYPE_TRIGGER_F | EFFECT_TYPE_FLIP)) ? TRUE : FALSE;
+	interpreter::scope_guard scope(pduel->lua);
+	scope.push(playerid, nullptr, false, false, this, true);
+	f.save_lp_cost();
+	effect* oreason = f.core.reason_effect;
+	uint8_t op = f.core.reason_player;
+	f.core.reason_effect = this;
+	f.core.reason_player = playerid;
+	probe_bind(playerid, e, nc, FALSE, FALSE, bound, mask);
+	f.core.reason_effect = oreason;
+	f.core.reason_player = op;
+	f.restore_lp_cost();
+}
 // check functions: condition
 int32_t effect::is_condition_check(uint8_t playerid, const tevent& e) {
 	card* phandler = get_handler();
@@ -438,7 +509,7 @@ int32_t effect::is_activate_check(uint8_t playerid, const tevent& e, int32_t neg
 	uint8_t op = pduel->game_field->core.reason_player;
 	pduel->game_field->core.reason_effect = this;
 	pduel->game_field->core.reason_player = playerid;
-	int32_t result = is_activate_ready(playerid, e, neglect_cond, neglect_cost, neglect_target);
+	int32_t result = is_activate_ready(this, playerid, e, neglect_cond, neglect_cost, neglect_target);
 	pduel->game_field->core.reason_effect = oreason;
 	pduel->game_field->core.reason_player = op;
 	pduel->game_field->restore_lp_cost();
