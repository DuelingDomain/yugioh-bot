 	if(pcard) {
@@ -3563,13 +3570,14 @@ LUA_STATIC_FUNCTION(SelectPosition) {
 }
 // n_duelists > 2: the one opponent whose zones a place prompt of `seat` offers (the high half of the mask).
 // The bound opponent of the link when seat is the scope duelist, else the next living opponent in turn order
-// (a kind (a) record when the scope duelist falls back). DUELIST_NONE when nobody else lives.
+// (a kind (a) record when the scope duelist falls back). DUELIST_NONE when nobody else lives, or when the bound
