diff --git a/fold_lib.h b/fold_lib.h
index add1983..d721be2 100644
--- a/fold_lib.h
+++ b/fold_lib.h
@@ -12,6 +12,7 @@
 #include <utility> //std::swap
 #include "common.h"
 #include "duel.h"
+#include "effect.h"
 #include "field.h"
 #include "fold.h"
 #include "scriptlib.h"
@@ -69,6 +70,47 @@ inline uint8_t opt_seat(lua_State* L, duel* pduel, int idx, uint8_t dflt, const
 	return seat_arg(pduel, scriptlib::lua_get<uint8_t>(L, idx), fn, v_first, seat);
 }
 
+// ---- zones
+
+// n > 2: where the opponent of the last zone prompt (Duel.SelectDisableField, Duel.SelectFieldZone) is kept for the
+// running scope: in the chain link that runs the scope effect (its target and its operation are two scopes of one
+// link, and the prompts of other links come in between), else in the field (a scope without a link).
+inline uint8_t& zone_prompt_slot(duel* pduel) {
+	auto& core = pduel->game_field->core;
+	if(const auto* s = active(pduel); s && s->eff) {
+		for(auto it = core.current_chain.rbegin(); it != core.current_chain.rend(); ++it) {
+			if(it->triggering_effect == s->eff)
+				return it->zone_opp;
+		}
+	}
+	return core.zone_prompt_opp;
+}
+
+// A zone prompt of `chooser` offered the zones of `opp`. Only a prompt of the scope duelist is kept: the zones of a
+// prompt that another duelist answers are the other duelist's.
+inline void note_zone_prompt(duel* pduel, uint8_t chooser, uint8_t opp) {
+	const auto* s = active(pduel);
+	if(!s || s->P == chooser)
+		zone_prompt_slot(pduel) = opp;
+}
+
+// n > 2: a zone-disabling effect keeps the opponent that its value names when it is registered by the handler
+// duelist inside a scope: the opponent of the last zone prompt of the running link (the zones that the duelist
+// saw), else the bound opponent of the link. The high half of the value binds to that opponent (add_disabled_zones_n).
+// An opponent that is eliminated later stays recorded, so its zones are not moved to another seat (F5: no fallback);
+// an opponent of the own team is not recorded.
+inline void record_disfield_opp(duel* pduel, effect* peffect, uint8_t handler_player) {
+	const auto* s = active(pduel);
+	if(!s || s->P != handler_player || peffect->code != EFFECT_DISABLE_FIELD)
+		return;
+	const auto& f = *pduel->game_field;
+	auto usable = [&](uint8_t q) { return f.is_duelist(q) && !f.same_team(handler_player, q); };
+	uint8_t opp = zone_prompt_slot(pduel);
+	if(!usable(opp))
+		opp = pduel->lua->scope_bound_opp();
+	peffect->disfield_opp = usable(opp) ? opp : DUELIST_NONE;
+}
+
 // ---- prompts
 
 // The player that chooses: unfold_action, and at n > 2 a chooser that is not a living duelist gives INVALID
diff --git a/libcard.cpp b/libcard.cpp
index 32f6772..e800422 100644
--- a/libcard.cpp
+++ b/libcard.cpp
@@ -1129,8 +1129,11 @@ LUA_FUNCTION(RegisterEffect) {
 		return 0;
 	}
 	int32_t id = -1;
-	if (!peffect->handler)
+	if (!peffect->handler) {
+		// n_duelists > 2: a zone-disabling effect keeps the opponent of the zone prompt that made its value
+		fold::record_disfield_opp(pduel, peffect, self->current.controler);
 		id = self->add_effect(peffect);
+	}
 	lua_pushinteger(L, id);
 	return 1;
 }
