 fold_lib.h    | 42 ++++++++++++++++++++++++++++++++++++++++++
 libcard.cpp   |  5 ++++-
 libduel.cpp   | 40 ++++++++++++++++++++++++----------------
 processor.cpp | 15 +++++++++------
 5 files changed, 83 insertions(+), 23 deletions(-)

