+	// between them, whatever other links prompt in between.
+	uint8_t zone_opp{ DUELIST_NONE };
 	// Phase 3 (F5): the opponents that passed the activation probe (bit q = seat q), the option list of the pick.
 	uint8_t legal_mask{ 0 };
