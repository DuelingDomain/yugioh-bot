+uint8_t field::response_order(uint8_t anchor, uint8_t* out) const {
+	uint8_t count = 0;
+	const uint8_t tp = infos.turn_player;
+	auto add = [&](uint8_t q) {
+		q = static_cast<uint8_t>(q % n_duelists);
+		if(is_alive(q))
+			out[count++] = q;
+	};
+	if(n_teams == n_duelists) {
+		const uint8_t s = (anchor == tp) ? static_cast<uint8_t>(tp + 1) : tp;
+		for(uint8_t i = 0; i < n_duelists; ++i)
+			add(static_cast<uint8_t>(s + i));
+	} else if(anchor == DUELIST_NONE) {
+		add(tp);
+		add(static_cast<uint8_t>(tp + 1));
+		add(static_cast<uint8_t>(tp + 3));
+		add(static_cast<uint8_t>(tp + 2));
+	} else {
+		add(static_cast<uint8_t>(anchor + 1));
+		add(static_cast<uint8_t>(anchor + 3));
+		add(static_cast<uint8_t>(anchor + 2));
+		add(anchor);
+	}
+	return count;
+}
+uint8_t field::first_responder() const {
+	uint8_t order[MAX_DUELISTS];
+	const uint8_t count = response_order(core.response_anchor, order);
+	for(uint8_t i = 0; i < count; ++i)
+		if(!infos.priorities[order[i]])
+			return order[i];
+	return infos.turn_player;
+}
+uint8_t field::next_responder(uint8_t cur) const {
+	uint8_t order[MAX_DUELISTS];
+	const uint8_t count = response_order(core.response_anchor, order);
+	uint8_t i = 0;
+	while(i < count && order[i] != cur)
+		++i;
+	for(++i; i < count; ++i)
+		if(!infos.priorities[order[i]])
+			return order[i];
+	return DUELIST_NONE;
+}
+uint8_t field::restart_responders(uint8_t anchor, uint8_t passed) {
+	core.response_anchor = anchor;
+	for(uint8_t p = 0; p < n_duelists; ++p)
+		infos.priorities[p] = 0;
+	if(passed != DUELIST_NONE)
+		infos.priorities[passed] = 1;
+	return first_responder();
+}
+uint8_t field::trigger_order(uint8_t* out) const {
+	uint8_t count = 0;
+	const uint8_t tp = infos.turn_player;
+	auto add = [&](uint8_t q) {
+		q = static_cast<uint8_t>(q % n_duelists);
+		if(is_alive(q))
+			out[count++] = q;
+	};
+	if(n_teams == n_duelists) {
+		for(uint8_t i = 0; i < n_duelists; ++i)
+			add(static_cast<uint8_t>(tp + i));
+	} else {
+		add(tp);
+		add(static_cast<uint8_t>(tp + 2));
+		add(static_cast<uint8_t>(tp + 1));
+		add(static_cast<uint8_t>(tp + 3));
+	}
+	return count;
+}
 void field::reload_field_info() {
 	auto message = pduel->new_message(MSG_RELOAD_FIELD);
 	message->write<uint32_t>(core.duel_options);
