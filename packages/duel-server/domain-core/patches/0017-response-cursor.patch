+	// Response cursor for n_duelists > 2 (phase 2). All of these skip eliminated duelists and are
+	// not used when n_duelists == 2. out[] holds at most MAX_DUELISTS duelists; the result is the count.
+	// Order of the players who may answer after a Chain Link added by `anchor` (DUELIST_NONE = open window).
+	// Free for all: the turn player first, then clockwise (if the anchor is the turn player, the next
+	// duelist first and the turn player last). Tag: a+1, a+3, a+2, a; open window: tp, tp+1, tp+3, tp+2.
+	uint8_t response_order(uint8_t anchor, uint8_t* out) const;
+	// The first duelist in response_order(core.response_anchor) who has not passed (priorities[q] == 0).
+	uint8_t first_responder() const;
+	// The next such duelist after cur in that order, without wrapping. DUELIST_NONE when everybody passed.
+	uint8_t next_responder(uint8_t cur) const;
+	// Starts a new answer round: sets the anchor, clears the pass record (the `passed` duelist, if any,
+	// counts as passed) and returns the first responder.
+	uint8_t restart_responders(uint8_t anchor, uint8_t passed = DUELIST_NONE);
+	// The order of simultaneous triggers: free for all tp, tp+1, ...; Tag tp, tp+2, tp+1, tp+3.
+	uint8_t trigger_order(uint8_t* out) const;
+	// The next duelist after cur in trigger order for whom has_entry(q) is true. DUELIST_NONE if none.
+	template<typename F>
+	uint8_t next_trigger_player(uint8_t cur, F&& has_entry) const {
+		uint8_t order[MAX_DUELISTS];
+		const uint8_t count = trigger_order(order);
+		uint8_t i = 0;
+		while(i < count && order[i] != cur)
+			++i;
+		for(++i; i < count; ++i)
+			if(has_entry(order[i]))
+				return order[i];
+		return DUELIST_NONE;
+	}
 	void reload_field_info();
 
 	void add_card(uint8_t playerid, card* pcard, uint8_t location, uint8_t sequence, bool pzone = false);
