From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yugidraft <yugidraft@localhost>
Date: Tue, 4 Jan 2000 00:00:00 +0000
Subject: [PATCH] core: add duelist ids, teams and duelist helpers

Additive only. Nothing in the core calls the new helpers yet, so the
behaviour does not change.

- DUELIST_NONE (0xFF) and DUELIST_ALL (0xFE): core private ids for "no
  duelist" and "every duelist". PLAYER_NONE (2) and PLAYER_ALL (3) keep
  their values for Lua and the API. A later patch translates at the
  boundary, because 2 and 3 are real duelists in a 3 or 4 duelist duel.
- player_info::team and player_info::eliminated. field::field sets team to
  the duelist index for every entry, so each duelist is its own team.
  field::n_teams is 2.
- field::is_duelist(p) and field::is_alive(p) take an int64_t, so that a
  Lua or API value that does not fit uint8_t is never taken as a duelist.
- field::team_of, next_in_turn_order ((p + 1) % n_duelists, which is 1 - p
  for 2 duelists) and for_each_opponent.
- same_team now compares player_info::team. Nothing calls it yet, and
  with team = index it gives the same result as before (a == b).
---
 field.cpp |  4 ++++
 field.h   | 40 ++++++++++++++++++++++++++++++++++++++--
 2 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/field.cpp b/field.cpp
index 5cf6590..1a4d2aa 100644
--- a/field.cpp
+++ b/field.cpp
@@ -99,6 +99,10 @@ bool processor::delayed_effect_sort::operator()(const std::pair<effect*, tevent>
 }
 field::field(duel* _pduel, const OCG_DuelOptions& options) :pduel(_pduel), player({ {options.team1, options.team2} }) {
 	core.duel_options = options.flags;
+	// Every entry, also the unused ones, so that a later n_duelists value needs no other set up.
+	// This loop has no side effect (no message, no Lua call, no random number).
+	for(uint8_t p = 0; p < MAX_DUELISTS; ++p)
+		player[p].team = p;
 	nil_event.event_code = 0;
 	nil_event.event_cards = nullptr;
 	nil_event.event_player = PLAYER_NONE;
diff --git a/field.h b/field.h
index 1565a7e..b84e261 100644
--- a/field.h
+++ b/field.h
@@ -32,6 +32,12 @@ class effect;
 // Only the first field::n_duelists entries of field::player are in play.
 constexpr uint8_t MAX_DUELISTS = 4;
 static_assert(MAX_DUELISTS >= 2, "a duel needs two duelists");
+// Core-private duelist ids for "no duelist" and "every duelist". They are not duelist indexes.
+// The Lua and API values PLAYER_NONE (2) and PLAYER_ALL (3) keep their numbers: a later patch
+// translates them at the boundary, because 2 and 3 are real duelists in a 3 or 4 duelist duel.
+constexpr uint8_t DUELIST_NONE = 0xFF;
+constexpr uint8_t DUELIST_ALL = 0xFE;
+static_assert(MAX_DUELISTS < DUELIST_ALL, "the special ids must not be duelist indexes");
 
 struct tevent {
 	card* trigger_card{};
@@ -106,6 +112,10 @@ struct player_info {
 	std::vector<card_vector> extra_lists_hand;
 	std::vector<card_vector> extra_lists_extra;
 	std::vector<uint32_t> extra_extra_p_count;
+	// Team index of this duelist. Set by field::field: each duelist is its own team for now.
+	uint8_t team{ 0 };
+	// A duelist that lost in a duel of more than 2 duelists. Never set yet.
+	bool eliminated{ false };
 	// Used for the unused entries of field::player (index >= field::n_duelists). Never read in play.
 	player_info() : player_info(OCG_Player{}) {}
 	player_info(const OCG_Player& team) :
@@ -414,6 +424,7 @@ public:
 	// Indexed by absolute duelist id. Only [0, n_duelists) are in play. Never loop over the whole array.
 	std::array<player_info, MAX_DUELISTS> player;
 	uint8_t n_duelists{ 2 };
+	uint8_t n_teams{ 2 };
 	card* temp_card;
 	field_info infos;
 	//lpcost cost[2];
@@ -439,9 +450,27 @@ public:
 	uint8_t opponent_of(uint8_t p) const {
 		return static_cast<uint8_t>(1 - p);
 	}
-	// Every duelist is alone on its team for now. Tag teams arrive in a later patch.
+	// True for an index of a duelist in play. Takes a wide signed type so that a Lua or API value
+	// that does not fit uint8_t (for example 256 or -1) is never taken as a duelist.
+	bool is_duelist(int64_t p) const {
+		return p >= 0 && p < n_duelists;
+	}
+	// A duelist in play that is not eliminated.
+	bool is_alive(int64_t p) const {
+		return is_duelist(p) && !player[p].eliminated;
+	}
+	uint8_t team_of(uint8_t p) const {
+		return player[p].team;
+	}
+	// Every duelist is alone on its team for now (field::field sets team = index). Tag teams arrive
+	// in a later patch.
 	bool same_team(uint8_t a, uint8_t b) const {
-		return a == b;
+		return player[a].team == player[b].team;
+	}
+	// The duelist that plays after p. With 2 duelists this is 1 - p. The turn order patch replaces
+	// the seat order with the Tag and free for all orders.
+	uint8_t next_in_turn_order(uint8_t p) const {
+		return static_cast<uint8_t>((p + 1) % n_duelists);
 	}
 	// Calls f(p) for p = 0 .. n_duelists - 1 in ascending order (the stock order: player 0, then 1).
 	template<typename F>
@@ -449,6 +478,13 @@ public:
 		for(uint8_t p = 0; p < n_duelists; ++p)
 			f(p);
 	}
+	// Calls f(q) for every duelist q in play that is not on the team of p, in ascending order.
+	template<typename F>
+	void for_each_opponent(uint8_t p, F&& f) const {
+		for(uint8_t q = 0; q < n_duelists; ++q)
+			if(!same_team(p, q))
+				f(q);
+	}
 	void reload_field_info();
 
 	void add_card(uint8_t playerid, card* pcard, uint8_t location, uint8_t sequence, bool pzone = false);
