From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yugidraft <yugidraft@localhost>
Date: Fri, 14 Jan 2000 00:00:00 +0000
Subject: [PATCH] core: use duelist helpers in phase 1b sites

Seven pairs of HINT_EVENT messages in processor.cpp (player 0, then player 1) are now one loop over n_duelists, with the same bytes and order.
Two disabled_location resets and one used_location |= 0x1111 pair in processor.cpp, the MUST_USE_MZONE filter pair in operations.cpp, the spsummon_counter and spsummon_counter_rst reset in card.cpp, and the EQUIP hint_timing pair in libduel.cpp are now loops over n_duelists (12 sites).
Four validity checks on uint8_t values are now is_duelist: sumplayer in card.cpp, playerid in CreateToken, sumplayer in SpecialSummon and SpecialSummonStep.
With 2 duelists every loop runs for 0 and then 1, and is_duelist accepts exactly 0 and 1 like the old checks did for a uint8_t.
Left unchanged: CheckTiming and IsEnvironment in libduel.cpp (a[0] || a[1] inside one expression, not statement pairs), ControlAdjust, GetCustomActivityCount, and all phase 2 decision sites.
---
 card.cpp       |   8 ++--
 libduel.cpp    |  10 ++---
 operations.cpp |   4 +-
 processor.cpp  | 110 +++++++++++++++++++++----------------------------
 4 files changed, 60 insertions(+), 72 deletions(-)

diff --git a/card.cpp b/card.cpp
index dc9e9a8..c511e8e 100644
--- a/card.cpp
+++ b/card.cpp
@@ -1636,8 +1636,10 @@ void card::apply_field_effect() {
 	}
 	if(unique_code && (current.location & unique_location))
 		pduel->game_field->add_unique_card(this);
-	spsummon_counter[0] = spsummon_counter[1] = 0;
-	spsummon_counter_rst[0] = spsummon_counter_rst[1] = 0;
+	for(uint8_t p = 0; p < pduel->game_field->n_duelists; ++p) {
+		spsummon_counter[p] = 0;
+		spsummon_counter_rst[p] = 0;
+	}
 }
 void card::cancel_field_effect() {
 	if (current.controler == PLAYER_NONE)
@@ -3338,7 +3340,7 @@ int32_t card::is_can_be_special_summoned(effect* reason_effect, uint32_t sumtype
 			return FALSE;
 	}
 	sumtype |= SUMMON_TYPE_SPECIAL;
-	if((sumplayer == 0 || sumplayer == 1) && !pduel->game_field->is_player_can_spsummon(reason_effect, sumtype, sumpos, sumplayer, toplayer, this))
+	if(pduel->game_field->is_duelist(sumplayer) && !pduel->game_field->is_player_can_spsummon(reason_effect, sumtype, sumpos, sumplayer, toplayer, this))
 		return FALSE;
 	if(is_affected_by_effect(EFFECT_CANNOT_SPECIAL_SUMMON))
 		return FALSE;
