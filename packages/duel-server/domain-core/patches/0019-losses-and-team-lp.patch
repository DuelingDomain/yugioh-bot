+// Debug.EliminateDuelist(p, reason)
+// The host calls it with OCG_LoadScript between OCG_DuelProcess calls (surrender, time loss). Only in a
+// duel of more than 2 duelists, for a duelist who is in the duel. The loss is applied at the next Adjust
+// like a loss of all LP (MSG_DUELIST_ELIMINATED, or MSG_WIN when one team is left). A Tag team loses
+// as a whole. reason = the MSG_WIN reason code (0 to 255).
+LUA_STATIC_FUNCTION(EliminateDuelist) {
+	check_param_count(L, 2);
+	auto& field = pduel->game_field;
+	const auto p = lua_get<int64_t>(L, 1);
+	const auto reason = lua_get<int64_t>(L, 2);
+	if(field->n_duelists <= 2)
+		lua_error(L, "Debug.EliminateDuelist: only in a duel of more than 2 duelists.");
+	if(!field->is_alive(p))
+		lua_error(L, "Debug.EliminateDuelist: the duelist is not in the duel.");
+	if(reason < 0 || reason > 255)
+		lua_error(L, "Debug.EliminateDuelist: the reason must be 0 to 255.");
+	field->player[p].pending_loss = static_cast<uint16_t>(0x100 | reason);
+	return 0;
+}
+
 }
 }
 
