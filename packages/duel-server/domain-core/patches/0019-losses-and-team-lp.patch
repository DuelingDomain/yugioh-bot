+// Losses in a duel of more than 2 duelists (called from Adjust step 1 only).
+// A team loses by LP (LP of the team <= 0 and no living member has CANNOT_LOSE_LP), by deck (a member must
+// draw from an empty Deck and has no CANNOT_LOSE_DECK), by Debug.EliminateDuelist (pending_loss) or by
+// Duel.Win of another team (every living opponent without CANNOT_LOSE_EFFECT). Losses wait while a chain
+// resolves or a script runs. Then: no team is left = draw MSG_WIN(0xFF), one team is left = MSG_WIN(team),
+// else every loser is eliminated in turn order from the turn player.
+void field::check_losses_n() {
+	if(core.chain_solving || !pduel->lua->coroutines.empty())
+		return;
+	uint8_t order[MAX_DUELISTS];
+	uint8_t count = 0;
+	for(uint8_t i = 0; i < n_duelists; ++i) {
+		const auto p = static_cast<uint8_t>((infos.turn_player + i) % n_duelists);
+		if(is_alive(p))
+			order[count++] = p;
+	}
+	bool loses[MAX_DUELISTS] = {};
+	uint8_t reason_of[MAX_DUELISTS] = {};
+	auto mark = [&](uint8_t p, uint8_t rea) {
+		loses[p] = true;
+		reason_of[p] = rea;
+	};
+	for(uint8_t i = 0; i < count; ++i) {
+		const auto p = order[i];
+		if(lp_ref(p) <= 0) {
+			bool protect = false;
+			for(uint8_t q = 0; q < count; ++q) {
+				if(same_team(order[q], p) && is_player_affected_by_effect(order[q], EFFECT_CANNOT_LOSE_LP))
+					protect = true;
+			}
+			if(!protect)
+				mark(p, 1);
+		}
+		if(core.overdraw[p] && !is_player_affected_by_effect(p, EFFECT_CANNOT_LOSE_DECK))
+			mark(p, 2);
+		if(player[p].pending_loss)
+			mark(p, static_cast<uint8_t>(player[p].pending_loss & 0xFF));
+	}
+	// Duel.Win: only when the winner does not lose in the same window.
+	if(core.win_player != 5) {
+		const uint8_t w = core.win_player;
+		if(is_alive(w) && !loses[w]) {
+			for(uint8_t i = 0; i < count; ++i) {
+				const auto p = order[i];
+				if(!same_team(w, p) && !is_player_affected_by_effect(p, EFFECT_CANNOT_LOSE_EFFECT))
+					mark(p, core.win_reason);
+			}
+		}
+		core.win_player = 5;
+		core.win_reason = 0;
+	}
+	// A team loses as a whole: every member of a losing team loses with the reason of the member.
+	for(uint8_t i = 0; i < count; ++i) {
+		const auto p = order[i];
+		if(!loses[p])
+			continue;
+		for(uint8_t q = 0; q < count; ++q) {
+			if(!loses[order[q]] && same_team(order[q], p))
+				mark(order[q], reason_of[p]);
+		}
+	}
+	bool any_loser = false;
+	uint8_t first_reason = 0;
+	uint8_t stay_team = 0;
+	uint8_t stay_count = 0;
+	bool team_seen[MAX_DUELISTS] = {};
+	for(uint8_t i = 0; i < count; ++i) {
+		const auto p = order[i];
+		if(loses[p]) {
+			if(!any_loser)
+				first_reason = reason_of[p];
+			any_loser = true;
+		} else if(!team_seen[team_of(p)]) {
+			team_seen[team_of(p)] = true;
+			stay_team = team_of(p);
+			++stay_count;
+		}
+	}
+	if(!any_loser)
+		return;
+	const bool free_for_all = n_teams == n_duelists;
+	for(uint8_t i = 0; i < count; ++i) {
+		const auto p = order[i];
+		if(loses[p]) {
+			core.overdraw[p] = false;
+			player[p].pending_loss = 0;
+		}
+	}
+	if(stay_count >= 2) {
+		// The duel goes on. Only free for all has more than 2 teams.
+		for(uint8_t i = 0; i < count; ++i) {
+			if(loses[order[i]])
+				eliminate(order[i], reason_of[order[i]]);
+		}
+		return;
+	}
+	// The duel is over: no card leaves the game. Every duelist is marked so that MSG_WIN is sent once.
+	if(stay_count == 1 && free_for_all) {
+		for(uint8_t i = 0; i < count; ++i) {
+			const auto p = order[i];
+			if(!loses[p])
+				continue;
+			auto message = pduel->new_message(MSG_DUELIST_ELIMINATED);
+			message->write<uint8_t>(p);
+			message->write<uint8_t>(reason_of[p]);
+		}
+	}
+	auto message = pduel->new_message(MSG_WIN);
+	if(stay_count == 1) {
+		message->write<uint8_t>(stay_team);
+		message->write<uint8_t>(first_reason);
+	} else {
+		message->write<uint8_t>(DUELIST_NONE);
+		message->write<uint8_t>(first_reason);
+	}
+	for(uint8_t i = 0; i < count; ++i)
+		player[order[i]].eliminated = true;
+}
