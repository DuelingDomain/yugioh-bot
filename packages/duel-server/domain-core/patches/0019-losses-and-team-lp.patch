 	case 1: {
 		//win check(deck=0 or lp=0)
-		if(!core.force_turn_end){
+		if(n_duelists > 2) {
+			check_losses_n();
+		} else if(!core.force_turn_end){
 			uint32_t winp = 5, rea = 1;
 			if (player[0].lp <= 0 && player[1].lp > 0 && !is_player_affected_by_effect(0, EFFECT_CANNOT_LOSE_LP)) {
 				winp = 1;
