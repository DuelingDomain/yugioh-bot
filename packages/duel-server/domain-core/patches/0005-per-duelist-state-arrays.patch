 	card* pre_equip_target{};
diff --git a/common.h b/common.h
index b0fd585..abf5df5 100644
--- a/common.h
+++ b/common.h
@@ -32,6 +32,17 @@
 #include <cstdint>
 #include "ocgapi_constants.h"
 
+// Most duelists one duel can hold (2v2 Tag and 4-player free for all).
+// Only the first field::n_duelists entries of field::player are in play.
+constexpr uint8_t MAX_DUELISTS = 4;
+static_assert(MAX_DUELISTS >= 2, "a duel needs two duelists");
+// Core-private duelist ids for "no duelist" and "every duelist". They are not duelist indexes.
+// The Lua and API values PLAYER_NONE (2) and PLAYER_ALL (3) keep their numbers: a later patch
+// translates them at the boundary, because 2 and 3 are real duelists in a 3 or 4 duelist duel.
+constexpr uint8_t DUELIST_NONE = 0xFF;
+constexpr uint8_t DUELIST_ALL = 0xFE;
+static_assert(MAX_DUELISTS < DUELIST_ALL, "the special ids must not be duelist indexes");
+
 #define TRUE 1
 #define FALSE 0
 
