+	// With more than 2 duelists the direct attack can go to every living opponent that has no monster
+	// (to all of them with EFFECT_DIRECT_ATTACK or core.attack_player). The mask has one bit per duelist.
+	uint32_t dmask = 0;
+	if(n_duelists > 2) {
+		const bool any_side = pcard->is_affected_by_effect(EFFECT_DIRECT_ATTACK) || core.attack_player;
