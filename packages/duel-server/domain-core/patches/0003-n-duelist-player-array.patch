From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yugidraft <yugidraft@localhost>
Date: Mon, 3 Jan 2000 00:00:00 +0000
Subject: [PATCH] core: add MAX_DUELISTS and n_duelists, size player by
 MAX_DUELISTS

field::player becomes std::array<player_info, MAX_DUELISTS> (4) and field
gains n_duelists (2). player_info gets a default constructor for the two
unused entries. Helpers opponent_of, same_team and for_each_duelist are
added; nothing calls them yet.

No behaviour change. The pinned core has no loop, std::for_each, size() or
sizeof over the whole player array (checked with
scripts/list-two-player-sites.sh and a manual grep), so the two extra
entries are never visited and no RNG call changes. The only whole-array
use is the aggregate initializer in field::field, which now value
initializes entries 2 and 3.
---
 field.h | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/field.h b/field.h
index 8151a2f..1565a7e 100644
--- a/field.h
+++ b/field.h
@@ -28,6 +28,11 @@ class duel;
 class group;
 class effect;
 
+// Most duelists one duel can hold (2v2 Tag and 4-player free for all).
+// Only the first field::n_duelists entries of field::player are in play.
+constexpr uint8_t MAX_DUELISTS = 4;
+static_assert(MAX_DUELISTS >= 2, "a duel needs two duelists");
+
 struct tevent {
 	card* trigger_card{};
 	owned_lua<group> event_cards;
@@ -101,6 +106,8 @@ struct player_info {
 	std::vector<card_vector> extra_lists_hand;
 	std::vector<card_vector> extra_lists_extra;
 	std::vector<uint32_t> extra_extra_p_count;
+	// Used for the unused entries of field::player (index >= field::n_duelists). Never read in play.
+	player_info() : player_info(OCG_Player{}) {}
 	player_info(const OCG_Player& team) :
 		lp(team.startingLP), start_lp(team.startingLP),
 		start_count(team.startingDrawCount), draw_count(team.drawCountPerTurn) {
@@ -404,7 +411,9 @@ struct processor {
 class field {
 public:
 	duel* pduel;
-	std::array<player_info,2> player;
+	// Indexed by absolute duelist id. Only [0, n_duelists) are in play. Never loop over the whole array.
+	std::array<player_info, MAX_DUELISTS> player;
+	uint8_t n_duelists{ 2 };
 	card* temp_card;
 	field_info infos;
 	//lpcost cost[2];
@@ -424,6 +433,22 @@ public:
 	})();
 	explicit field(duel* pduel, const OCG_DuelOptions& options);
 	~field() = default;
+	// Duelist helpers. With n_duelists == 2 they give exactly the stock two-player results.
+	// opponent_of is only defined for n_duelists == 2 (it replaces "1 - p"). Sites that can see
+	// more than two duelists must use same_team and for_each_duelist instead.
+	uint8_t opponent_of(uint8_t p) const {
+		return static_cast<uint8_t>(1 - p);
+	}
+	// Every duelist is alone on its team for now. Tag teams arrive in a later patch.
+	bool same_team(uint8_t a, uint8_t b) const {
+		return a == b;
+	}
+	// Calls f(p) for p = 0 .. n_duelists - 1 in ascending order (the stock order: player 0, then 1).
+	template<typename F>
+	void for_each_duelist(F&& f) const {
+		for(uint8_t p = 0; p < n_duelists; ++p)
+			f(p);
+	}
 	void reload_field_info();
 
 	void add_card(uint8_t playerid, card* pcard, uint8_t location, uint8_t sequence, bool pzone = false);
