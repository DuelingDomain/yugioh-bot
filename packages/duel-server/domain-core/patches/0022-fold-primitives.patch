+void field::build_range_list(range_list& rl, uint8_t self, uint32_t loc1, uint32_t loc2) {
+	rl.count = 0;
+	auto add = [&rl](uint8_t who, uint32_t loc) {
+		rl.who[rl.count] = who;
+		rl.loc[rl.count] = loc;
+		++rl.count;
+	};
+	if(n_duelists == 2) {
+		add(self, loc1);
+		add(opponent_of(self), loc2);
+		return;
+	}
+	constexpr uint32_t individual = LOCATION_HAND | LOCATION_DECK | LOCATION_EXTRA;
+	// self side: P gets everything, the living partners of P only the field class
+	add(self, loc1);
+	if(loc1 & ~individual) {
+		for(uint8_t q = 0; q < n_duelists; ++q) {
+			if(q != self && is_alive(q) && same_team(self, q))
+				add(q, loc1 & ~individual);
+		}
+	}
+	// oppo side
+	if(loc2 & ~individual) {
+		for(uint8_t q = 0; q < n_duelists; ++q) {
+			if(is_alive(q) && !same_team(self, q))
+				add(q, loc2 & ~individual);
+		}
+	}
+	if(loc2 & individual) {
+		const uint8_t bound = pduel->lua->scope_bound_opp();
+		if(is_alive(bound) && !same_team(self, bound)) {
+			add(bound, loc2 & individual);
+		} else {
+			pduel->lua->scope_mark_touched();
+			for(uint8_t q = 0; q < n_duelists; ++q) {
+				if(is_alive(q) && !same_team(self, q))
+					add(q, loc2 & individual);
+			}
+		}
+	}
+}
+const card_vector& field::side_cards(uint8_t p, bool oppo, card_vector player_info::* list, card_vector& tmp) {
+	if(n_duelists == 2)
+		return player[oppo ? opponent_of(p) : p].*list;
+	tmp.clear();
+	for(uint8_t q = 0; q < n_duelists; ++q) {
+		if(!is_alive(q) || same_team(p, q) == oppo)
+			continue;
+		tmp.insert(tmp.end(), (player[q].*list).begin(), (player[q].*list).end());
+	}
+	return tmp;
+}
