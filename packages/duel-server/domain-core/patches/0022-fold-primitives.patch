+	// yet except the field queries that read it; the Lua entry points push in a later task.
+	struct lua_scope {
+		uint8_t P{ DUELIST_NONE };
+		uint8_t* bound{ nullptr };
+		bool yieldable{ false };
+		bool probe{ false };
+		bool touched{ false };
+	};
+	std::vector<lua_scope> scopes;
+	void push_scope(uint8_t P, uint8_t* bound = nullptr, bool yieldable = false, bool probe = false) {
+		lua_scope s;
