 	// Takes p out of the duel (n > 2): message 200, p's cards, chain links and turn. reason = the MSG_WIN reason code
-	// that applies. Does nothing with 2 duelists or when p is already out.
-	void eliminate(uint8_t p, uint8_t reason);
+	// that applies. Does nothing with 2 duelists or when p is already out. marked = the caller set
+	// player[p].eliminated already (several duelists lose in the same check, so every loser is dead before
+	// any body runs): then p is not "already out" and the body runs.
+	void eliminate(uint8_t p, uint8_t reason, bool marked = false);
 	// Applies the losses of a duel with more than 2 duelists (Adjust step 1). Sends MSG_WIN at the end.
 	void check_losses_n();
 	// Calls f(p) for p = 0 .. n_duelists - 1 in ascending order (the stock order: player 0, then 1).
