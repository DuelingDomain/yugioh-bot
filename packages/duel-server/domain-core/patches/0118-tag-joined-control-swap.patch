+// Joined Tag groups keep physical facing destinations (0/1 and 2/3),
+// while each receiving controller chooses every placement before any move.
+LUA_STATIC_FUNCTION(MPTagSwapControl) {
+	check_action_permission(L);
+	check_param_count(L, 2);
+	auto& field = *pduel->game_field;
+	auto* first = lua_get<group*, true>(L, 1);
+	auto* second = lua_get<group*, true>(L, 2);
+	auto targets1 = pduel->new_group(first->container);
+	auto targets2 = pduel->new_group(second->container);
+	targets1->is_readonly = targets2->is_readonly = true;
+	field.emplace_process<Processors::TagSwapControl>(field.core.reason_effect, field.core.reason_player, targets1, targets2);
+	return yieldk({
+		lua_pushboolean(L, pduel->game_field->returns.at<int32_t>(0));
+		return 1;
+	});
+}
