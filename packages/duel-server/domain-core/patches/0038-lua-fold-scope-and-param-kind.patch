new file mode 100644
index 0000000..8800613
--- /dev/null
+++ b/fold.h
@@ -0,0 +1,249 @@
+/*
+ * Phase 3 perspective fold: the helpers that the Lua library functions use.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ *
+ * Contract (see also F1/fold-api.md):
+ *  - With 2 duelists, or when no scope is active (Lua outside every effect: duel start, domain.lua
+ *    setup), every helper here is the identity on core ids: the library function does what it did before.
+ *  - With more than 2 duelists and a scope for duelist P, Lua sees only 0 (P; in Tag P's team) and 1
+ *    (the opponents), plus PLAYER_NONE (2) and PLAYER_ALL (3). The helpers turn the Lua value v into core
+ *    seat ids, and core seat ids into the Lua value.
+ *  - v is the value that lua_get<uint8_t> gave (the same cast as before the fold).
+ *  - A value that is not 0, 1, 2 or 3 inside a scope is a kind (d) record: the helper gives the empty
+ *    result (INVALID, count 0, false). Never index player[] with it.
+ *  - A fold trap record is one stderr line in the YGO_N_TRAP build only. It never aborts.
+ */
+#ifndef FOLD_H_
+#define FOLD_H_
+
+#include <cstdint>
+#include "common.h"
+#include "duel.h"
+#include "field.h"
+#include "interpreter.h"
+#include "scriptlib.h"
+
+namespace fold {
+
+// Result of unfold_action when the Lua value cannot be turned into a duelist (kind d, or no living
+// opponent). It is not a duelist id, not none_id() and not all_id(): the function returns its empty result.
+constexpr uint8_t INVALID = 0xFD;
+
+// The scope that folds, or nullptr when the helpers are the identity (2 duelists, no scope, or a scope
+// whose P is not a duelist in play).
+inline const interpreter::lua_scope* active(duel* pduel) {
+	const auto& f = *pduel->game_field;
+	if(f.n_duelists <= 2)
+		return nullptr;
+	const auto* s = pduel->lua->current_scope();
+	return (s && f.is_duelist(s->P)) ? s : nullptr;
+}
+
+// True when the Lua value v (0 or 1) means the own side of the duelist P.
+inline bool is_own(const field& f, uint8_t P, uint8_t v) {
+	return v == (f.n_teams == f.n_duelists ? 0 : f.team_of(P));
+}
+
+// The next living opponent of P in turn order (P + 1, P + 2, ... mod n). DUELIST_NONE if none.
+inline uint8_t next_opponent(const field& f, uint8_t P) {
+	for(uint8_t i = 1; i < f.n_duelists; ++i) {
+		const auto q = static_cast<uint8_t>((P + i) % f.n_duelists);
+		if(f.is_alive(q) && !f.same_team(P, q))
+			return q;
+	}
+	return DUELIST_NONE;
+}
+
+// Class "individual action" (Draw, Damage, Recover, hand and Deck moves, a player that acts): the Lua value
+// names ONE duelist. 0 = P. 1 = the bound opponent; with nothing bound it is the next living opponent of P
+// in turn order and a kind (a) record is written (the fallback does not bind: the lazy prompt of F5 will).
+// PLAYER_NONE and PLAYER_ALL give none_id() and all_id(). Returns INVALID for kind (d) or when no opponent
+// lives. team_level = the function only changes the team LP (lp_ref): in Tag any seat of the other team
+// is right, so no record is written there.
+// Identity (returns v) when the fold is not active: the caller keeps its own is_duelist test.
+inline uint8_t unfold_action(duel* pduel, uint8_t v, const char* fn, bool team_level = false) {
+	const auto* s = active(pduel);
+	if(!s)
+		return v;
+	const auto& f = *pduel->game_field;
+	if(v == PLAYER_NONE)
+		return f.none_id();
+	if(v == PLAYER_ALL)
+		return f.all_id();
+	if(v > 1) {
+		pduel->lua->fold_trap('d', fn);
+		return INVALID;
+	}
+	const uint8_t P = s->P;
+	if(is_own(f, P, v))
+		return P;
+	const uint8_t bound = pduel->lua->scope_bound_opp();
+	if(f.is_alive(bound) && !f.same_team(P, bound))
+		return bound;
+	const uint8_t next = next_opponent(f, P);
+	if(next == DUELIST_NONE)
+		return INVALID;
+	if(!(team_level && f.n_teams != f.n_duelists))
+		pduel->lua->fold_trap('a', fn);
+	return next;
+}
+
+// Class "individual query" (hand and Deck contents, zone counts, draw checks, LP in FFA): the Lua value
+// names one duelist, or, for "1" with nothing bound, every living opponent. Writes the duelists to out and
+// returns the count (0 = empty result). With nothing bound the scope is marked `touched`, so that the
+// activation probe of F5 knows that the answer depends on the opponent. A function that has to return one
+// value for several opponents returns the best case ("errs to yes": the largest count, any match).
+// PLAYER_NONE, PLAYER_ALL give count 0 without a record (the stock result of an invalid player).
+// Identity when not active: {v} if v is a duelist, else count 0.
+inline uint8_t query_list(duel* pduel, uint8_t v, uint8_t (&out)[MAX_DUELISTS], const char* fn) {
+	const auto& f = *pduel->game_field;
+	const auto* s = active(pduel);
+	if(!s) {
+		if(!f.is_duelist(v))
+			return 0;
+		out[0] = v;
+		return 1;
+	}
+	if(v == PLAYER_NONE || v == PLAYER_ALL)
+		return 0;
+	if(v > 1) {
+		pduel->lua->fold_trap('d', fn);
+		return 0;
+	}
+	const uint8_t P = s->P;
+	if(is_own(f, P, v)) {
+		out[0] = P;
+		return 1;
+	}
+	const uint8_t bound = pduel->lua->scope_bound_opp();
+	if(f.is_alive(bound) && !f.same_team(P, bound)) {
+		out[0] = bound;
+		return 1;
+	}
+	pduel->lua->scope_mark_touched();
+	uint8_t count = 0;
+	for(uint8_t q = 0; q < f.n_duelists; ++q) {
+		if(f.is_alive(q) && !f.same_team(P, q))
+			out[count++] = q;
+	}
+	return count;
+}
+
+// Class "field": the side of the Lua value as a set of duelists, for cards that live on the field
+// (zones, Graveyard, banished, overlay, counters). 0 = every living duelist of P's team (P first).
+// 1 = every living opponent (the bound opponent is NOT used and the scope is not touched).
+// Same output convention as query_list. Identity when not active: {v} if v is a duelist.
+inline uint8_t field_list(duel* pduel, uint8_t v, uint8_t (&out)[MAX_DUELISTS], const char* fn) {
+	const auto& f = *pduel->game_field;
+	const auto* s = active(pduel);
+	if(!s) {
+		if(!f.is_duelist(v))
+			return 0;
+		out[0] = v;
+		return 1;
+	}
+	if(v == PLAYER_NONE || v == PLAYER_ALL)
+		return 0;
+	if(v > 1) {
+		pduel->lua->fold_trap('d', fn);
+		return 0;
+	}
+	const uint8_t P = s->P;
+	const bool own = is_own(f, P, v);
+	uint8_t count = 0;
+	if(own)
+		out[count++] = P;
+	for(uint8_t q = 0; q < f.n_duelists; ++q) {
+		if(q != P && f.is_alive(q) && f.same_team(P, q) == own)
+			out[count++] = q;
+	}
+	return count;
+}
+
+// Class "field reference": for the functions that take (player, location1, location2) or (player, self,
+// oppo), where location1 / self is the side of the player and location2 / oppo the other side, and that
+// end in filter_field_card, build_range_list, get_overlay_group, get_field_counter and the like.
+// Those core functions already treat a core seat as "its team against every opponent" (and the scope reads
+// the bound opponent for the individual locations of the other side). So the fold needs only the seat of P
+// and one flag:  Lua 0 -> {self = P, swap = false};  Lua 1 -> {self = P, swap = true}. When swap is set the
+// caller exchanges its two location arguments (or its self / oppo flags) before it calls the core function.
+// Then "1, MZONE, 0" reads every opponent's monster zones, and "1, 0, MZONE" reads the own team's.
+// ok = false: kind (d) value, PLAYER_NONE, PLAYER_ALL, or P is not in play: give the empty result.
+// Identity when not active: {ok = v is a duelist, self = v, swap = false}.
+struct field_view {
+	bool ok;
+	uint8_t self;
+	bool swap;
+};
+inline field_view field_side(duel* pduel, uint8_t v, const char* fn) {
+	const auto& f = *pduel->game_field;
+	const auto* s = active(pduel);
+	if(!s)
+		return { f.is_duelist(v), v, false };
+	if(v == PLAYER_NONE || v == PLAYER_ALL)
+		return { false, DUELIST_NONE, false };
+	if(v > 1) {
+		pduel->lua->fold_trap('d', fn);
+		return { false, DUELIST_NONE, false };
+	}
+	return { true, s->P, !is_own(f, s->P, v) };
+}
+
+// Class "broadcast": calls fn(q) for every living duelist q (a core id) except d, in ascending order.
+// Takes a core id: the caller unfolds the player first (unfold_action) or uses a core id directly.
+template<typename F>
+inline void for_each_other(duel* pduel, uint8_t d, F&& fn) {
+	const auto& f = *pduel->game_field;
+	for(uint8_t q = 0; q < f.n_duelists; ++q) {
+		if(q != d && f.is_alive(q))
+			fn(q);
+	}
+}
+
+// Class "PLAYER_ALL fan-out": calls fn(q) for every living duelist when v means PLAYER_ALL (3 in a
+// scope, all_id() outside), else once for unfold_action(v). Does not call fn for INVALID.
+template<typename F>
+inline void for_each_target(duel* pduel, uint8_t v, const char* name, F&& fn) {
+	const auto& f = *pduel->game_field;
+	const bool folding = active(pduel) != nullptr;
+	if(v == (folding ? PLAYER_ALL : f.all_id())) {
+		for(uint8_t q = 0; q < f.n_duelists; ++q) {
+			if(f.is_alive(q))
+				fn(q);
+		}
+		return;
+	}
+	const uint8_t d = unfold_action(pduel, v, name);
+	if(d != INVALID)
+		fn(d);
+}
+
+// Class "predicate": does the Lua value v name the core duelist d? Compares the folded value, so "1"
+// matches every opponent and 0 matches P (Tag: the partner too). A d that is not a duelist (none_id(),
+// all_id()) keeps its meaning (2 and 3). Identity (v == d) when not active.
+inline bool matches(duel* pduel, uint8_t v, uint8_t d) {
+	if(!active(pduel))
+		return v == d;
+	return pduel->lua->fold_out(d) == v;
+}
+
+// A player that a library function returns: pushes the folded value (identity when not active).
+// bind = true: "bind on read". In a scope with nothing bound, a returned living opponent becomes the
+// bound opponent of the scope (the chain link). A second different opponent is a kind (b) record
+// and the first one stays. Use bind = false for reads that run in filters (a filter sees every card,
+// so a read there says nothing about the one opponent of the link).
+inline void push_player(lua_State* L, duel* pduel, uint8_t d, bool bind = true) {
+	if(bind) {
+		if(const auto* s = active(pduel)) {
+			const auto& f = *pduel->game_field;
+			if(f.is_alive(d) && !f.same_team(s->P, d) && !pduel->lua->scope_bind(d))
+				pduel->lua->fold_trap('b', "push_player");
+		}
+	}
+	lua_pushinteger(L, pduel->lua->fold_out(d));
+}
