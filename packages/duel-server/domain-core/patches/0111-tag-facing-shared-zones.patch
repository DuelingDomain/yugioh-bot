From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yugidraft <yugidraft@localhost>
Date: Fri, 21 Apr 2000 00:00:00 +0000
Subject: [PATCH] core: share Tag facing EMZ, Link arrows and columns

Owner decision 2026-10-07: Tag p0/p1 and p2/p3 face each other. Reuse FFA4 physical geometry, mirrored occupancy/disabled EMZ, zone masks and Lua geometry helpers. Main fields and partner materials remain separate from geometry. FFA3 and 1v1 keep their paths.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019EpX1AcvnigK9dTsxAa5W9
---
 field.cpp     |  6 +++---
 field.h       | 12 ++++++++----
 fold_lib.h    | 10 +++++-----
 libcard.cpp   |  2 +-
 libduel.cpp   |  4 ++--
 processor.cpp | 12 ++++++------
 6 files changed, 25 insertions(+), 21 deletions(-)

diff --git a/field.cpp b/field.cpp
index 103f5d9..ee3fd2d 100644
--- a/field.cpp
+++ b/field.cpp
@@ -1379,7 +1379,7 @@ uint32_t field::get_rule_zone_fromex(int32_t playerid, card* pcard) {
 }
 field::zone_mask_scope::zone_mask_scope(field* field, effect* peffect, bool fresh)
 	: f(field), previous(field->evaluating_zone_mask) {
-	if(f->n_duelists == 4 && f->n_teams == f->n_duelists
+	if(f->has_shared_zones()
 		&& (peffect->code == EFFECT_DISABLE_FIELD || peffect->code == EFFECT_BECOME_LINKED_ZONE)) {
 		f->evaluating_zone_mask = peffect;
 		if(fresh) {
@@ -1396,7 +1396,7 @@ uint8_t field::zone_opponent(effect* peffect) const {
 	const auto handler = peffect->get_handler_player();
 	if(!is_duelist(handler))
 		return DUELIST_NONE;
-	if(n_duelists == 4 && n_teams == n_duelists) {
+	if(has_shared_zones()) {
 		if(peffect->disfield_selected)
 			return peffect->disfield_opp;
 		if(is_duelist(peffect->disfield_operation_opp))
@@ -1455,7 +1455,7 @@ uint32_t field::get_linked_zone(int32_t playerid, bool free, bool actually_linke
 					const uint8_t handler = peff->get_handler_player();
 					if(handler == playerid)
 						zones |= value & 0x7f;
-					else if(is_duelist(handler) && ((n_duelists == 4 && n_teams == n_duelists)
+					else if(is_duelist(handler) && ((has_shared_zones())
 						? zone_opponent(peff) : next_in_turn_order(handler)) == playerid)
 						zones |= (value >> 16) & 0x7f;
 				}
diff --git a/field.h b/field.h
index 29970b0..796275a 100644
--- a/field.h
+++ b/field.h
@@ -546,12 +546,16 @@ public:
 	bool is_skipped_seat(int64_t p) const {
 		return n_duelists > 2 && !is_alive(p);
 	}
-	// Facing fields: FFA4 pairs 0/1 and 2/3 (owner decision 2026-10-04).
-	// FFA3 and Tag have separate fields; 1v1 keeps its opponent field.
+	// Four-seat facing geometry is shared by FFA4 and Tag (owner 2026-10-07).
+	bool has_shared_zones() const {
+		return n_duelists == 4 && (n_teams == n_duelists || n_teams == 2);
+	}
+	// Tag: p0=1A, p1=2A, p2=1B, p3=2B. Both formats face 0/1 and 2/3.
+	// FFA3 has separate EMZ/Links; 1v1 keeps its opponent field.
 	uint8_t across_of(uint8_t p) const {
 		if(n_duelists == 2)
 			return opponent_of(p);
-		if(n_duelists == 4 && n_teams == n_duelists && is_alive(p)) {
+		if(has_shared_zones() && is_alive(p)) {
 			const auto q = static_cast<uint8_t>(p ^ 1);
 			if(is_alive(q))
 				return q;
@@ -563,7 +567,7 @@ public:
 	// as opponent-dependent via scope_mark_touched(). It does not bind a seat.
 	uint8_t column_peer_of(uint8_t p) const;
 	// The high half of a zone effect: explicit selection, geometry, bound seat,
-	// then the physical across field (FFA4) or the existing separate-field fallback.
+	// then the physical across field (FFA4/Tag) or the separate-field fallback.
 	uint8_t zone_opponent(effect* peffect) const;
 	uint8_t team_of(uint8_t p) const {
 		return player[p].team;
