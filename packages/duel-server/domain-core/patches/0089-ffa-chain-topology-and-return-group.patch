+bool field::is_removed_chain_event(const tevent& event) const {
+	if(n_duelists <= 2 || n_teams != n_duelists || event.event_code != EVENT_CHAINING)
+		return false;
+	return event.event_value > 0 && (event.event_value > core.current_chain.size()
+		|| core.current_chain[event.event_value - 1].removed_by_elimination);
+}
+chain* field::get_current_chain() {
+	for(auto it = core.current_chain.rbegin(); it != core.current_chain.rend(); ++it)
+		if(!it->removed_by_elimination)
+			return &*it;
+	return nullptr;
+}
+uint32_t field::active_chain_size(bool completed) const {
+	if(n_duelists <= 2 || n_teams != n_duelists)
+		return completed ? core.real_chain_count : core.current_chain.size();
+	return std::count_if(core.current_chain.begin(), core.current_chain.end(), [completed](const chain& ch) {
+		return !ch.removed_by_elimination && (!completed || ch.counted_in_chain);
+	});
+}
+uint8_t field::previous_chain(bool completed) const {
+	if(n_duelists <= 2 || n_teams != n_duelists)
+		return static_cast<uint8_t>(std::max<int32_t>(0, (completed ? core.real_chain_count : core.current_chain.size()) - 1));
+	bool found = false;
+	for(auto it = core.current_chain.rbegin(); it != core.current_chain.rend(); ++it) {
+		if(it->removed_by_elimination || (completed && !it->counted_in_chain))
+			continue;
+		if(found)
+			return it->chain_count;
+		found = true;
+	}
+	return 0;
+}
 chain* field::get_chain(uint8_t chaincount) {
 	if(chaincount == 0 && core.continuous_chain.size() && (core.reason_effect != nullptr && core.reason_effect->type & EFFECT_TYPE_CONTINUOUS))
 		return &core.continuous_chain.back();
-	if(chaincount == 0 || chaincount > core.current_chain.size()) {
-		chaincount = (uint8_t)core.current_chain.size();
-		if(chaincount == 0)
-			return nullptr;
+	if(chaincount == 0) {
+		// A suspended removed activation must finish its own setters and release
+		// references; it must never write into the preceding living link.
+		const auto* scope = pduel->lua->current_scope();
+		if(scope && !core.current_chain.empty() && core.current_chain.back().removed_by_elimination
+			&& scope->eff == core.current_chain.back().triggering_effect)
+			return &core.current_chain.back();
+		return get_current_chain();
 	}
-	return &core.current_chain[chaincount - 1];
+	if(chaincount > core.current_chain.size())
+		return get_current_chain();
+	auto* ch = &core.current_chain[chaincount - 1];
+	return ch->removed_by_elimination ? nullptr : ch;
 }
 int32_t field::get_cteffect(effect* peffect, int32_t playerid, int32_t store) {
 	card* phandler = peffect->get_handler();
