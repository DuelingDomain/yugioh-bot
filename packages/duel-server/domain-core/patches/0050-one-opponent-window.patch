+		s->mp.open = true;
+		s->mp.kind = interpreter::MPW_ONE;
+		s->mp.seat = DUELIST_NONE;
+		lua_pushboolean(L, TRUE);
+		return 1;
+	}
+	const auto& f = *pduel->game_field;
+	uint8_t seat = DUELIST_NONE;
+	uint8_t k = 0;
+	for(uint8_t j = 1; i >= 1 && i <= MAX_DUELISTS && j < f.n_duelists; ++j) {
+		const auto q = static_cast<uint8_t>((s->P + j) % f.n_duelists);
