+// ---- F7 one-opponent window (n > 2 only; at n == 2 every function here is a no-op that answers "no mode")
+// The scope that these functions work on: n > 2 and a scope for a duelist. nullptr otherwise.
+static interpreter::lua_scope* f7_scope(duel* pduel) {
+	const auto& f = *pduel->game_field;
+	if(f.n_duelists <= 2)
+		return nullptr;
+	auto* s = pduel->lua->current_scope();
+	return (s && f.is_duelist(s->P)) ? s : nullptr;
+}
+// The bound opponent of the scope or chain link, without the window (a SEAT window is not a binding).
+static uint8_t f7_raw_bound(const interpreter::lua_scope* s) {
+	return interpreter::scope_raw_bound(s);
+}
+// The first run of an activation probe (is_activateable pins the scope): nothing is bound and the scope cannot ask.
+// probe_bind runs the checks again once per opponent when this run passes and `touched` is set, so a missing binding
+// is expected here and is not an error. The run errs to yes: the function marks `touched` and answers "bound".
+static bool f7_first_run(const interpreter::lua_scope* s) {
+	return s->pinned || s->probe;
+}
+// Duel.MPMode(): 0 at n == 2, 1 FFA, 2 Tag.
+LUA_STATIC_FUNCTION(MPMode) {
+	const auto& f = *pduel->game_field;
+	lua_pushinteger(L, f.n_duelists <= 2 ? 0 : (f.n_teams == f.n_duelists ? 1 : 2));
+	return 1;
+}
+// Duel.MPBound(): true when an opponent is bound in this scope or chain link.
+LUA_STATIC_FUNCTION(MPBound) {
+	const auto* s = f7_scope(pduel);
+	lua_pushboolean(L, s && f7_raw_bound(s) != DUELIST_NONE);
+	return 1;
+}
+// Duel.MPOppCount(): the number of living opponent duelists of the scope player (Tag: the opposing members).
+LUA_STATIC_FUNCTION(MPOppCount) {
+	const auto* s = f7_scope(pduel);
+	uint8_t opp[MAX_DUELISTS];
+	lua_pushinteger(L, s ? pduel->game_field->living_opponents(s->P, opp) : 0);
+	return 1;
+}
+// Duel.MPNeedPick(): the check depends on WHICH opponent. Sets `touched`, so the activation probe runs the checks once
+// per living opponent and the activator is asked at activation. Harmless when an opponent is bound already.
+LUA_STATIC_FUNCTION(MPNeedPick) {
+	if(f7_scope(pduel))
+		pduel->lua->scope_mark_touched();
+	return 0;
