+bool field::opp_restrict(uint8_t self, uint8_t& seat, uint8_t use) {
+	seat = DUELIST_NONE;
+	if(n_duelists <= 2)
+		return false;
+	auto* sc = pduel->lua->current_scope();
+	if(!sc || !is_duelist(sc->P) || !same_team(sc->P, self))
+		return false;
+	// the Tag gate covers the ONE window only: a SEAT window reads one duelist in Tag as well
+	if((use & OPP_WINDOW) && pduel->lua->window_applies(sc)) {
+		if(sc->mp.kind == interpreter::MPW_ONE && pduel->lua->scope_probing(sc)) {
+			// first run of an activation probe: nothing is bound yet, the check errs to yes (every opponent)
+			pduel->lua->scope_mark_touched();
+			return false;
+		}
+		const uint8_t w = pduel->lua->window_seat(sc);
+		if(w == DUELIST_NONE)
+			pduel->lua->fold_trap('W', "opp_restrict");
+		else if(is_alive(w) && !same_team(self, w))
+			seat = w;
+		return true;
+	}
+	// F5: a summon procedure scope (also in Tag). Nothing bound keeps the stock rule: every living opponent.
+	if((use & OPP_EXCL) && sc->exclusive) {
+		const uint8_t b = pduel->lua->scope_raw_bound(sc);
+		if(b == DUELIST_NONE)
+			return false;
+		if(is_alive(b) && !same_team(self, b))
+			seat = b;
+		return true;
+	}
+	return false;
