+bool interpreter::window_applies(const lua_scope* s) const {
+	const auto* gf = pduel->game_field;
+	if(!s || !s->mp.open || !gf || gf->n_duelists <= 2)
+		return false;
+	return s->mp.kind == MPW_SEAT || gf->n_teams == gf->n_duelists;
+}
+uint8_t interpreter::scope_bound_opp() {
+	if(scopes.empty())
+		return DUELIST_NONE;
+	const auto& s = scopes.back();
+	if(!window_applies(&s))
+		return scope_raw_bound(&s);
+	const uint8_t w = window_seat(&s);
+	if(w != DUELIST_NONE)
+		return w;
+	if(s.mp.kind == MPW_ONE && scope_probing(&s))
+		return DUELIST_NONE;
+	fold_trap('W', "scope_bound_opp");
+	return DUELIST_WINDOW_EMPTY;
