 	card* temp_card;
 	field_info infos;
 	//lpcost cost[2];
@@ -436,7 +445,18 @@ public:
 	// Duelist helpers. With n_duelists == 2 they give exactly the stock two-player results.
 	// opponent_of is only defined for n_duelists == 2 (it replaces "1 - p"). Sites that can see
 	// more than two duelists must use same_team and for_each_duelist instead.
-	uint8_t opponent_of(uint8_t p) const {
+	// Native test builds define YGO_N_TRAP: then a call with more than two duelists prints the
+	// caller's file and line and aborts. Without the define the extra arguments are not used.
+	uint8_t opponent_of(uint8_t p, const char* file = __builtin_FILE(), int line = __builtin_LINE()) const {
+#ifdef YGO_N_TRAP
+		if(n_duelists > 2) {
+			std::fprintf(stderr, "YGO_N_TRAP opponent_of %s:%d p=%d\n", file, line, static_cast<int>(p));
+			std::abort();
+		}
+#else
+		(void)file;
+		(void)line;
+#endif
 		return static_cast<uint8_t>(1 - p);
 	}
 	// True for an index of a duelist in play. Takes a wide signed type so that a Lua or API value
@@ -451,16 +471,37 @@ public:
 	uint8_t team_of(uint8_t p) const {
 		return player[p].team;
 	}
+	// The LP that p's team uses. The team id is the lowest seat of the team, so in 1v1 and free for
+	// all this is player[p].lp. In Tag both partners share the LP of the team entry.
+	int32_t& lp_ref(uint8_t p) {
+		return player[team_of(p)].lp;
+	}
+	const int32_t& lp_ref(uint8_t p) const {
+		return player[team_of(p)].lp;
+	}
 	// Every duelist is alone on its team for now (field::field sets team = index). Tag teams arrive
 	// in a later patch.
 	bool same_team(uint8_t a, uint8_t b) const {
 		return player[a].team == player[b].team;
 	}
-	// The duelist that plays after p. With 2 duelists this is 1 - p. The turn order patch replaces
-	// the seat order with the Tag and free for all orders.
+	// The next duelist clockwise after p that is not eliminated, starting at p + 1 (mod n_duelists).
+	// If no other duelist is alive, p. With 2 duelists and none eliminated this is (p + 1) % 2.
+	// Note: a loop that calls this n_duelists times visits a duelist twice after an elimination.
 	uint8_t next_in_turn_order(uint8_t p) const {
-		return static_cast<uint8_t>((p + 1) % n_duelists);
+		for(uint8_t i = 1; i < n_duelists; ++i) {
+			const auto q = static_cast<uint8_t>((p + i) % n_duelists);
+			if(is_alive(q))
+				return q;
+		}
+		return p;
+	}
+	// True while no duelist can enter the Battle Phase because it is too early in the duel.
+	// With first_attack_turn == 2 this is the stock test "turn_id == 1".
+	bool before_first_attack_turn() const {
+		return infos.turn_id >= 1 && infos.turn_id < first_attack_turn;
 	}
+	// Marks p as out of the duel. The elimination patch adds the rest (cards, chain, turn, win).
+	void eliminate(uint8_t p);
 	// Calls f(p) for p = 0 .. n_duelists - 1 in ascending order (the stock order: player 0, then 1).
 	template<typename F>
 	void for_each_duelist(F&& f) const {
