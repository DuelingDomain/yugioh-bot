+// The duelist who rolls the count2 dice of Duel.TossDice. With 2 duelists this is the opponent. With more, one
+// opponent rolls: the first living duelist clockwise from playerid who is not on its team (playerid if there is none).
+// Every opponent rolling would change the number of results that the Lua side and the replace effects expect.
+static uint8_t toss_dice_opponent(const field& f, uint8_t playerid) {
+	if(f.n_duelists == 2)
+		return f.opponent_of(playerid);
+	for(uint8_t k = 1; k < f.n_duelists; ++k) {
+		const uint8_t q = static_cast<uint8_t>((playerid + k) % f.n_duelists);
+		if(f.is_alive(q) && !f.same_team(playerid, q))
+			return q;
+	}
+	return playerid;
+}
