@@ -3141,6 +3141,9 @@ int32_t field::is_player_can_discard_deck_as_cost(uint8_t playerid, uint32_t cou
 		if(redirect & LOCATION_REMOVED) {
 			if(topcard->is_affected_by_effect(EFFECT_CANNOT_REMOVE))
 				continue;
+			// With more than 2 duelists every other duelist is judged by its own effects (the handler player p).
+			if(n_duelists > 2 && p != playerid)
+				cant_remove_o = is_duelist(p) && !is_player_can_action(p, EFFECT_CANNOT_REMOVE);
 			if((cant_remove_s && (p == playerid)) || (cant_remove_o && (p != playerid)))
 				continue;
 		}
