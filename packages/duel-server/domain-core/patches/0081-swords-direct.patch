From 4a17c687766ab8e30ce1c0a83bcfd141451987c7 Mon Sep 17 00:00:00 2001
From: Duelists Kingdom Engine <engine@duelistskingdom.com>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Respect protected FFA seats during direct attacks

---
 effect_constants.h |  2 ++
 field.cpp          |  8 ++++++--
 libduel.cpp        | 26 ++++++++++++++++++++++++++
 3 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/effect_constants.h b/effect_constants.h
index 87f3bcb..b0fdf94 100644
--- a/effect_constants.h
+++ b/effect_constants.h
@@ -174,6 +174,8 @@ inline effect_flag operator|(effect_flag flag1, effect_flag flag2)
 #define EFFECT_CANNOT_BE_EFFECT_TARGET      71
 #define EFFECT_IGNORE_BATTLE_TARGET         72
 #define EFFECT_CANNOT_DIRECT_ATTACK         73
+// Fork-private player effect: a protected FFA seat cannot be attacked directly.
+#define EFFECT_CANNOT_BE_DIRECT_ATTACKED		0x7F000101
 #define EFFECT_DIRECT_ATTACK                74
 #define EFFECT_GEMINI_STATUS                75
 #define EFFECT_EQUIP_LIMIT                  76
diff --git a/field.cpp b/field.cpp
index 9abd4a0..8ca1e1e 100644
--- a/field.cpp
+++ b/field.cpp
@@ -3308,7 +3308,8 @@ int32_t field::get_attack_target(card* pcard, card_vector* v, bool chain_attack,
 	if(n_duelists > 2) {
 		const bool any_side = pcard->is_affected_by_effect(EFFECT_DIRECT_ATTACK) || core.attack_player;
 		for(uint8_t oi = 0; oi < opp_count; ++oi)
-			if(any_side || mcount_by[opps[oi]] == 0)
+			if((any_side || mcount_by[opps[oi]] == 0)
+				&& (n_teams != n_duelists || !is_player_affected_by_effect(opps[oi], EFFECT_CANNOT_BE_DIRECT_ATTACKED)))
 				dmask |= 1u << opps[oi];
 	}
 	if((n_duelists == 2 ? (mcount == 0 || pcard->is_affected_by_effect(EFFECT_DIRECT_ATTACK) || core.attack_player) : dmask != 0)
@@ -3324,7 +3325,10 @@ bool field::confirm_attack_target() {
 	card_vector cv;
 	get_attack_target(core.attacker, &cv, core.chain_attack, false);
 	return (core.attack_target && std::find(cv.begin(), cv.end(), core.attack_target) != cv.end())
-		|| (!core.attack_target && core.attacker->direct_attackable);
+		|| (!core.attack_target && core.attacker->direct_attackable
+			&& (n_duelists == 2 || n_teams != n_duelists
+				|| (is_duelist(core.battle_defender)
+					&& (core.attacker->direct_attack_mask & (1u << core.battle_defender)))));
 }
 // update the validity for EFFECT_ATTACK_ALL (approximate solution)
 void field::attack_all_target_check() {
diff --git a/libduel.cpp b/libduel.cpp
index c549e15..25976df 100644
--- a/libduel.cpp
+++ b/libduel.cpp
@@ -1724,6 +1724,30 @@ LUA_STATIC_FUNCTION(ChangeAttackTarget) {
 	}
 	card_vector cv;
 	pduel->game_field->get_attack_target(attacker, &cv, pduel->game_field->core.chain_attack);
+	auto& attack_field = *pduel->game_field;
+	// Stock redirect-to-direct cards keep the live defender even with monsters.
+	// Only an eliminated defender permits a fallback to another opponent.
+	uint8_t direct_defender = attack_field.core.battle_defender;
+	if(!target && attack_field.n_duelists > 2 && attack_field.n_teams == attack_field.n_duelists) {
+		const auto legal_direct = [&](uint8_t q) {
+			return attack_field.is_alive(q) && !attack_field.same_team(attacker->current.controler, q)
+				&& !attack_field.is_player_affected_by_effect(q, EFFECT_CANNOT_BE_DIRECT_ATTACKED);
+		};
+		if(attack_field.is_alive(direct_defender)) {
+			if(!legal_direct(direct_defender)) {
+				lua_pushboolean(L, 0);
+				return 1;
+			}
+		} else {
+			direct_defender = DUELIST_NONE;
+			for(uint8_t q = 0; q < attack_field.n_duelists; ++q)
+				if(legal_direct(q)) { direct_defender = q; break; }
+		}
+		if(direct_defender == DUELIST_NONE) {
+			lua_pushboolean(L, 0);
+			return 1;
+		}
+	}
 	if(((target && std::find(cv.begin(), cv.end(), target) != cv.end()) || ignore) ||
 		(!target && !attacker->is_affected_by_effect(EFFECT_CANNOT_DIRECT_ATTACK))) {
 		pduel->game_field->core.attack_target = target;
@@ -1749,6 +1773,8 @@ LUA_STATIC_FUNCTION(ChangeAttackTarget) {
 			// attack) the defender stays if it is still a living opponent, else the first living opponent.
 			if(target) {
 				gf.core.battle_defender = target->current.controler;
+			} else if(gf.n_teams == gf.n_duelists) {
+				gf.core.battle_defender = direct_defender;
 			} else if(!(gf.is_alive(gf.core.battle_defender) && !gf.same_team(turnp, gf.core.battle_defender))) {
 				gf.core.battle_defender = DUELIST_NONE;
 				for(uint8_t i = 1; i < gf.n_duelists && gf.core.battle_defender == DUELIST_NONE; ++i) {
-- 
2.43.0

