+inline bool declares_opponent(lua_State* L, int index, int target_index=0, bool retain_incomplete=true, bool* uncertain=nullptr) {
+  if(uncertain) *uncertain=false;
+  if(lua_type(L,index)!=LUA_TFUNCTION || lua_iscfunction(L,index)) return false;
+  const auto* closure=static_cast<const LClosure*>(lua_topointer(L,index));
+  std::vector<const Proto*> active;
+  unsigned budget=8192;
+  // The source activation effect is an abstract object too. Its properties are unknown.
+  value source; source.type=kind::effect; source.object=0;
+  value target_player;
+  if(target_index && lua_type(L,target_index)==LUA_TFUNCTION && !lua_iscfunction(L,target_index)) {
+    std::vector<value> exits;
+    bool complete=true;
+    unsigned target_budget=8192;
+    const auto* target=static_cast<const LClosure*>(lua_topointer(L,target_index));
+    // Activation target parameters: e,tp,eg,ep,ev,re,r,rp,chk,chkc.
+    value nil; nil.type=kind::nil;
