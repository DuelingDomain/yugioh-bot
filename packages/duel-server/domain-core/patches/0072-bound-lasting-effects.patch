From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Release Check <release@localhost>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] A004 final route

---
--- /dev/null
+++ b/activated_lock.h
@@ -0,0 +1,469 @@
+#ifndef ACTIVATED_LOCK_H
+#define ACTIVATED_LOCK_H
+
+// Read-only abstract interpretation of the pinned Lua 5.3 operation closure.
+// The operation is never called. Branches keep separate effect provenance.
+#include <cstdint>
+#include <deque>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <memory>
+#include "lua.h"
+#include "lobject.h"
+#include "lstate.h"
+#include "lopcodes.h"
+#include "lfunc.h"
+#include "ltable.h"
+
+namespace activated_lock {
+// The core resolves these against its original C API function arrays. Lua
+// procedure-library wrappers retain those C functions as unnamed upvalues.
+const char* duel_native_role(lua_CFunction function);
+const char* effect_native_role(lua_CFunction function);
+const char* group_native_role(lua_CFunction function);
+enum class kind { unknown, nil, boolean, integer, string, table, function, native, method, effect, card, group };
+struct value {
+  kind type{kind::unknown};
+  lua_Integer number{0};
+  const TValue* raw{nullptr};
+  std::string name;
+  int object{-1};
+  const Proto* prototype{nullptr};
+  std::shared_ptr<std::vector<value>> upvalues;
+};
+struct effect_shape {
+  bool type_known{false};
+  lua_Integer type{0};
+  bool range_known{false};
+  lua_Integer self{0}, opponent{0};
+  bool code_known{false}, value_known{false};
+  lua_Integer code{0}, numeric_value{0};
+};
+struct state {
+  int pc{0};
+  bool explicit_binding{false};
+  value target_player;
+  std::vector<value> registers;
+  std::vector<effect_shape> effects;
+  std::vector<unsigned char> visits;
+};
+
+inline value integer(lua_Integer n) { value v; v.type=kind::integer; v.number=n; return v; }
+inline value boolean(bool b) { value v; v.type=kind::boolean; v.number=b; return v; }
+inline int truth(const value& v) {
+  if(v.type==kind::unknown) return -1;
+  return v.type==kind::nil || (v.type==kind::boolean && !v.number) ? 0 : 1;
+}
+inline value decode(const TValue* raw, const std::string& name={}) {
+  value v;
+  if(!raw) return v;
+  v.raw=raw;
+  v.name=name;
+  if(ttisnil(raw)) v.type=kind::nil;
+  else if(ttisboolean(raw)) { v.type=kind::boolean; v.number=bvalue(raw); }
+  else if(ttisinteger(raw)) { v.type=kind::integer; v.number=ivalue(raw); }
+  else if(ttisstring(raw)) { v.type=kind::string; v.name=svalue(raw); }
+  else if(ttistable(raw)) v.type=kind::table;
+  else if(ttisLclosure(raw)) v.type=kind::function;
+  else if(ttisfunction(raw)) {
+    v.type=kind::native;
+    const auto function=ttislcf(raw) ? fvalue(raw) : clCvalue(raw)->f;
+    const char* role=duel_native_role(function);
+    if(!role) role=effect_native_role(function);
+    if(!role) role=group_native_role(function);
+    v.name=role ? role : "";
+  }
+  return v;
+}
+inline value lookup(const value& table, const TValue* key) {
+  if(table.type!=kind::table || !table.raw || !key || !ttisstring(key)) return {};
+  const std::string name=svalue(key);
+  const std::string path=table.name.empty() ? name : table.name+"."+name;
+  return decode(luaH_get(hvalue(table.raw), key), path);
+}
+inline effect_shape* shape(state& s, const value& v) {
+  return v.type==kind::effect && v.object>=0 && static_cast<size_t>(v.object)<s.effects.size() ? &s.effects[v.object] : nullptr;
+}
+inline value create(state& s, const effect_shape& e={}) {
+  value v; v.type=kind::effect; v.object=static_cast<int>(s.effects.size()); s.effects.push_back(e); return v;
+}
+
+// Domain query wrappers retain the original native function as an upvalue.
+// Check that identity before treating the wrapper as the same query contract.
+inline bool captures_role(const LClosure* closure, const std::string& role, unsigned depth=0) {
+  if(!closure || depth>=4) return false;
+  for(int n=0;n<closure->nupvalues;++n) {
+    const auto v=decode(closure->upvals[n]->v);
+    if(v.type==kind::native && v.name==role) return true;
+    if(v.type==kind::function && captures_role(clLvalue(v.raw),role,depth+1)) return true;
+  }
+  return false;
+}
+// The pinned library adds property tracking and summon flags around this
+// API. Those wrappers do not change the registered effect's player/range.
+// Summarize only the known library closures with the original C API captured;
+// an arbitrary card wrapper must still be scanned for its own opponent actions.
+inline bool registration_wrapper(const value& fn) {
+  if(fn.type!=kind::function || !fn.raw || fn.name!="Duel.RegisterEffect") return false;
+  const auto* closure=clLvalue(fn.raw);
+  const auto* p=closure->p;
+  if(!p || !p->source || !captures_role(closure,"Duel.RegisterEffect")) return false;
+  const std::string source=getstr(p->source);
+  return (source=="proc_workaround.lua" &&
+          ((p->linedefined==146 && p->lastlinedefined==174)
+           || (p->linedefined==383 && p->lastlinedefined==389)))
+      || (source=="chain.lua" && p->linedefined==574 && p->lastlinedefined==580);
+}
+
+inline bool opponent_read(const value& fn,const std::vector<value>& args) {
+  if(fn.type!=kind::native && !(fn.type==kind::method && fn.name.rfind("Group.",0)==0)
+      && !(fn.type==kind::function && fn.raw && captures_role(clLvalue(fn.raw),fn.name))) return false;
+  auto opponent_arg=[&](size_t i) {
+    return i<args.size() && args[i].type==kind::integer && args[i].number==1;
+  };
+  // The player named by an action or a chooser is part of the declaration.
+  if(fn.name=="Duel.Damage" || fn.name=="Duel.Recover" || fn.name=="Duel.SetLP"
+      || fn.name=="Duel.DiscardHand" || fn.name=="Duel.DiscardDeck") return opponent_arg(0);
+  if(fn.name=="Duel.SendtoGrave") return opponent_arg(2);
+  if(fn.name=="Duel.Remove") return opponent_arg(3);
+  if(fn.name=="Duel.SendtoHand" || fn.name=="Duel.SendtoDeck") return opponent_arg(1);
+  if(fn.name=="Duel.SpecialSummon" || fn.name=="Duel.SpecialSummonStep")
+    return opponent_arg(2) || opponent_arg(3);
+  if(fn.name=="Group.RandomSelect" || fn.name=="Group.Select" || fn.name=="Group.FilterSelect"
+      || fn.name=="Group.SelectWithSumEqual" || fn.name=="Group.SelectWithSumGreater") return opponent_arg(1);
+  if(fn.name=="Group.SelectUnselect") return opponent_arg(2);
+  // ConfirmCards and Hint only give information. Their viewers are not recipients.
+  int player=-1, self=-1, opponent=-1;
+  if(fn.name=="Duel.GetFieldGroup" || fn.name=="Duel.GetFieldGroupCount"
+      || fn.name=="Duel.GetOverlayGroup" || fn.name=="Duel.GetOverlayCount") { player=0; self=1; opponent=2; }
+  else if(fn.name=="Duel.GetMatchingGroup" || fn.name=="Duel.GetMatchingGroupCount" || fn.name=="Duel.IsExistingMatchingCard" || fn.name=="Duel.GetTargetCount" || fn.name=="Duel.IsExistingTarget") { player=1; self=2; opponent=3; }
+  else if(fn.name=="Duel.SelectMatchingCard" || fn.name=="Duel.SelectTarget") { player=2; self=3; opponent=4; }
+  else if(fn.name=="Duel.SelectYesNo" || fn.name=="Duel.GetDecktopGroup" || fn.name=="Duel.GetDeckbottomGroup" || fn.name=="Duel.GetExtraTopGroup" || fn.name=="Duel.Draw" || fn.name=="Duel.GetLocationCount") {
+    return !args.empty() && args[0].type==kind::integer && args[0].number==1;
+  }
+  if(player<0 || static_cast<size_t>(opponent)>=args.size()
+     || args[player].type!=kind::integer || args[self].type!=kind::integer || args[opponent].type!=kind::integer) return false;
+  const auto side=args[player].number, own=args[self].number, other=args[opponent].number;
+  return (side==0 && (other & ~own)) || (side==1 && (own & ~other));
+}
+
+// Use a saved target player only when every complete exit proves the same seat.
+// Unknown values and incomplete paths must not invent an opponent declaration.
+inline value joined_player(const std::vector<value>& exits) {
+  if(exits.empty()) return {};
+  const auto first=exits.front();
+  if(first.type!=kind::integer || (first.number!=0 && first.number!=1)) return {};
+  for(const auto& v:exits)
+    if(v.type!=kind::integer || v.number!=first.number) return {};
+  return first;
+}
+
+inline bool scan(const LClosure* closure, const std::vector<value>& args,
+                 const std::vector<effect_shape>& inherited, std::vector<const Proto*>& active, unsigned& budget,
+                 const Proto* synthetic=nullptr, const std::vector<value>* captured=nullptr,
+                 std::vector<unsigned char>* writes=nullptr, bool* complete=nullptr, bool explicit_binding=false,
+                 const value* chain_target=nullptr, std::vector<value>* target_exits=nullptr,
+                 const value& initial_target={}) {
+  const Proto* p=synthetic ? synthetic : closure ? closure->p : nullptr;
+  if(!p || active.size()>=8 || std::find(active.begin(),active.end(),p)!=active.end()) {
+    if(complete) *complete=false;
+    return false;
+  }
+  active.push_back(p);
+  struct pop_guard { std::vector<const Proto*>& active; ~pop_guard(){ active.pop_back(); } } guard{active};
+  state initial;
+  initial.explicit_binding=explicit_binding;
+  initial.target_player=initial_target;
+  initial.registers.resize(std::max<size_t>(p->maxstacksize,256));
+  initial.effects=inherited;
+  initial.visits.resize(p->sizecode);
+  for(size_t i=0;i<args.size() && i<p->numparams;++i) initial.registers[i]=args[i];
+  std::deque<state> pending;
+  pending.push_back(std::move(initial));
+  while(!pending.empty() && budget && pending.size()<256) {
+    state s=std::move(pending.front()); pending.pop_front();
+    while(s.pc>=0 && s.pc<p->sizecode && budget) {
+      --budget;
+      if(s.visits[s.pc]++>=2) { if(complete) *complete=false; break; }
+      const Instruction ins=p->code[s.pc++];
+      const auto op=GET_OPCODE(ins);
+      const int a=GETARG_A(ins), b=GETARG_B(ins), c=GETARG_C(ins);
+      if(a>=256 || ((op==OP_MOVE || op==OP_GETTABLE || op==OP_SELF || op==OP_UNM || op==OP_BNOT || op==OP_TESTSET || op==OP_TEST) && b>=256)) { if(complete) *complete=false; return false; }
+      auto constant=[&](int k)->const TValue* { return k>=0 && k<p->sizek ? &p->k[k] : nullptr; };
+      auto rk=[&](int k)->value { return ISK(k) ? decode(constant(INDEXK(k))) : s.registers[k]; };
+      auto key=[&](int k)->const TValue* { return ISK(k) ? constant(INDEXK(k)) : s.registers[k].raw; };
+      auto up=[&](int k)->value {
+        if(captured) return k>=0 && static_cast<size_t>(k)<captured->size() ? (*captured)[k] : value{};
+        return closure && k>=0 && k<closure->nupvalues ? decode(closure->upvals[k]->v) : value{};
+      };
+      auto mark_write=[&](const value& object,unsigned char bits) {
+        if(writes && object.type==kind::effect && object.object>=0 && static_cast<size_t>(object.object)<writes->size())
+          (*writes)[object.object]|=bits;
+      };
+      switch(op) {
+      case OP_MOVE: s.registers[a]=s.registers[b]; break;
+      case OP_LOADK: s.registers[a]=decode(constant(GETARG_Bx(ins))); break;
+      case OP_LOADKX:
+        if(s.pc<p->sizecode) s.registers[a]=decode(constant(GETARG_Ax(p->code[s.pc++])));
+        break;
+      case OP_LOADBOOL: s.registers[a]=boolean(b); if(c) ++s.pc; break;
+      case OP_LOADNIL: if(a+b>=256) { if(complete) *complete=false; return false; } for(int n=a;n<=a+b;++n) { s.registers[n]={}; s.registers[n].type=kind::nil; } break;
+      case OP_GETUPVAL: s.registers[a]=up(b); break;
+      case OP_GETTABUP: s.registers[a]=lookup(up(b),key(c)); break;
+      case OP_GETTABLE: s.registers[a]=lookup(s.registers[b],key(c)); break;
+      case OP_SELF: {
+        if(a+1>=256 || b>=256) { if(complete) *complete=false; return false; }
+        const value receiver=s.registers[b]; s.registers[a+1]=receiver;
+        const TValue* k=key(c);
+        if((receiver.type==kind::effect || receiver.type==kind::card || receiver.type==kind::group) && k && ttisstring(k)) {
+          value v; v.type=kind::method; v.name=(receiver.type==kind::group ? "Group." : "")+std::string(svalue(k)); s.registers[a]=v;
+        } else s.registers[a]=lookup(receiver,k);
+        break;
+      }
+      case OP_ADD: case OP_SUB: case OP_BOR: case OP_BAND: case OP_BXOR: {
+        const value x=rk(b), y=rk(c);
+        if(x.type!=kind::integer || y.type!=kind::integer) { s.registers[a]={}; break; }
+        if(op==OP_ADD) s.registers[a]=integer(static_cast<lua_Integer>(static_cast<lua_Unsigned>(x.number)+static_cast<lua_Unsigned>(y.number)));
+        else if(op==OP_SUB) s.registers[a]=integer(static_cast<lua_Integer>(static_cast<lua_Unsigned>(x.number)-static_cast<lua_Unsigned>(y.number)));
+        else if(op==OP_BOR) s.registers[a]=integer(x.number|y.number);
+        else if(op==OP_BAND) s.registers[a]=integer(x.number&y.number);
+        else s.registers[a]=integer(x.number^y.number);
+        break;
+      }
+      case OP_UNM: case OP_BNOT: {
+        const value x=s.registers[b];
+        s.registers[a]=x.type==kind::integer ? integer(op==OP_UNM
+          ? static_cast<lua_Integer>(lua_Unsigned{0}-static_cast<lua_Unsigned>(x.number)) : ~x.number) : value{};
+        break;
+      }
+      case OP_JMP: s.pc+=GETARG_sBx(ins); break;
+      case OP_EQ: case OP_LT: case OP_LE: case OP_TEST: case OP_TESTSET: {
+        int result=-1;
+        if(op==OP_TEST || op==OP_TESTSET) result=truth(s.registers[op==OP_TEST ? a : b]);
+        else {
+          const value x=rk(b), y=rk(c);
+          if(x.type==kind::integer && y.type==kind::integer)
+            result=op==OP_EQ ? x.number==y.number : op==OP_LT ? x.number<y.number : x.number<=y.number;
+          else if(op==OP_EQ && x.type!=kind::unknown && y.type!=kind::unknown) {
+            if(x.type!=y.type) result=0;
+            else if(x.type==kind::nil) result=1;
+            else if(x.type==kind::boolean) result=x.number==y.number;
+            else if(x.type==kind::string) result=x.name==y.name;
+          }
+        }
+        if(result>=0) {
+          if(result!=(op==OP_TEST || op==OP_TESTSET ? c : a)) ++s.pc;
+          else if(op==OP_TESTSET) s.registers[a]=s.registers[b];
+          break;
+        }
+        // The two paths cannot contribute setters to the same abstract effect.
+        state skipped=s; ++skipped.pc; pending.push_back(std::move(skipped));
+        if(op==OP_TESTSET) s.registers[a]=s.registers[b];
+        break;
+      }
+      case OP_CALL: case OP_TAILCALL: {
+        if((b && a+b>256) || (c && a+c-1>256)) { if(complete) *complete=false; return false; }
+        value fn=s.registers[a];
+        if(registration_wrapper(fn)) fn.type=kind::native;
+        std::vector<value> callargs;
+        const int argc=b ? b-1 : static_cast<int>(s.registers.size())-a-1;
+        for(int n=0;n<argc;++n) callargs.push_back(s.registers[a+1+n]);
+        // Explicit seat loops/windows and a causal turn-player read already
+        // establish their scope. They must not add a free activation choice.
+        if(fn.type==kind::native) {
+          if(fn.name=="Duel.MPWindow" || fn.name=="Duel.MPNthDuelist")
+            s.explicit_binding=!callargs.empty() && (callargs[0].type!=kind::integer || callargs[0].number!=0);
+          else if(fn.name=="Duel.MPWindowEnd") s.explicit_binding=false;
+          else if(fn.name=="Duel.MPBindSeat") s.explicit_binding=!callargs.empty();
+          // A turn-player read does not suppress an independent later read.
+        }
+        if(!target_exits && !s.explicit_binding && opponent_read(fn,callargs)) return true;
+        value result;
+        // Only these native calls preserve a proven saved target player.
+        // In particular, pcall/xpcall and query filters can invoke Lua setters.
+        if(target_exits && fn.type==kind::native
+            && fn.name!="Duel.SetTargetPlayer" && fn.name!="Duel.SetTargetParam"
+            && fn.name!="Duel.SetTargetCard" && fn.name!="Duel.SetOperationInfo"
+            && fn.name!="Duel.SetPossibleOperationInfo" && fn.name!="Duel.GetChainInfo"
+            && fn.name!="Duel.GetFieldGroup" && fn.name!="Duel.GetFieldGroupCount"
+            && fn.name!="Duel.GetLocationCount" && fn.name!="Duel.MPMode"
+            && fn.name!="Duel.MPWindow" && fn.name!="Duel.MPWindowEnd"
+            && fn.name!="Duel.MPNthDuelist" && fn.name!="Duel.MPBindSeat"
+            && fn.name!="Duel.RegisterEffect" && fn.name!="Effect.CreateEffect"
+            && fn.name!="Effect.GlobalEffect") s.target_player={};
+        if(target_exits && fn.type==kind::native && fn.name=="Duel.SetTargetPlayer")
+          s.target_player=callargs.empty() ? value{} : callargs[0];
+        auto forget_effects=[&](const auto& forget,const value& v,unsigned depth)->void {
+          if(depth>=8) return;
+          if(auto* e=shape(s,v)) {
+            mark_write(v,15);
+            e->type_known=e->range_known=e->code_known=e->value_known=false;
+          }
+          if(v.upvalues) for(const auto& captured_value:*v.upvalues) forget(forget,captured_value,depth+1);
+        };
+        if(fn.type==kind::function && (fn.raw || fn.prototype)) {
+          // A large unrelated helper must leave room to inspect the caller's
+          // later registration. The shared total still bounds every branch.
+          unsigned helper_budget=budget/2;
+          const unsigned allowance=helper_budget;
+          std::vector<unsigned char> helper_writes(s.effects.size());
+          bool helper_complete=true;
+          std::vector<value> helper_exits;
+          const bool found=scan(fn.raw ? clLvalue(fn.raw) : nullptr,callargs,s.effects,active,helper_budget,fn.prototype,fn.upvalues.get(),&helper_writes,&helper_complete,s.explicit_binding,chain_target,target_exits ? &helper_exits : nullptr,s.target_player);
+          if(target_exits) s.target_player=helper_complete ? joined_player(helper_exits) : value{};
+          budget-=allowance-helper_budget;
+          if(found) return true;
+          if(!helper_complete) {
+            if(complete) *complete=false;
+            for(const auto& arg:callargs) forget_effects(forget_effects,arg,0);
+            forget_effects(forget_effects,fn,0);
+          }
+          // A helper can overwrite a passed or captured effect's shape. Until
+          // its exit states are joined, those writes cannot retain stale facts.
+          for(size_t n=0;n<helper_writes.size();++n) {
+            const auto bits=helper_writes[n];
+            if(bits&1) s.effects[n].type_known=false;
+            if(bits&2) s.effects[n].range_known=false;
+            if(bits&4) s.effects[n].code_known=false;
+            if(bits&8) s.effects[n].value_known=false;
+            if(writes && n<writes->size()) (*writes)[n]|=bits;
+          }
+          // Helpers that return a constructed effect are deliberately unknown.
+        } else if(fn.type==kind::native && fn.name.rfind("Duel.",0)==0 && fn.name!="Duel.RegisterEffect") {
+          // An opponent-only operation read needs its declaration at activation.
+          // The FFA Lua player parameter is abstract own=0, opponent=1.
+          if(fn.name=="Duel.MPMode") result=integer(1);
+        } else if(fn.type==kind::native && (fn.name=="Effect.CreateEffect" || fn.name=="Effect.GlobalEffect")) {
+          result=create(s);
+        } else if(fn.type==kind::native && fn.name=="Duel.RegisterEffect" && !callargs.empty()) {
+          if(const auto* e=shape(s,callargs[0]); e && e->type_known && e->range_known
+              && (e->type & 2) && !target_exits
+              && ((e->opponent & ~e->self)
+                  || (callargs.size()>1 && callargs[1].type==kind::integer && callargs[1].number==1
+                      && (e->self & ~e->opponent)))) return true; // FIELD registration on a proven opponent
+        } else if(fn.type==kind::method && fn.name=="RegisterEffect" && callargs.size()>1) {
+          if(const auto* e=shape(s,callargs[1]); e && e->type_known && e->range_known
+              && (e->type & 2) && (e->opponent & ~e->self) && !target_exits) return true;
+        } else if(fn.type==kind::method && fn.name=="GetHandler") {
+          result.type=kind::card;
+        } else if(fn.type==kind::method && !callargs.empty()) {
+          auto* e=shape(s,callargs[0]);
+          if(e && fn.name=="SetType") {
+            mark_write(callargs[0],1);
+            e->type_known=callargs.size()>1 && callargs[1].type==kind::integer;
+            if(e->type_known) e->type=callargs[1].number;
+          } else if(e && fn.name=="SetTargetRange") {
+            mark_write(callargs[0],2);
+            e->range_known=callargs.size()>2 && callargs[1].type==kind::integer && callargs[2].type==kind::integer;
+            if(e->range_known) { e->self=callargs[1].number; e->opponent=callargs[2].number; }
+          } else if(e && fn.name=="SetAbsoluteRange") { mark_write(callargs[0],2); e->range_known=false; }
+          else if(e && fn.name=="Clone") { const auto copy=*e; result=create(s,copy); }
+          else if(e && fn.name=="SetCode") {
+            mark_write(callargs[0],4);
+            e->code_known=callargs.size()>1 && callargs[1].type==kind::integer;
+            if(e->code_known) e->code=callargs[1].number;
+          } else if(e && fn.name=="GetCode" && e->code_known) result=integer(e->code);
+          else if(e && fn.name=="SetValue") {
+            mark_write(callargs[0],8);
+            e->value_known=callargs.size()>1 && callargs[1].type==kind::integer;
+            if(e->value_known) e->numeric_value=callargs[1].number;
+          } else if(e && fn.name=="GetValue" && e->value_known) result=integer(e->numeric_value);
+        } else if(fn.type==kind::native || fn.type==kind::unknown) {
+          if(target_exits && fn.type==kind::unknown) s.target_player={};
+          // An unmodelled native setter/consumer may change an effect passed
+          // to it. Do not retain shape facts merely because it has no Lua body.
+          for(const auto& arg:callargs) forget_effects(forget_effects,arg,0);
+        }
+        // A known Group receiver keeps the identity of its chooser methods.
+        if(fn.name=="Group.CreateGroup" || fn.name=="Group.FromCards" || fn.name=="Group.Clone"
