+// More than 2 duelists only (ADR-0002). The first living duelist clockwise from p who is not on p's team, or p
+// when there is none or when p is not a duelist in play. The "other side" of a rule that the stock core writes
+// as "the opponent" and that takes exactly one duelist.
+static uint8_t first_living_opponent(const field& f, uint8_t p) {
+	if(!f.is_alive(p))
+		return p;
+	for(uint8_t q = f.next_in_turn_order(p); q != p; q = f.next_in_turn_order(q)) {
+		if(!f.same_team(p, q))
+			return q;
+	}
+	return p;
+}
+// More than 2 duelists only. A summon procedure with EFFECT_FLAG_SPSUM_PARAM and o_range puts the monster on "the
+// opponent's field". With several opponents it goes to the first living opponent in turn order for whom works(q)
+// is true (the same order as card::check_summon_procedure). If none works, the first living opponent.
+template<typename F>
+static uint8_t first_summon_opponent(const field& f, uint8_t p, F&& works) {
+	const uint8_t first = first_living_opponent(f, p);
+	if(first == p)
+		return p;
+	for(uint8_t q = first; q != p; q = f.next_in_turn_order(q)) {
+		if(!f.same_team(p, q) && works(q))
+			return q;
+	}
+	return first;
+}
