index 58c00a6..440ce98 100644
--- a/libcard.cpp
+++ b/libcard.cpp
@@ -2113,6 +2113,11 @@ LUA_FUNCTION(CheckUniqueOnField) {
 	auto check_player = lua_get<uint8_t>(L, 2);
 	auto check_location = lua_get<uint8_t, LOCATION_ONFIELD>(L, 3) & LOCATION_ONFIELD;
 	auto icard = lua_get<card*>(L, 4);
+	if(pduel->game_field->n_duelists > 2 && !pduel->game_field->is_duelist(check_player)) {
+		// not a seat: no card of that field can conflict
+		lua_pushboolean(L, 1);
+		return 1;
+	}
 	lua_pushboolean(L, pduel->game_field->check_unique_onfield(self, check_player, check_location, icard) ? 0 : 1);
 	return 1;
 }
