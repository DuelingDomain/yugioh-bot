+// n_duelists > 2: hands every group of cards to the duelist that must control it, in turn order from the
+// turn player (the order that the two calls of the two-duelist code have). A target that is not a living
+// duelist sends the card to the Graveyard by rule.
+static void give_control_groups(field& f, card_set (&by_target)[MAX_DUELISTS], card_set& lost) {
+	uint8_t q = f.is_alive(f.infos.turn_player) ? f.infos.turn_player : f.next_in_turn_order(f.infos.turn_player);
+	uint8_t living = 0;
+	for(uint8_t p = 0; p < f.n_duelists; ++p)
+		living += f.is_alive(p) ? 1 : 0;
+	for(uint8_t i = 0; i < living; ++i) {
+		if(by_target[q].size())
+			f.get_control(std::move(by_target[q]), nullptr, PLAYER_NONE, q, 0, 0, 0xff);
+		q = f.next_in_turn_order(q);
+	}
+	if(lost.size())
+		f.send_to(std::move(lost), nullptr, REASON_RULE, PLAYER_NONE, PLAYER_NONE, LOCATION_GRAVE, 0, POS_FACEUP);
+}
