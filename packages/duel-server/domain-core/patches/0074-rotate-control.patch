+// Duel.MPRotateControl(g): one monster per living FFA seat, each goes to the next seat in turn order.
+// The group carries real controllers. No folded opponent or implicit opponent window is used.
+LUA_STATIC_FUNCTION(MPRotateControl) {
+	check_action_permission(L);
+	check_param_count(L, 1);
+	auto& field = *pduel->game_field;
+	if(field.n_duelists <= 2 || field.n_teams != field.n_duelists) {
+		lua_pushboolean(L, FALSE);
+		return 1;
+	}
+	auto* pgroup = lua_get<group*, true>(L, 1);
+	auto targets = pduel->new_group(pgroup->container);
+	targets->is_readonly = true;
+	field.emplace_process<Processors::RotateControl>(field.core.reason_effect, field.core.reason_player, targets);
+	return yieldk({
+		lua_pushboolean(L, pduel->game_field->returns.at<int32_t>(0));
+		return 1;
+	});
+}
