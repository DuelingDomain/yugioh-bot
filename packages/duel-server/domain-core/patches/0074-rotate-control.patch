+// A rotation is one atomic control change. All choices precede the move; a full field can use its outgoing zone.
+bool field::process(Processors::RotateControl& arg) {
+	auto valid = [&]() {
+		if(n_duelists <= 2 || n_teams != n_duelists)
+			return false;
+		uint8_t living = 0;
+		for(uint8_t p = 0; p < n_duelists; ++p)
+			if(is_alive(p)) ++living;
+		if(living < 2 || arg.targets->container.size() != living)
+			return false;
+		bool seen[MAX_DUELISTS]{};
+		for(auto* pcard : arg.targets->container) {
+			const auto p = pcard->current.controler;
+			if(!is_alive(p) || seen[p]
+				|| pcard->current.location != LOCATION_MZONE || pcard->overlay_target
+				|| !pcard->is_capable_change_control()
+				|| (arg.reason_effect && !pcard->is_affect_by_effect(arg.reason_effect)))
+				return false;
+			seen[p] = true;
+		}
+		return true;
+	};
+	switch(arg.step) {
+	case 0: {
+		arg.step = 9;
+		if(!valid()) return FALSE;
+		for(uint8_t j = 0; j < n_duelists; ++j) {
+			const auto p = static_cast<uint8_t>((infos.turn_player + j) % n_duelists);
+			if(!is_alive(p)) continue;
+			arg.seats.push_back(p);
+			for(auto* pcard : arg.targets->container)
+				if(pcard->current.controler == p) {
+					arg.cards.push_back(pcard);
+					arg.old_sequences.push_back(pcard->current.sequence);
+				}
+		}
+		for(size_t i = 0; i < arg.cards.size(); ++i) {
+			const auto p = arg.seats[i];
+			auto* outgoing = arg.cards[i];
+			auto* incoming = arg.cards[(i + arg.cards.size() - 1) % arg.cards.size()];
+			const auto seq = outgoing->current.sequence;
+			// Ask the stock zone/count checks with the outgoing slot available. Restore before any prompt.
+			player[p].list_mzone[seq] = nullptr;
+			player[p].used_location &= ~(1u << seq);
+			uint32_t flag;
+			const auto count = get_useable_count(incoming, p, LOCATION_MZONE, arg.reason_player, LOCATION_REASON::CONTROL, 0x1f, &flag);
+			player[p].list_mzone[seq] = outgoing;
+			player[p].used_location |= 1u << seq;
+			if(count <= 0 || !(~flag & 0x1f)) return FALSE;
+			if(!is_flag(DUEL_TRAP_MONSTERS_NOT_USE_ZONE) && (incoming->get_type() & TYPE_TRAPMONSTER)
+				&& get_useable_count(incoming, p, LOCATION_SZONE, p, LOCATION_REASON::CONTROL) <= 0)
+				return FALSE;
+			arg.zone_masks.push_back(flag | ~0x1fu);
+		}
+		arg.step = 0;
+		return FALSE;
+	}
+	case 1: {
+		const auto i = arg.cursor;
+		auto message = pduel->new_message(MSG_HINT);
+		message->write<uint8_t>(HINT_SELECTMSG);
+		message->write<uint8_t>(arg.seats[i]);
+		message->write<uint64_t>(arg.cards[(i + arg.cards.size() - 1) % arg.cards.size()]->data.code);
+		emplace_process<Processors::SelectPlace>(arg.seats[i], arg.zone_masks[i], 1);
+		return FALSE;
+	}
+	case 2: {
+		arg.new_sequences.push_back(returns.at<int8_t>(2));
+		if(++arg.cursor < arg.cards.size()) arg.step = 0;
+		return FALSE;
+	}
+	case 3: {
+		if(!valid()) { arg.step = 9; return FALSE; }
+		for(size_t i = 0; i < arg.cards.size(); ++i)
+			if(arg.cards[i]->current.controler != arg.seats[i] || arg.cards[i]->current.sequence != arg.old_sequences[i]) {
+				arg.step = 9; return FALSE;
+			}
+		// Queue the old targets of a moving disable aura before its controller changes.
+		for(auto* pcard : arg.cards)
+			pcard->filter_disable_related_cards();
+		std::vector<loc_info> old_locations;
+		for(auto* pcard : arg.cards) {
+			old_locations.push_back(pcard->get_info_location());
+			if(pcard->unique_code && (pcard->unique_location & LOCATION_MZONE)) remove_unique_card(pcard);
+			player[pcard->current.controler].list_mzone[pcard->current.sequence] = nullptr;
+			player[pcard->current.controler].used_location &= ~(1u << pcard->current.sequence);
+		}
+		for(size_t i = 0; i < arg.cards.size(); ++i) {
+			auto* pcard = arg.cards[i];
+			const auto next = (i + 1) % arg.cards.size();
+			pcard->previous = pcard->current;
+			pcard->current.controler = arg.seats[next];
+			pcard->current.sequence = arg.new_sequences[next];
+			pcard->fieldid = infos.field_id++;
+			player[pcard->current.controler].list_mzone[pcard->current.sequence] = pcard;
+			player[pcard->current.controler].used_location |= 1u << pcard->current.sequence;
+			pcard->reset(RESET_CONTROL, RESET_EVENT);
+			set_control(pcard, pcard->current.controler, 0, 0);
+			pcard->set_status(STATUS_ATTACK_CANCELED, TRUE);
+			auto message = pduel->new_message(MSG_MOVE);
+			message->write<uint32_t>(pcard->data.code);
+			message->write(old_locations[i]);
+			message->write(pcard->get_info_location());
+			message->write<uint32_t>(0);
+		}
+		// As in SwapControl, retain field effect registration and Special Summon counters.
+		for(auto* pcard : arg.cards) {
+			add_to_disable_check_list(pcard);
+			pcard->filter_disable_related_cards();
+		}
+		// Refresh old and new aura targets before checking control-change responses.
+		adjust_instant();
+		// As in GetControl, restore unique registration after the instant adjustment.
+		for(auto* pcard : arg.cards) {
+			if(pcard->unique_code && (pcard->unique_location & LOCATION_MZONE)) add_unique_card(pcard);
+			raise_single_event(pcard, nullptr, EVENT_CONTROL_CHANGED, arg.reason_effect, REASON_EFFECT, arg.reason_player, pcard->current.controler, 0);
+			raise_single_event(pcard, nullptr, EVENT_MOVE, arg.reason_effect, REASON_EFFECT, arg.reason_player, pcard->current.controler, 0);
+		}
+		raise_event(arg.targets->container, EVENT_CONTROL_CHANGED, arg.reason_effect, REASON_EFFECT, arg.reason_player, 0, 0);
+		raise_event(arg.targets->container, EVENT_MOVE, arg.reason_effect, REASON_EFFECT, arg.reason_player, 0, 0);
+		process_single_event();
+		process_instant_event();
+		return FALSE;
+	}
+	case 4:
+		core.operated_set = arg.targets->container;
+		returns.set<int32_t>(0, 1);
+		return TRUE;
+	case 10:
+		core.operated_set.clear();
+		returns.set<int32_t>(0, 0);
+		return TRUE;
+	}
+	return TRUE;
+}
 bool field::process(Processors::ControlAdjust& arg) {
 	switch(arg.step) {
 	case 0: {
