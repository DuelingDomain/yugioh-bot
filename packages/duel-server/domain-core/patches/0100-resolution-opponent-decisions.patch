From 6773dc9c4b2dbab1729ba8c6e8472fd8569e7c8f Mon Sep 17 00:00:00 2001
From: yugidraft <yugidraft@localhost>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Recognize resolution-only opponent choice helper

Summarize the reviewed mp-utility.lua chooser without executing it. Its guarded callers bind a living opponent during resolution, so their later chooser/resource reads must not add a free activation declaration. Keep arbitrary wrappers and existing resource/target declarations on the normal analyzer path.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 activated_lock.h | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/activated_lock.h b/activated_lock.h
index 1c7ea47..5908ba0 100644
--- a/activated_lock.h
+++ b/activated_lock.h
@@ -116,6 +116,17 @@ inline bool registration_wrapper(const value& fn) {
       || (source=="chain.lua" && p->linedefined==574 && p->lastlinedefined==580);
 }
 
+// The reviewed multiplayer helper chooses and binds a living decision maker
+// during resolution. Summarize this exact library closure, preserving its
+// unknown success result, so its callers do not declare a chooser at activation.
+// Arbitrary card wrappers must still be scanned for opponent resources/actions.
+inline bool resolution_opponent_picker(const value& fn) {
+  if(fn.type!=kind::function || !fn.raw || fn.name!="aux.MPChooseOpponent") return false;
+  const auto* p=clLvalue(fn.raw)->p;
+  return p && p->source && std::string(getstr(p->source))=="mp-utility.lua"
+      && p->linedefined==212 && p->lastlinedefined==229;
+}
+
 inline bool opponent_read(const value& fn,const std::vector<value>& args) {
   if(fn.type!=kind::native && !(fn.type==kind::method && fn.name.rfind("Group.",0)==0)
       && !(fn.type==kind::function && fn.raw && captures_role(clLvalue(fn.raw),fn.name))) return false;
@@ -265,6 +276,10 @@ inline bool scan(const LClosure* closure, const std::vector<value>& args,
       case OP_CALL: case OP_TAILCALL: {
         if((b && a+b>256) || (c && a+c-1>256)) { if(complete) *complete=false; return false; }
         value fn=s.registers[a];
+        if(resolution_opponent_picker(fn)) {
+          fn.type=kind::native;
+          s.explicit_binding=true;
+        }
         if(registration_wrapper(fn)) fn.type=kind::native;
         std::vector<value> callargs;
         const int argc=b ? b-1 : static_cast<int>(s.registers.size())-a-1;
@@ -290,6 +305,7 @@ inline bool scan(const LClosure* closure, const std::vector<value>& args,
             && fn.name!="Duel.GetLocationCount" && fn.name!="Duel.MPMode"
             && fn.name!="Duel.MPWindow" && fn.name!="Duel.MPWindowEnd"
             && fn.name!="Duel.MPNthDuelist" && fn.name!="Duel.MPBindSeat"
+            && fn.name!="aux.MPChooseOpponent"
             && fn.name!="Duel.RegisterEffect" && fn.name!="Effect.CreateEffect"
             && fn.name!="Effect.GlobalEffect") s.target_player={};
         if(target_exits && fn.type==kind::native && fn.name=="Duel.SetTargetPlayer")
