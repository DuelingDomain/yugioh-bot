 		auto code = lua_get<uint32_t>(L, 2);
 		card_data dat = pduel->read_card(code);
 		dat.code = code;
@@ -5059,6 +5072,20 @@ LUA_STATIC_FUNCTION(MPSeatOf) {
 	lua_pushinteger(L, (f.n_duelists <= 2 || f.is_duelist(c)) ? c : -1);
 	return 1;
 }
+// Duel.MPActionSeat([real_seat]): the optional argument is a REAL seat, never folded tp.
+// In a card effect use no argument for the original actor. No argument keeps the original
+// scope player after a Tag rebind. This call does not change the recipient or scope.
+// With two duelists the returned player value follows the stock path.
+LUA_STATIC_FUNCTION(MPActionSeat) {
+	const auto& f = *pduel->game_field;
+	const auto* scope = fold::active(pduel);
+	const auto seat = lua_isnoneornil(L, 1)
+		? static_cast<int64_t>(scope ? (scope->rb.active ? scope->rb.P0 : scope->P) : f.core.reason_player)
+		: lua_get<int64_t>(L, 1);
+	const bool valid = seat >= 0 && seat < f.n_duelists;
+	lua_pushinteger(L, valid ? (scope ? 0x80 + seat : seat) : (scope ? PLAYER_NONE : f.none_id()));
+	return 1;
+}
 // Duel.MPOwnerSeat(c): the real owner seat, even when the card is controlled by another duelist.
 // At n == 2 this gives the same owner value as the stock GetOwner call.
 LUA_STATIC_FUNCTION(MPOwnerSeat) {
