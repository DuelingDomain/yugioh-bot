 	uint8_t viewers[MAX_DUELISTS];
-	const auto viewer_count = fold::field_list(pduel, lua_get<uint8_t>(L, 1), viewers, "ConfirmCards");
+	const auto value = lua_get<uint8_t>(L, 1);
+	uint8_t viewer_count = 0;
+	if(fold::active(pduel) && value >= 0x80 && value < 0x80 + MAX_DUELISTS) {
+		const auto viewer = fold::unfold_action(pduel, value, "ConfirmCards");
