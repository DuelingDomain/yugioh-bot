+			viewer_count = 1;
+		}
+	} else
+		viewer_count = fold::field_list(pduel, value, viewers, "ConfirmCards");
 	if(viewer_count == 0)
 		return 0;
 	const uint8_t playerid = viewers[0];
@@ -3542,7 +3551,11 @@ LUA_STATIC_FUNCTION(Hint) {
 			for(uint8_t seat=0;seat<gf.n_duelists;++seat)
 				if(!gf.same_team(actor,seat)) send(seat);
 		};
-		if(htype==HINT_OPSELECTED) {
+		if(scope && value>=0x80 && value<0x80+MAX_DUELISTS) {
+			const auto actor=fold::unfold_action(pduel,value,"Hint");
+			if(htype==HINT_OPSELECTED) opponents(actor);
+			else send(actor);
+		} else if(htype==HINT_OPSELECTED) {
 			// In a card effect, its controller selected the operation. Outside a
 			// scope the argument is the real caller seat, as in the existing API.
 			opponents(scope ? scope->P : value);
@@ -4285,7 +4298,7 @@ LUA_STATIC_FUNCTION(CanPlayerSetSpellTrap) {
 }
 LUA_STATIC_FUNCTION(IsPlayerCanSpecialSummon) {
 	check_param_count(L, 1);
-	return fold::can_any(L, pduel, lua_get<uint8_t>(L, 1), "IsPlayerCanSpecialSummon", [&](uint8_t playerid) -> bool {
+	return fold::can_actor(L, pduel, lua_get<uint8_t>(L, 1), "IsPlayerCanSpecialSummon", [&](uint8_t playerid) -> bool {
 		if(lua_gettop(L) == 1)
 			return pduel->game_field->is_player_can_spsummon(playerid);
 		check_param_count(L, 5);
@@ -4311,7 +4324,7 @@ LUA_STATIC_FUNCTION(IsPlayerCanFlipSummon) {
