From: Duelists Kingdom Engine <engine@duelistskingdom.com>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Preserve the action seat independently of the recipient

---
 fold.h      |  5 +++++
 fold_lib.h  | 12 ++++++++++++
 libduel.cpp | 35 +++++++++++++++++++++++++++++++----
 3 files changed, 48 insertions(+), 4 deletions(-)

diff --git a/fold.h b/fold.h
index 6c13237..1c00bea 100644
--- a/fold.h
+++ b/fold.h
@@ -68,6 +68,11 @@ inline uint8_t unfold_action(duel* pduel, uint8_t v, const char* fn, bool team_l
 	if(!s)
 		return v;
 	const auto& f = *pduel->game_field;
+	// An explicit action seat names an actor without changing the bound recipient.
+	if(v >= 0x80 && v < 0x80 + MAX_DUELISTS) {
+		const uint8_t seat = v - 0x80;
+		return f.is_alive(seat) ? seat : INVALID;
+	}
 	if(v == PLAYER_NONE)
 		return f.none_id();
 	if(v == PLAYER_ALL)
diff --git a/fold_lib.h b/fold_lib.h
index f949ffc..08e5397 100644
--- a/fold_lib.h
+++ b/fold_lib.h
@@ -209,6 +209,18 @@ inline int32_t can_any(lua_State* L, duel* pduel, uint8_t v, const char* fn, F&&
 	return 1;
 }
 
+// A summon permission check can name the exact actor while its recipient stays bound.
+// Ordinary query values keep the existing query path, including two-player behavior.
+template<typename F>
+inline int32_t can_actor(lua_State* L, duel* pduel, uint8_t v, const char* fn, F&& pred) {
+	if(active(pduel) && v >= 0x80 && v < 0x80 + MAX_DUELISTS) {
+		const auto actor = unfold_action(pduel, v, fn);
+		lua_pushboolean(L, actor != INVALID && pred(actor));
+		return 1;
+	}
+	return can_any(L, pduel, v, fn, std::forward<F>(pred));
+}
+
 } // namespace fold
 
 #endif /* FOLD_LIB_H_ */
