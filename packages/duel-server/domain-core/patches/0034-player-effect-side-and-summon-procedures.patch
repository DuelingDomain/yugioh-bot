+// More than 2 duelists only: the living opponents of playerid (another team), clockwise after playerid.
+// A summon procedure with EFFECT_FLAG_SPSUM_PARAM and o_range puts the monster on "the opponent's
+// field". With several opponents it passes when it works for one of them: the first one in this order.
+static uint8_t opponents_in_turn_order(const field& gf, uint8_t playerid, uint8_t (&out)[MAX_DUELISTS]) {
+	uint8_t count = 0;
+	if(!gf.is_alive(playerid))
+		return count;
+	for(uint8_t q = gf.next_in_turn_order(playerid); q != playerid; q = gf.next_in_turn_order(q)) {
+		if(!gf.same_team(playerid, q))
+			out[count++] = q;
+	}
+	return count;
+}
