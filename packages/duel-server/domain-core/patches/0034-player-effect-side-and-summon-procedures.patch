+			if(pduel->game_field->n_duelists == 2)
+				toplayer = pduel->game_field->opponent_of(playerid);
+			else {
+				auto& gf = *pduel->game_field;
+				uint8_t opps[MAX_DUELISTS]{};
+				const uint8_t n_opps = opponents_in_turn_order(gf, playerid, opps);
+				toplayer = gf.none_id();
+				for(uint8_t i = 0; i < n_opps && toplayer == gf.none_id(); ++i) {
