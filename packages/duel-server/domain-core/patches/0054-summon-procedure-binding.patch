@@ -44,6 +44,17 @@ static uint8_t first_summon_opponent(const field& f, uint8_t p, F&& works) {
 	return first;
 }
 
+// More than 2 duelists only. True when a summon procedure with an opponent field is bound to a seat that is out of
+// the duel by now, or that has a pending loss (Debug.EliminateDuelist: the loss is applied at the next check, and a seat
+// with it is as good as gone). The summon then does not happen and the card stays where it is. The caller runs
+// adjust_all() so that a pending loss lands now.
+static bool proc_bound_gone(const field& f, interpreter& lua, effect* proc) {
+	if(f.n_duelists <= 2 || !proc)
+		return false;
+	const uint8_t bound = lua.proc_opponent(proc);
+	return bound != DUELIST_NONE && (!f.is_alive(bound) || f.player[bound].pending_loss);
+}
