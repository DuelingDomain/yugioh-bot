diff --git a/libduel.cpp b/libduel.cpp
index c2f80ea..164b3e9 100644
--- a/libduel.cpp
+++ b/libduel.cpp
@@ -3553,6 +3553,22 @@ LUA_STATIC_FUNCTION(SelectPosition) {
 		return 1;
 	});
 }
+// n_duelists > 2: the one opponent whose zones a place prompt of `seat` offers (the high half of the mask).
+// The bound opponent of the link when seat is the scope duelist, else the next living opponent in turn order
+// (a kind (a) record when the scope duelist falls back). DUELIST_NONE when nobody else lives.
+static uint8_t f8_place_target(duel* pduel, uint8_t seat, const char* fn) {
+	const auto& f = *pduel->game_field;
+	if(const auto* s = fold::active(pduel); s && s->P == seat) {
+		const uint8_t bound = pduel->lua->scope_bound_opp();
+		if(f.is_alive(bound) && !f.same_team(seat, bound))
+			return bound;
+		const uint8_t next = fold::next_opponent(f, seat);
+		if(next != DUELIST_NONE)
+			pduel->lua->fold_trap('a', fn);
+		return next;
+	}
+	return fold::next_opponent(f, seat);
+}
 LUA_STATIC_FUNCTION(SelectDisableField) {
 	check_action_permission(L);
 	check_param_count(L, 5);
@@ -3572,8 +3588,17 @@ LUA_STATIC_FUNCTION(SelectDisableField) {
 	filter |= lua_get<uint32_t>(L, 5, filter);
 	uint32_t ct1 = 0, ct2 = 0, ct3 = 0, ct4 = 0, plist = 0, flag = 0xffffffff;
 	// The high half of the mask is the zones of one opponent. With more than two duelists it is the next living
-	// duelist in turn order (the one the field-disabled code binds), and it is skipped when nobody else lives.
-	const uint8_t oppid = pduel->game_field->n_duelists == 2 ? pduel->game_field->opponent_of(playerid) : pduel->game_field->next_in_turn_order(playerid);
+	// duelist in turn order: the seat that the EFFECT_DISABLE_FIELD code (add_disabled_zones_n) binds the high half
+	// to, so the zones that are offered are the zones that get disabled. It is skipped when nobody else lives or
+	// that seat is on the same team. (SelectFieldZone is different: its result is read back with 1-tp, so it uses
+	// the bound opponent.)
+	uint8_t target = DUELIST_NONE;
+	if(pduel->game_field->n_duelists > 2) {
+		const uint8_t next = pduel->game_field->next_in_turn_order(playerid);
+		if(next != playerid && !pduel->game_field->same_team(playerid, next))
+			target = next;
+	}
+	const uint8_t oppid = pduel->game_field->n_duelists == 2 ? pduel->game_field->opponent_of(playerid) : target;
 	if(location1 & LOCATION_MZONE) {
 		ct1 = pduel->game_field->get_useable_count(nullptr, playerid, LOCATION_MZONE, pduel->game_field->none_id(), LOCATION_REASON::NONE, 0xff, &plist);
 		if (all_field) {
@@ -3608,7 +3633,7 @@ LUA_STATIC_FUNCTION(SelectDisableField) {
 		}
 		flag = (flag & 0xffff00ff) | (plist << 8);
 	}
-	if((location2 & LOCATION_MZONE) && oppid != playerid) {
+	if((location2 & LOCATION_MZONE) && oppid != playerid && pduel->game_field->is_duelist(oppid)) {
 		ct3 = pduel->game_field->get_useable_count(nullptr, oppid, LOCATION_MZONE, pduel->game_field->none_id(), LOCATION_REASON::NONE, 0xff, &plist);
 		if (all_field) {
 			plist &= ~0x60;
@@ -3623,7 +3648,7 @@ LUA_STATIC_FUNCTION(SelectDisableField) {
 		}
 		flag = (flag & 0xff00ffff) | (plist << 16);
 	}
-	if((location2 & LOCATION_SZONE) && oppid != playerid) {
+	if((location2 & LOCATION_SZONE) && oppid != playerid && pduel->game_field->is_duelist(oppid)) {
 		ct4 = pduel->game_field->get_useable_count(nullptr, oppid, LOCATION_SZONE, pduel->game_field->none_id(), LOCATION_REASON::NONE, 0xff, &plist);
 		if (all_field) {
 			plist &= ~0xe0;
@@ -3647,7 +3672,7 @@ LUA_STATIC_FUNCTION(SelectDisableField) {
 		count = ct1 + ct2 + ct3 + ct4;
 	if(count == 0)
 		return 0;
-	pduel->game_field->emplace_process<Processors::SelectDisField>(playerid, flag, count);
+	pduel->game_field->emplace_process<Processors::SelectDisField>(playerid, flag, count, target);
 	return yieldk({
 		auto playerid = lua_get<uint8_t>(L, 1);
 		auto count = lua_get<uint8_t>(L, 2);
@@ -3687,9 +3712,16 @@ LUA_STATIC_FUNCTION(SelectFieldZone) {
 	if(location2 & LOCATION_SZONE)
 		flag &= 0xffffff;
 	flag |= filter;
+	// n_duelists > 2: the high half is the zones of one opponent; nobody else alive closes it
+	uint8_t target = DUELIST_NONE;
+	if(pduel->game_field->n_duelists > 2 && (location2 & (LOCATION_MZONE | LOCATION_SZONE))) {
+		target = f8_place_target(pduel, playerid, "SelectFieldZone");
+		if(target == DUELIST_NONE)
+			flag |= 0xffff0000;
+	}
 	if (flag == 0xffffffff)
 		return 0;
-	pduel->game_field->emplace_process<Processors::SelectDisField>(playerid, flag, count);
+	pduel->game_field->emplace_process<Processors::SelectDisField>(playerid, flag, count, target);
 	return yieldk({
 		auto playerid = lua_get<uint8_t>(L, 1);
 		auto count = lua_get<uint8_t>(L, 2);
