+// Only control values are players. Other effect values retain their stock numeric meaning.
+uint8_t effect::get_control_value(card* pcard) {
+	const bool callback = is_flag(EFFECT_FLAG_FUNC_VALUE);
+	// Core-created control/reset effects already contain real seats, even inside a Lua call.
+	if(pduel->game_field->n_duelists == 2 || (!callback && value_player == DUELIST_NONE))
+		return static_cast<uint8_t>(get_value(pcard));
+	const uint8_t P = callback ? get_handler_player() : value_player;
+	uint8_t bound = value_opp;
+	interpreter::scope_guard scope(pduel->lua);
+	// Keep the callback's perspective alive until its returned player has been unfolded.
+	if(!scope.push(P, &bound, false, false, callback ? this : nullptr, true))
+		return static_cast<uint8_t>(get_value(pcard));
+	const auto result = get_value(pcard);
+	if(result < 0 || result > UINT8_MAX)
+		return fold::INVALID;
+	// A single-card control value that names that card's other-side owner must
+	// retain the real owner. Folding loses which opponent owns the card; a bound
+	// opponent or the next-opponent fallback cannot supply that information.
+	const auto* perspective = fold::active(pduel);
+	if(perspective && get_handler() == pcard && result <= 1
+		&& !fold::is_own(*pduel->game_field, perspective->P, static_cast<uint8_t>(result))
+		&& pduel->lua->fold_out(pcard->owner) == result)
+		return pduel->game_field->is_alive(pcard->owner) ? pcard->owner : fold::INVALID;
+	return fold::unfold_action(pduel, static_cast<uint8_t>(result), "EFFECT_SET_CONTROL");
+}
