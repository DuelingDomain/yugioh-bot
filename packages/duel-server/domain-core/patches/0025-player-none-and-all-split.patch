+	// The internal "no duelist" and "every duelist" ids. With two duelists they are the stock
+	// PLAYER_NONE (2) and PLAYER_ALL (3); with more, seats 2 and 3 are real, so they are 0xFF and 0xFE.
+	uint8_t none_id() const { return n_duelists == 2 ? PLAYER_NONE : DUELIST_NONE; }
+	uint8_t all_id() const { return n_duelists == 2 ? PLAYER_ALL : DUELIST_ALL; }
+	// Sets the field-level sentinel values again after Debug.SetupDuelists changed n_duelists.
+	void reset_sentinels() {
+		core.reason_player = none_id();
+		core.conti_player = none_id();
+		nil_event.event_player = none_id();
+		nil_event.reason_player = none_id();
+	}
 	// A duelist in play that is not eliminated.
 	bool is_alive(int64_t p) const {
 		return is_duelist(p) && !player[p].eliminated;
