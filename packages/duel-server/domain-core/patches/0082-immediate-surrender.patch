+// A host surrender can remove a seat while a living seat's prompt stays open.
+// Only pending surrenders are checked here: an unfinished operation must
+// finish before its LP, Deck or effect-win losses are checked. An open chain
+// always defers the removal; surrender links resolve normally.
+LUA_STATIC_FUNCTION(SurrenderDuelist) {
+	check_param_count(L, 1);
+	auto& field = pduel->game_field;
+	const auto p = lua_get<int64_t>(L, 1);
+	if(field->n_duelists <= 2)
+		lua_error(L, "Debug.SurrenderDuelist: only in a duel of more than 2 duelists.");
+	if(!field->is_alive(p))
+		lua_error(L, "Debug.SurrenderDuelist: the duelist is not in the duel.");
+	// An already open living response must be closed explicitly by the host.
+	const bool close_window = field->n_teams == field->n_duelists && p == field->infos.turn_player
+		&& field->core.current_chain.empty() && field->core.response_window_optional
+		&& (field->core.response_window_seats & (1u << p));
+	field->player[p].pending_loss = 0x200;
+	field->check_losses_n(true);
+	if(close_window && !field->is_alive(p)) {
+		auto message = pduel->new_message(203); // MSG_SURRENDER_WINDOW_CLOSED: u8 response seat
+		message->write<uint8_t>(field->core.response_window_player);
+	}
+	return 0;
+}
+
 }
 }
 
