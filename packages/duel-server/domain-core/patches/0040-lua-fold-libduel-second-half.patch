+// ---- fold helpers of the F3b slice (SkipPhase to the end). With 2 duelists or no scope all of them are the
+// identity, so n == 2 keeps its bytes.
+// The player that chooses: unfold_action, and at n > 2 a chooser that is not a living duelist gives INVALID
+// (the caller returns the stock result of an invalid player: a prompt never goes to an eliminated seat).
+static uint8_t f3b_chooser(duel* pduel, uint8_t v, const char* fn) {
+	const auto playerid = fold::unfold_action(pduel, v, fn);
+	const auto& f = *pduel->game_field;
+	if(f.n_duelists > 2 && playerid != fold::INVALID && !f.is_alive(playerid))
+		return fold::INVALID;
+	return playerid;
+}
+// A continuation (yieldk) reads the player of argument 1 again after the prompt. At n > 2 write the real
+// seat into argument 1, so that the continuation reads a core seat and not the folded Lua value.
+static void f3b_pin_seat(lua_State* L, duel* pduel, uint8_t seat) {
+	if(pduel->game_field->n_duelists > 2) {
+		lua_pushinteger(L, seat);
+		lua_replace(L, 1);
+	}
+}
+// (player, location1 / self, location2 / oppo): the seat of the field side, with the two arguments
+// exchanged when the Lua value is "1". INVALID when the value names no side.
+template<typename T>
+static uint8_t f3b_field_seat(duel* pduel, uint8_t v, const char* fn, T& first, T& second) {
+	if(!fold::active(pduel))
+		return v;
+	const auto side = fold::field_side(pduel, v, fn);
+	if(!side.ok)
+		return fold::INVALID;
+	if(side.swap)
+		std::swap(first, second);
+	return side.self;
+}
+// A "to player" argument that acts (where a card goes). The same Lua value as the first player argument
+// (v_first) is the same seat (no second record). Otherwise unfold_action.
+static uint8_t f3b_seat_arg(duel* pduel, uint8_t v, const char* fn, int v_first, uint8_t seat) {
+	if(v == v_first)
+		return seat;
+	return fold::unfold_action(pduel, v, fn);
+}
+// The same for an optional argument: no integer gives dflt.
+static uint8_t f3b_opt_seat(lua_State* L, duel* pduel, int idx, uint8_t dflt, const char* fn, int v_first = -1, uint8_t seat = 0) {
+	if(!check_param<LuaParam::INT, true>(L, idx))
+		return dflt;
+	return f3b_seat_arg(pduel, lua_get<uint8_t>(L, idx), fn, v_first, seat);
+}
+// The player of an operation info: 0x10 (the card-target special summon marker) is kept. PLAYER_ALL is
+// stored once as all_id() (an operation info holds one player). A value that names no duelist is none_id().
+static uint8_t f3b_opinfo_player(duel* pduel, uint8_t v, const char* fn) {
+	if(v == 0x10)
+		return v;
+	const auto d = fold::unfold_action(pduel, v, fn);
+	return d == fold::INVALID ? pduel->game_field->none_id() : d;
+}
+// Class "query", best case: true when pred(d) is true for any duelist that the Lua value names. pred reads
+// the other arguments itself, so that an invalid player never reads them (as in stock).
+template<typename F>
+static int32_t f3b_can(lua_State* L, duel* pduel, uint8_t v, const char* fn, F&& pred) {
+	uint8_t who[MAX_DUELISTS];
+	const auto count = fold::query_list(pduel, v, who, fn);
+	bool res = false;
+	for(uint8_t i = 0; i < count && !res; ++i)
+		res = pred(who[i]);
+	lua_pushboolean(L, res);
+	return 1;
+}
