diff --git a/libduel.cpp b/libduel.cpp
index 164b3e9..6699301 100644
--- a/libduel.cpp
+++ b/libduel.cpp
@@ -102,6 +102,13 @@ LUA_STATIC_FUNCTION(RegisterEffect) {
 	const auto playerid = fold::unfold_action(pduel, lua_get<uint8_t>(L, 2), "RegisterEffect");
 	if(!pduel->game_field->is_duelist(playerid))
 		return 0;
+	// n_duelists > 2: a zone-disabling effect keeps the opponent that the registering link is bound to (the opponent of
+	// the zone prompt that made its value), so that the high half of its value names the same field as the prompt.
+	if(const auto* s = fold::active(pduel); s && s->P == playerid && peffect->code == EFFECT_DISABLE_FIELD) {
+		const uint8_t bound = pduel->lua->scope_bound_opp();
+		const auto& f = *pduel->game_field;
+		peffect->disfield_opp = (f.is_alive(bound) && !f.same_team(playerid, bound)) ? bound : DUELIST_NONE;
+	}
 	pduel->game_field->add_effect(peffect, playerid);
 	return 0;
 }
@@ -399,7 +406,8 @@ LUA_STATIC_FUNCTION(SSet) {
 	if(!pduel->game_field->is_duelist(playerid))
 		return 0;
