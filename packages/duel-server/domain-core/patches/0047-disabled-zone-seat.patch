 	uint8_t target = DUELIST_NONE;
-	if(pduel->game_field->n_duelists > 2) {
-		const uint8_t next = pduel->game_field->next_in_turn_order(playerid);
-		if(next != playerid && !pduel->game_field->same_team(playerid, next))
-			target = next;
-	}
+	if(pduel->game_field->n_duelists > 2 && (location2 & (LOCATION_MZONE | LOCATION_SZONE)))
+		target = f8_place_target(pduel, playerid, "SelectDisableField");
+	if(pduel->game_field->n_duelists > 2)
+		pduel->game_field->core.zone_prompt_opp = target;
 	const uint8_t oppid = pduel->game_field->n_duelists == 2 ? pduel->game_field->opponent_of(playerid) : target;
 	if(location1 & LOCATION_MZONE) {
 		ct1 = pduel->game_field->get_useable_count(nullptr, playerid, LOCATION_MZONE, pduel->game_field->none_id(), LOCATION_REASON::NONE, 0xff, &plist);
@@ -3719,6 +3725,8 @@ LUA_STATIC_FUNCTION(SelectFieldZone) {
 		if(target == DUELIST_NONE)
 			flag |= 0xffff0000;
 	}
+	if(pduel->game_field->n_duelists > 2)
+		pduel->game_field->core.zone_prompt_opp = target;
 	if (flag == 0xffffffff)
 		return 0;
 	pduel->game_field->emplace_process<Processors::SelectDisField>(playerid, flag, count, target);
diff --git a/processor.cpp b/processor.cpp
index 3d18b16..73fbc88 100644
--- a/processor.cpp
+++ b/processor.cpp
@@ -4935,11 +4935,25 @@ void field::adjust_all() {
 // n_duelists > 2 only. An EFFECT_DISABLE_FIELD value is relative to the handler: the low 16 bits are the
 // handler's own zones, the high 16 bits are the zones of the bound opponent (the next duelist in turn order).
 // The Extra Monster Zones are not mirrored: every duelist has its own.
-static void add_disabled_zones_n(field* f, uint8_t handler, uint32_t value) {
+// The bound opponent is the one that the registering link had (effect::disfield_opp) or that the zone prompt of the
+// operation used (Duel.SelectDisableField, Duel.SelectFieldZone). Without one, or when it is out of the duel, it is
+// the next living opponent in turn order, as the zone prompts use without a binding.
+static void add_disabled_zones_n(field* f, uint8_t handler, uint32_t value, uint8_t bound = DUELIST_NONE) {
 	if(!f->is_duelist(handler))
 		return;
 	f->player[handler].disabled_location |= value & 0xff7f;
-	f->player[f->next_in_turn_order(handler)].disabled_location |= (value >> 16) & 0xff7f;
+	uint8_t opp = DUELIST_NONE;
+	if(f->is_alive(bound) && !f->same_team(handler, bound))
+		opp = bound;
+	else {
+		for(uint8_t i = 1; i < f->n_duelists && opp == DUELIST_NONE; ++i) {
+			const auto q = static_cast<uint8_t>((handler + i) % f->n_duelists);
+			if(f->is_alive(q) && !f->same_team(handler, q))
+				opp = q;
+		}
+	}
+	if(opp != DUELIST_NONE)
+		f->player[opp].disabled_location |= (value >> 16) & 0xff7f;
 }
 // n_duelists > 2 only. Sends MSG_FIELD_DISABLED_N (u8 count, count x (u8 duelist, u32 own zones in the low 16 bits))
