-	if(!pduel->game_field->is_duelist(toplayer))
+	// n_duelists > 2: a card is not set to the field of a duelist that is out of the duel
+	if(pduel->game_field->n_duelists > 2 ? !pduel->game_field->is_alive(toplayer) : !pduel->game_field->is_duelist(toplayer))
 		toplayer = playerid;
