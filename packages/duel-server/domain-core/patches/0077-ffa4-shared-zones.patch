+// A mask's high half names one across seat, never a side seat. Reads bind that
+// seat without a prompt when no opponent is bound; an existing bind wins.
+// Duel mask queries retain their low-half query semantics. Their high half can
+// name only the acting seat's physical across field, with that seat bound.
+inline uint32_t player_zone_mask(duel* pduel, uint8_t viewer, uint32_t zone) {
+	const auto& f = *pduel->game_field;
+	const auto* s = active(pduel);
+	if(f.n_duelists != 4 || f.n_teams != f.n_duelists || !s || !(zone & 0xffff0000u))
+		return zone;
+	const auto across = f.across_of(s->P);
+	if(viewer == s->P) {
+		pduel->lua->scope_mark_touched();
+		if(across != DUELIST_NONE && pduel->lua->scope_bind(across)
+				&& pduel->lua->scope_bound_opp() == across)
+			return zone;
+	} else if(viewer == across && pduel->lua->scope_bound_opp() == across)
+		return zone;
+	return zone & 0xffffu;
+}
+
+inline uint32_t card_zone_mask(duel* pduel, lua_State* L, int idx, uint8_t cp, card* pcard, uint32_t zone) {
+	const auto& f = *pduel->game_field;
+	const auto controller = pcard->current.controler;
+	const auto across = f.across_of(controller);
+	bool own = cp_is_controler(pduel, L, idx, cp, controller);
+	bool mirrored = false;
+	if(!lua_isnoneornil(L, idx) && across != DUELIST_NONE) {
+		if(const auto* s = active(pduel)) {
+			if(is_own(f, s->P, cp))
+				mirrored = s->P == across;
+			else if(cp <= 1 && s->P == controller) {
+				pduel->lua->scope_mark_touched();
+				mirrored = pduel->lua->scope_bind(across)
+					&& pduel->lua->scope_bound_opp() == across;
+			}
+		} else
+			mirrored = cp == across;
+	}
+	// Own-view masks expose the same high half and must obey the same binding.
+	// Reads of foreign cards do not change the acting player's binding.
+	if(f.n_duelists == 4 && f.n_teams == f.n_duelists && own && (zone & 0xffff0000u)) {
+		if(const auto* s = active(pduel); s && s->P == controller) {
+			pduel->lua->scope_mark_touched();
+			if(across == DUELIST_NONE || !pduel->lua->scope_bind(across)
+				|| pduel->lua->scope_bound_opp() != across)
+				zone &= 0xffffu;
+		}
+	}
+	if(mirrored) {
+		zone = ((zone & 0xffff) << 16) | (zone >> 16);
+		if(f.n_duelists == 4 && f.n_teams == f.n_duelists) {
+			if(const auto* s = active(pduel); s && s->P == across && (zone & 0xffff0000u)) {
+				pduel->lua->scope_mark_touched();
+				if(!pduel->lua->scope_bind(controller) || pduel->lua->scope_bound_opp() != controller)
+					zone &= 0xffffu;
+			}
+		}
+		return zone;
+	}
+	if(!own)
+		return 0;
+	// A dynamic disable/linked-zone callback identifies the origin only when
+	// it reads its own handler's geometry. No general last-query state is kept.
+	if(f.n_duelists == 4 && f.n_teams == f.n_duelists) {
+		if(const auto* s = active(pduel); s && s->eff && f.evaluating_zone_mask == s->eff && s->eff->get_handler() == pcard
+			&& (s->eff->code == EFFECT_DISABLE_FIELD || s->eff->code == EFFECT_BECOME_LINKED_ZONE)) {
+			s->eff->disfield_geometry = true;
+			s->eff->disfield_geometry_opp = across;
+		}
+	}
+	return zone;
+}
