+uint8_t field::zone_opponent(effect* peffect) const {
+	const auto handler = peffect->get_handler_player();
+	if(!is_duelist(handler))
+		return DUELIST_NONE;
+	if(n_duelists == 4 && n_teams == n_duelists) {
+		if(peffect->disfield_selected)
+			return peffect->disfield_opp;
+		if(is_duelist(peffect->disfield_operation_opp))
+			return peffect->disfield_operation_opp;
+		if(peffect->disfield_geometry)
+			return peffect->disfield_geometry_opp;
+		if(is_duelist(peffect->disfield_opp))
+			return peffect->disfield_opp;
+		return across_of(handler);
+	}
+	if(is_duelist(peffect->disfield_opp))
+		return peffect->disfield_opp;
+	for(uint8_t i = 1; i < n_duelists; ++i) {
+		const auto q = static_cast<uint8_t>((handler + i) % n_duelists);
+		if(is_alive(q) && !same_team(handler, q))
+			return q;
+	}
+	return DUELIST_NONE;
+}
