diff --git a/field.cpp b/field.cpp
index b237a60..4da491a 100644
--- a/field.cpp
+++ b/field.cpp
@@ -1587,6 +1587,11 @@ void field::add_effect(effect* peffect, uint8_t owner_player) {
 	if (!peffect->handler) {
 		peffect->flag[0] |= EFFECT_FLAG_FIELD_ONLY;
 		peffect->handler = peffect->owner;
+		// FFA: an absolute range is stored relative to the owner it had when the script set it (SetAbsoluteRange).
+		// A new owner is another duelist, so the two ranges change places (the named side stays the named side).
+		if(n_duelists > 2 && n_teams == n_duelists && (peffect->flag[0] & EFFECT_FLAG_ABSOLUTE_TARGET)
+				&& is_duelist(peffect->effect_owner) && is_duelist(owner_player) && peffect->effect_owner != owner_player)
+			std::swap(peffect->s_range, peffect->o_range);
 		peffect->effect_owner = owner_player;
 		peffect->id = peffect->initial_id = infos.field_id++;
 	}
diff --git a/fold_lib.h b/fold_lib.h
new file mode 100644
index 0000000..af4983b
--- /dev/null
+++ b/fold_lib.h
@@ -0,0 +1,165 @@
+/*
+ * Phase 3 perspective fold: the helpers that the Lua library files (libduel, libcard, libgroup, libeffect)
+ * share. They sit on top of the fold.h classes. Each one does one job, and every one is the identity at
+ * n == 2 or without a scope (see fold.h), so n == 2 keeps its bytes.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+#ifndef FOLD_LIB_H_
+#define FOLD_LIB_H_
+
+#include <cstdint>
+#include <utility> //std::swap
+#include "common.h"
+#include "duel.h"
+#include "field.h"
+#include "fold.h"
+#include "scriptlib.h"
+
+namespace fold {
+
+// ---- who acts (a core seat for the library function; INVALID is kept away from prompts and indexes)
+
+// An optional player argument at idx that names WHO acts (reason player, chooser, summoner). A missing or
+// nil argument gives def untouched: def is a core id and may be none_id(), which unfold_action would
+// trap as kind (d). A given value goes through unfold_action (the identity at n == 2). INVALID gives def
+// too, so that no prompt and no index ever sees it.
+inline uint8_t opt_player(lua_State* L, duel* pduel, int idx, uint8_t def, const char* fn, bool team_level = false) {
+	if(lua_isnoneornil(L, idx))
+		return def;
+	const auto d = unfold_action(pduel, scriptlib::lua_get<uint8_t>(L, idx, def), fn, team_level);
+	return (d == INVALID && active(pduel)) ? def : d;
+}
+
+// A required player argument at idx that names who acts or who an event is for. Same as unfold_action,
+// but INVALID gives def, so that no prompt, index or event ever sees it. (A required argument keeps the
+// stock lua_get read, so n == 2 is unchanged.)
+inline uint8_t req_player(lua_State* L, duel* pduel, int idx, uint8_t def, const char* fn) {
+	const auto d = unfold_action(pduel, scriptlib::lua_get<uint8_t>(L, idx), fn);
+	return (d == INVALID && active(pduel)) ? def : d;
+}
+
+// An optional player argument at idx that names a TARGET (the player that gets the card). A missing or nil
+// argument gives def. A given value goes through unfold_action and may stay INVALID: the caller keeps its
+// own is_duelist guard, which then gives the stock invalid-player result.
+inline uint8_t opt_target(lua_State* L, duel* pduel, int idx, uint8_t def, const char* fn) {
+	if(lua_isnoneornil(L, idx))
+		return def;
+	return unfold_action(pduel, scriptlib::lua_get<uint8_t>(L, idx, def), fn);
+}
+
+// True when the fold is active and d is not a duelist (INVALID, none_id() or all_id()): for the functions
+// that had no is_duelist guard before and must not hand such a seat to the core. False at n == 2.
+inline bool not_duelist(duel* pduel, uint8_t d) {
+	return active(pduel) && !pduel->game_field->is_duelist(d);
+}
+
+// A "to player" argument that acts (where a card goes). The same Lua value as the first player argument
+// (v_first) is the same seat (no second record). Otherwise unfold_action.
+inline uint8_t seat_arg(duel* pduel, uint8_t v, const char* fn, int v_first, uint8_t seat) {
+	if(v == v_first)
+		return seat;
+	return unfold_action(pduel, v, fn);
+}
+
+// The same for an optional argument: no integer gives dflt.
+inline uint8_t opt_seat(lua_State* L, duel* pduel, int idx, uint8_t dflt, const char* fn, int v_first = -1, uint8_t seat = 0) {
+	if(!scriptlib::check_param<LuaParam::INT, true>(L, idx))
+		return dflt;
+	return seat_arg(pduel, scriptlib::lua_get<uint8_t>(L, idx), fn, v_first, seat);
+}
+
+// ---- prompts
+
+// The player that chooses: unfold_action, and at n > 2 a chooser that is not a living duelist gives INVALID
+// (the caller returns the stock result of an invalid player: a prompt never goes to an eliminated seat).
+inline uint8_t chooser(duel* pduel, uint8_t v, const char* fn) {
+	const auto playerid = unfold_action(pduel, v, fn);
+	const auto& f = *pduel->game_field;
+	if(f.n_duelists > 2 && playerid != INVALID && !f.is_alive(playerid))
+		return INVALID;
+	return playerid;
+}
+
+// A chooser prompt may only go to a duelist who is still in play (for a seat that is already unfolded).
+inline bool can_choose(duel* pduel, uint8_t playerid) {
+	const auto& f = *pduel->game_field;
+	return f.is_duelist(playerid) && (f.n_duelists == 2 || f.is_alive(playerid));
+}
+
+// A yieldk continuation re-reads the player from Lua stack slot idx. With the fold active the slot holds
+// the Lua value, so the slot is replaced by the core seat before the yield. (No-op at n == 2.)
+inline void pin_player(lua_State* L, duel* pduel, int idx, uint8_t seat) {
+	if(!active(pduel))
+		return;
+	lua_pushinteger(L, seat);
+	lua_replace(L, idx);
+}
+
+// ---- reads (a player argument that selects a view or a side)
+
+// A player argument that only selects the card info "as seen by that player" (summon codes, types, races...):
+// the Lua value becomes a core seat (with no living opponent: none_id(), which is "nobody in particular").
+inline uint8_t viewer(duel* pduel, uint8_t v, const char* fn) {
+	if(!active(pduel))
+		return v;
+	const auto d = unfold_action(pduel, v, fn);
+	return d == INVALID ? pduel->game_field->none_id() : d;
+}
+
+// The player of an operation info: 0x10 (the card-target special summon marker) and PLAYER_EITHER are kept
+// (neither is a seat, and fold_player leaves both alone, so a script reads the same value back). PLAYER_ALL is
+// stored once as all_id() (an operation info holds one player). A value that names no duelist is none_id().
+inline uint8_t opinfo_player(duel* pduel, uint8_t v, const char* fn) {
+	if(v == 0x10 || v == PLAYER_EITHER)
+		return v;
+	return viewer(pduel, v, fn);
+}
+
+// An optional player argument of a check or an action (default: the reason player, a core seat). A given value
+// becomes a core seat. false: the value names nobody who can act (kind d, no living opponent, PLAYER_NONE or
+// PLAYER_ALL): the caller gives the stock result of an invalid player. Identity when the fold is not active.
+inline bool get_player(duel* pduel, lua_State* L, int idx, const char* fn, uint8_t& out) {
+	out = scriptlib::lua_get<uint8_t>(L, idx, pduel->game_field->core.reason_player);
+	if(!active(pduel) || lua_isnoneornil(L, idx))
+		return true;
+	out = unfold_action(pduel, out, fn);
+	return pduel->game_field->is_duelist(out);
+}
+
+// GetLinkedZone and the like: does the Lua player cp (given as argument idx, or absent) name the controler of the
+// card? The zones of a duelist are only known for the card's own controler (separate fields at n > 2).
+inline bool cp_is_controler(duel* pduel, lua_State* L, int idx, uint8_t cp, uint8_t controler) {
+	return lua_isnoneornil(L, idx) || matches(pduel, cp, controler);
+}
+
+// (player, location1 / self, location2 / oppo): the seat of the field side, with the two arguments
+// exchanged when the Lua value is "1". INVALID when the value names no side.
+template<typename T>
+inline uint8_t field_seat(duel* pduel, uint8_t v, const char* fn, T& first, T& second) {
+	if(!active(pduel))
+		return v;
+	const auto side = field_side(pduel, v, fn);
+	if(!side.ok)
+		return INVALID;
+	if(side.swap)
+		std::swap(first, second);
+	return side.self;
+}
+
+// Class "query", best case: true when pred(d) is true for any duelist that the Lua value names. pred reads
+// the other arguments itself, so that an invalid player never reads them (as in stock).
+template<typename F>
+inline int32_t can_any(lua_State* L, duel* pduel, uint8_t v, const char* fn, F&& pred) {
+	uint8_t who[MAX_DUELISTS];
+	const auto count = query_list(pduel, v, who, fn);
+	bool res = false;
+	for(uint8_t i = 0; i < count && !res; ++i)
+		res = pred(who[i]);
+	lua_pushboolean(L, res);
+	return 1;
+}
+
+} // namespace fold
+
+#endif /* FOLD_LIB_H_ */
