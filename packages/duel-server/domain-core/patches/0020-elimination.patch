+// Sends MSG_REMOVE_CARDS for the given locations, at most 255 cards per message (like Duel.RemoveCards).
+static void send_remove_cards(duel* pduel, const std::vector<loc_info>& locs) {
+	size_t done = 0;
+	while(done < locs.size()) {
+		const size_t cur = std::min<size_t>(locs.size() - done, 255);
+		auto message = pduel->new_message(MSG_REMOVE_CARDS);
+		message->write<uint32_t>(static_cast<uint32_t>(cur));
+		for(size_t i = 0; i < cur; ++i)
+			message->write(locs[done + i]);
+		done += cur;
+	}
+}
 void field::eliminate(uint8_t p, uint8_t reason) {
-	(void)reason;
-	if(!is_duelist(p))
+	// With 2 duelists a loss ends the duel, so there is nothing to eliminate: do nothing.
+	if(n_duelists == 2 || !is_alive(p))
 		return;
 	player[p].eliminated = true;
+	// 1. The message.
+	{
+		auto message = pduel->new_message(MSG_DUELIST_ELIMINATED);
+		message->write<uint8_t>(p);
+		message->write<uint8_t>(reason);
+	}
+	// 2. p's turn runs out without prompts (Turn then skips p).
+	if(infos.turn_player == p)
+		core.force_turn_end = true;
+	// 3. Chain entries that p would add. Chain links already on the chain are negated in SolveChain.
+	for(auto* lst : { &core.new_fchain, &core.new_fchain_s, &core.new_ochain, &core.new_ochain_s, &core.new_fchain_b,
+			&core.new_ochain_b, &core.new_ochain_h, &core.new_chains }) {
+		lst->remove_if([p](const chain& ch) { return ch.triggering_player == p; });
+	}
+	for(auto it = core.quick_f_chain.begin(); it != core.quick_f_chain.end();) {
+		if(it->second.triggering_player == p)
+			it = core.quick_f_chain.erase(it);
+		else
+			++it;
+	}
+	for(auto* delayed : { &core.delayed_quick, &core.delayed_quick_tmp }) {
+		for(auto it = delayed->begin(); it != delayed->end();) {
+			if(it->first->handler && it->first->handler->owner == p)
+				it = delayed->erase(it);
+			else
+				++it;
+		}
+	}
+	// 4. Attacks that involve p. An attack by p ends. An attack on p is rolled back before the damage step and
+	// ends in the damage step.
+	if(card* attacker = core.attacker) {
+		if(attacker->owner == p || attacker->current.controler == p) {
+			attacker->set_status(STATUS_ATTACK_CANCELED, TRUE);
+		} else if(core.battle_defender == p || (core.attack_target && (core.attack_target->owner == p || core.attack_target->current.controler == p))) {
+			if(infos.phase == PHASE_DAMAGE || infos.phase == PHASE_DAMAGE_CAL)
+				attacker->set_status(STATUS_ATTACK_CANCELED, TRUE);
+			else
+				core.attack_rollback = true;
+		}
+	}
+	// 5. Cards. A card p owns leaves the game. A card p controls and does not own goes to its owner's Graveyard.
+	auto gone = [p](card* pcard) { return pcard->owner == p || pcard->current.controler == p; };
+	std::vector<card*> removed;            // cards that leave the game, in the fixed order (not Xyz materials)
+	std::vector<card*> removed_mats;       // Xyz materials that p owns, each before its Xyz monster in the message
+	std::vector<std::pair<card*, card*>> foreign_mats; // (material, Xyz monster) for materials of others under p's Xyz
+	std::vector<card*> order;              // what goes into MSG_REMOVE_CARDS: materials first, then the card
+	card_set to_grave, equipings;
+	auto take = [&](card* pcard) {
+		if(pcard->owner == p)
+			removed.push_back(pcard);
+		else if(pcard->current.controler == p && is_alive(pcard->owner))
+			to_grave.insert(pcard);
+	};
+	for(uint8_t q = 0; q < n_duelists; ++q) {
+		for(auto* zone : { &player[q].list_mzone, &player[q].list_szone }) {
+			for(auto& pcard : *zone) {
+				if(!pcard)
+					continue;
+				const bool xyz_gone = pcard->owner == p;
+				for(auto& mat : pcard->xyz_materials) {
+					if(mat->owner == p)
+						removed_mats.push_back(mat);
+					else if(xyz_gone)
+						foreign_mats.emplace_back(mat, pcard);
+				}
+				take(pcard);
+			}
+		}
+		for(auto* lst : { &player[q].list_main, &player[q].list_hand, &player[q].list_grave, &player[q].list_remove, &player[q].list_extra }) {
+			for(auto& pcard : *lst)
+				take(pcard);
+		}
+	}
+	// Cards p owns that are removed: what they hold and what holds them.
+	for(auto& pcard : removed) {
+		if(pcard->equiping_target)
+			pcard->unequip();
+		const std::vector<card*> equips(pcard->equiping_cards.begin(), pcard->equiping_cards.end());
+		for(auto& equipc : equips) {
+			equipc->unequip();
+			if(equipc->current.location == LOCATION_SZONE && !gone(equipc))
+				equipings.insert(equipc);
+		}
+		pcard->clear_card_target();
+	}
+	// Materials of other duelists under a removed Xyz monster go to their owner's Graveyard (no event).
+	for(auto& [mat, xyz] : foreign_mats) {
+		const uint8_t control_player = xyz->current.controler;
+		auto message = pduel->new_message(MSG_MOVE);
+		message->write<uint32_t>(mat->data.code);
+		message->write(mat->get_info_location());
+		xyz->xyz_remove(mat);
+		mat->current.reason = REASON_RULE + REASON_LOST_TARGET;
+		mat->current.reason_effect = nullptr;
+		mat->current.reason_player = DUELIST_NONE; // n > 2 here: PLAYER_NONE (2) is a duelist
+		move_card(mat->owner, mat, LOCATION_GRAVE, 0);
+		mat->current.position = POS_FACEUP;
+		message->write(mat->get_info_location());
+		message->write<uint32_t>(mat->current.reason);
+		mat->previous.controler = control_player;
+		mat->reset(RESET_TOGRAVE, RESET_EVENT);
+	}
+	// The removal message: locations are read before any card moves.
+	std::vector<loc_info> locs;
+	for(auto& mat : removed_mats) {
+		order.push_back(mat);
+		locs.push_back(mat->get_info_location());
+	}
+	for(auto& pcard : removed) {
+		order.push_back(pcard);
+		locs.push_back(pcard->get_info_location());
+	}
+	send_remove_cards(pduel, locs);
+	for(auto& pcard : order) {
+		if(pcard->overlay_target)
+			pcard->overlay_target->xyz_remove(pcard);
+		else {
+			pcard->enable_field_effect(false);
+			pcard->cancel_field_effect();
+		}
+	}
+	for(auto& pcard : removed)
+		remove_card(pcard);
+	for(auto& pcard : order)
+		pcard->reset(RESET_LEAVE | RESET_REMOVE | RESET_OVERLAY, RESET_EVENT);
+	core.shuffle_deck_check[p] = false;
+	core.shuffle_hand_check[p] = false;
+	// Lingering effects of p's cards that end at a phase (the list is copied, removal changes it).
+	{
+		const std::vector<effect*> lingering(effects.pheff.begin(), effects.pheff.end());
+		for(auto* peffect : lingering) {
+			if(peffect->owner->owner != p || !(peffect->reset_flag & RESET_PHASE))
+				continue;
+			if(peffect->is_flag(EFFECT_FLAG_FIELD_ONLY))
+				remove_effect(peffect);
+			else
+				peffect->handler->remove_effect(peffect);
+		}
+	}
+	// Equip cards of others that lost their target, and cards p controls but does not own.
+	if(equipings.size())
+		destroy(std::move(equipings), nullptr, REASON_RULE + REASON_LOST_TARGET, DUELIST_NONE);
+	// One send_to per owner: the destination duelist is given, so no "none" player id is needed.
+	for(uint8_t q = 0; q < n_duelists; ++q) {
+		card_set group;
+		for(auto& pcard : to_grave)
+			if(pcard->owner == q)
+				group.insert(pcard);
+		if(group.size())
+			send_to(std::move(group), nullptr, REASON_RULE, DUELIST_NONE, q, LOCATION_GRAVE, 0, POS_FACEUP);
+	}
+	core.re_adjust = true;
 }
