+#ifdef YGO_N_TRAP_LOG
+// Census build only (scripts/native/census.patch): the card code of the effect the core is working on.
+uint32_t field::census_effect_code() const {
+	effect* pe = nullptr;
+	if(!core.current_chain.empty())
+		pe = core.current_chain.back().triggering_effect;
+	if(!pe)
+		pe = core.reason_effect;
+	if(pe) {
+		card* handler = pe->get_handler();
+		if(handler)
+			return handler->data.code;
+	}
+	return 0;
