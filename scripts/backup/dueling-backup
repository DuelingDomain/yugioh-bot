#!/usr/bin/env python3
"""Create a verified SQLite snapshot without stopping the live WAL writers."""

import fcntl
import hashlib
import os
from pathlib import Path
import re
import shutil
import sqlite3
import sys
import tempfile
from contextlib import closing
from datetime import datetime, timedelta, timezone


SRC = Path(os.environ.get("DUELING_BACKUP_SRC", "/opt/yugioh-bot/data/bot.sqlite"))
DEST_DIR = Path(os.environ.get("DUELING_BACKUP_DIR", "/var/backups/yugioh-bot"))
KEEP_ENV = "DUELING_BACKUP_KEEP"
RELEASE_KEEP_ENV = "DUELING_RELEASE_KEEP_DAYS"
MAX_BACKUP_DAYS = 14
# The timer runs once a day, so expire copies a day early to keep the 14-day promise.
RUN_INTERVAL = timedelta(days=1)
SPACE_MULTIPLIER = 3
CONNECT_TIMEOUT = 30
UTC = timezone.utc
AUTOMATIC_NAME = re.compile(r"^bot-(\d{8}-\d{6})Z\.sqlite$")
RELEASE_NAME = re.compile(r"^pr2-([0-9]{8}-[0-9]{6})Z$")


def safe_path(path, root=None):
    absolute = Path(os.path.abspath(path))
    resolved = absolute.resolve()
    if absolute.is_symlink() or resolved != absolute:
        raise ValueError("refusing symlink path: " + str(absolute))
    if root is not None and root not in resolved.parents:
        raise ValueError("path is outside backup root: " + str(absolute))
    return resolved


def release_tree(path, root):
    # Validate the entire tree before deleting anything; never follow symlinks.
    path = safe_path(path, root)
    paths = [path]
    if path.is_dir():
        for child in path.iterdir():
            paths.extend(release_tree(child, root))
    return paths


def remove_release_path(path, root):
    path = safe_path(path, root)
    if path.is_dir():
        shutil.rmtree(path)
    else:
        path.unlink()


def warn_release_pruning(error):
    message = " ".join(str(error).split()) or type(error).__name__
    print("WARNING: dueling-backup: release pruning: " + message, file=sys.stderr)


def prune_releases():
    root = safe_path(DEST_DIR)
    try:
        keep_days = int(os.environ.get(RELEASE_KEEP_ENV, str(MAX_BACKUP_DAYS)))
        if not 1 <= keep_days <= MAX_BACKUP_DAYS:
            raise ValueError
    except ValueError:
        warn_release_pruning(RELEASE_KEEP_ENV + " must be an integer from 1 to 14; using 14 days")
        keep_days = MAX_BACKUP_DAYS

    releases = []
    for path in root.iterdir():
        match = RELEASE_NAME.fullmatch(path.name)
        if not match:
            continue
        try:
            stamp = datetime.strptime(match.group(1), "%Y%m%d-%H%M%S").replace(tzinfo=UTC)
        except ValueError:
            continue
        try:
            path = safe_path(path, root)
            if path.is_dir():
                releases.append((stamp, path))
        except Exception as error:
            warn_release_pruning(error)

    releases.sort(key=lambda entry: entry[0], reverse=True)
    now = datetime.now(UTC)
    # Never shorter than one day, so a run during a deploy cannot delete the copy being written.
    database_cutoff = now - max(timedelta(days=keep_days) - RUN_INTERVAL, RUN_INTERVAL)
    directory_cutoff = now - timedelta(days=MAX_BACKUP_DAYS) + RUN_INTERVAL
    for index, (stamp, path) in enumerate(releases):
        if stamp >= database_cutoff:
            continue
        try:
            paths = release_tree(path, root)
            if index > 0 and stamp < directory_cutoff:
                remove_release_path(path, root)
                continue
            # Preserve rollback metadata, including protected runtime.env, but no DB copies.
            removed_dirs = []
            for child in paths[1:]:
                if any(parent in removed_dirs for parent in child.parents):
                    continue
                if child == path / "online" or child == path / "drained" or ".sqlite" in child.name:
                    is_directory = child.is_dir()
                    remove_release_path(child, root)
                    if is_directory:
                        removed_dirs.append(child)
        except Exception as error:
            warn_release_pruning(error)


def prune_backups(keep):
    root = safe_path(DEST_DIR)
    cutoff = datetime.now(UTC) - timedelta(days=MAX_BACKUP_DAYS) + RUN_INTERVAL
    backups = []
    for path in root.iterdir():
        match = AUTOMATIC_NAME.fullmatch(path.name)
        if not match or path.is_symlink() or not path.is_file():
            continue
        try:
            stamp = datetime.strptime(match.group(1), "%Y%m%d-%H%M%S").replace(tzinfo=UTC)
        except ValueError:
            continue
        path = safe_path(path, root)
        backups.append((stamp, path))
    backups.sort(key=lambda entry: entry[0], reverse=True)
    retained = []
    for index, (stamp, path) in enumerate(backups):
        # Always keep the newest snapshot, even when pruning stale files in isolation.
        if index == 0 or (index < keep and stamp >= cutoff):
            retained.append((stamp, path))
            continue
        path = safe_path(path, root)
        path.unlink()
        sidecar = Path(str(path) + ".sha256")
        if sidecar.is_symlink():
            continue
        try:
            safe_path(sidecar, root).unlink()
        except FileNotFoundError:
            pass
    return len(retained), sum(path.stat().st_size for _, path in retained)


def create_backup():
    try:
        keep = int(os.environ.get(KEEP_ENV, "7"))
        if keep < 1:
            raise ValueError
    except ValueError:
        raise ValueError(KEEP_ENV + " must be an integer >= 1") from None

    destination = safe_path(DEST_DIR)
    destination.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary_paths = []
    directory_fd = os.open(str(destination), os.O_RDONLY | os.O_DIRECTORY)
    try:
        # Lock the directory itself, avoiding an extra lock file or overlapping runs.
        try:
            fcntl.flock(directory_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("another backup is already running for " + str(destination))

        source = SRC.absolute()
        source_size = source.stat().st_size
        try:
            wal_size = Path(str(source) + "-wal").stat().st_size
        except FileNotFoundError:
            wal_size = 0
        required = SPACE_MULTIPLIER * (source_size + wal_size)
        free = shutil.disk_usage(destination).free
        if free < required:
            # Expired release copies may be what filled the disk; free them before giving up.
            try:
                prune_releases()
            except Exception as error:
                warn_release_pruning(error)
            free = shutil.disk_usage(destination).free
        if free < required:
            raise RuntimeError("insufficient free space: need {} bytes, have {} in {}".format(required, free, destination))

        fd, temporary_name = tempfile.mkstemp(prefix=".dueling-backup-", suffix=".tmp", dir=str(destination))
        temporary = Path(temporary_name)
        temporary_paths.append(temporary)
        os.close(fd)
        # URI escaping handles spaces, '?' and '#'. Never use immutable=1 on live WAL.
        # mode=ro still needs access to the live -shm file; the data directory is writable.
        with closing(sqlite3.connect(source.as_uri() + "?mode=ro", uri=True, timeout=CONNECT_TIMEOUT)) as live:
            with closing(sqlite3.connect(str(temporary), timeout=CONNECT_TIMEOUT)) as copy:
                # One WAL read transaction gives a consistent snapshot without blocking writers; incremental steps can restart indefinitely under steady writes.
                live.backup(copy)
                journal = copy.execute("PRAGMA journal_mode=DELETE").fetchone()
                if journal != ("delete",):
                    raise RuntimeError("could not switch backup to journal_mode=DELETE")
                integrity = copy.execute("PRAGMA integrity_check").fetchall()
                if integrity != [("ok",)]:
                    raise RuntimeError("backup integrity_check failed: " + repr(integrity))

        temporary.chmod(0o600)
        digest = hashlib.sha256()
        with temporary.open("rb") as data:
            os.fsync(data.fileno())
            for chunk in iter(lambda: data.read(1024 * 1024), b""):
                digest.update(chunk)
        checksum = digest.hexdigest()
        size = temporary.stat().st_size
        now = datetime.now(UTC)
        final = destination / now.strftime("bot-%Y%m%d-%H%M%SZ.sqlite")
        sidecar = Path(str(final) + ".sha256")
        if os.path.lexists(final) or os.path.lexists(sidecar):
            raise RuntimeError("backup name already exists; retry in the next second: " + str(final))

        fd, checksum_name = tempfile.mkstemp(prefix=".dueling-sha256-", suffix=".tmp", dir=str(destination))
        checksum_temporary = Path(checksum_name)
        temporary_paths.append(checksum_temporary)
        with os.fdopen(fd, "w", encoding="ascii") as output:
            os.fchmod(output.fileno(), 0o600)
            output.write(checksum + "  " + final.name + "\n")
            output.flush()
            os.fsync(output.fileno())

        os.rename(temporary, final)
        os.rename(checksum_temporary, sidecar)
        os.fsync(directory_fd)
        try:
            kept, total_bytes = prune_backups(keep)
        finally:
            # A failed daily prune must not keep expired release copies too.
            try:
                prune_releases()
            except Exception as error:
                warn_release_pruning(error)
        os.fsync(directory_fd)
        return final, size, checksum, kept, total_bytes
    finally:
        try:
            # Remove only our own temporary files and SQLite's associated journals.
            for temporary in temporary_paths:
                for suffix in ("", "-wal", "-shm", "-journal"):
                    try:
                        Path(str(temporary) + suffix).unlink()
                    except FileNotFoundError:
                        pass
        finally:
            os.close(directory_fd)


def main():
    try:
        path, size, checksum, kept, total_bytes = create_backup()
        print("{} {} {} kept={} total_bytes={}".format(path, size, checksum, kept, total_bytes))
        return 0
    except (Exception, KeyboardInterrupt) as error:
        message = " ".join(str(error).split()) or type(error).__name__
        print("ERROR: dueling-backup: " + message, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
