#!/usr/bin/env python3
"""Create a compressed, verified SQLite snapshot without stopping WAL writers."""

import fcntl
import ctypes
import gzip
import hashlib
import os
from pathlib import Path
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from contextlib import closing
from datetime import datetime, timedelta, timezone


SRC = Path(os.environ.get("DUELING_BACKUP_SRC", "/opt/yugioh-bot/data/bot.sqlite"))
DEST_DIR = Path(os.environ.get("DUELING_BACKUP_DIR", "/var/backups/yugioh-bot"))
KEEP_ENV = "DUELING_BACKUP_KEEP"
DEPLOY_KEEP_ENV = "DUELING_DEPLOY_BACKUP_KEEP"
MIN_FREE_ENV = "DUELING_BACKUP_MIN_FREE_BYTES"
RELEASE_KEEP_ENV = "DUELING_RELEASE_KEEP_DAYS"
DEFAULT_MIN_FREE_BYTES = 1024 * 1024 * 1024
MAX_BACKUP_DAYS = 14
# The timer runs once a day, so expire copies a day early to keep the 14-day promise.
RUN_INTERVAL = timedelta(days=1)
SPACE_MULTIPLIER = 3
CONNECT_TIMEOUT = 30
UTC = timezone.utc
AUTOMATIC_NAME = re.compile(r"^bot-(\d{8}-\d{6})Z\.sqlite(?:\.(?:gz|zst))?$")
RELEASE_NAME = re.compile(r"^pr2-([0-9]{8}-[0-9]{6})Z$")
DEPLOY_KINDS = ("online", "drained")


class BackupSkipped(RuntimeError):
    pass


def integer_setting(name, default, minimum):
    try:
        value = int(os.environ.get(name, str(default)))
        if value < minimum:
            raise ValueError
        return value
    except ValueError:
        raise ValueError("{} must be an integer >= {}".format(name, minimum)) from None


def safe_path(path, root=None):
    absolute = Path(os.path.abspath(path))
    resolved = absolute.resolve()
    if absolute.is_symlink() or resolved != absolute:
        raise ValueError("refusing symlink path: " + str(absolute))
    if root is not None and root not in resolved.parents:
        raise ValueError("path is outside backup root: " + str(absolute))
    return resolved


def release_tree(path, root):
    # Validate the entire tree before deleting anything; never follow symlinks.
    path = safe_path(path, root)
    paths = [path]
    if path.is_dir():
        for child in path.iterdir():
            paths.extend(release_tree(child, root))
    return paths


def remove_release_path(path, root):
    path = safe_path(path, root)
    if path.is_dir():
        shutil.rmtree(path)
    else:
        path.unlink()


def warn_release_pruning(error):
    message = " ".join(str(error).split()) or type(error).__name__
    print("WARNING: dueling-backup: release pruning: " + message, file=sys.stderr)


def checksum_file(path):
    digest = hashlib.sha256()
    with path.open("rb") as data:
        for chunk in iter(lambda: data.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def check_checksum(path):
    sidecar = safe_path(Path(str(path) + ".sha256"))
    expected = sidecar.read_text(encoding="ascii")
    actual = checksum_file(path) + "  " + path.name + "\n"
    if expected != actual:
        raise RuntimeError("backup checksum mismatch: " + str(path))


def temporary_file(directory, prefix):
    fd, name = tempfile.mkstemp(prefix=prefix, suffix=".tmp", dir=str(directory))
    os.close(fd)
    return Path(name)


def clean_temporary(path):
    for suffix in ("", "-wal", "-shm", "-journal"):
        try:
            Path(str(path) + suffix).unlink()
        except FileNotFoundError:
            pass


def compress_snapshot(snapshot, archive, compression):
    if compression == "zst":
        # One thread and the default window keep memory use small on the shared ARM VM.
        with archive.open("wb") as output:
            subprocess.run(["zstd", "-q", "-3", "-T1", "-c", "--", str(snapshot)],
                           stdout=output, check=True)
    else:
        with snapshot.open("rb") as source, gzip.open(archive, "wb", compresslevel=6) as output:
            shutil.copyfileobj(source, output, length=1024 * 1024)


def decompress_snapshot(archive, snapshot, compression):
    if compression == "zst":
        with snapshot.open("wb") as output:
            subprocess.run(["zstd", "-q", "-d", "-c", "--", str(archive)], stdout=output, check=True)
    else:
        opener = gzip.open if compression == "gz" else open
        with opener(archive, "rb") as source, snapshot.open("wb") as output:
            shutil.copyfileobj(source, output, length=1024 * 1024)


def verify_sqlite(path):
    # This file is a closed snapshot, so immutable avoids making WAL/SHM sidecars.
    with closing(sqlite3.connect(path.as_uri() + "?mode=ro&immutable=1", uri=True,
                                timeout=CONNECT_TIMEOUT)) as copy:
        integrity = copy.execute("PRAGMA integrity_check").fetchall()
        if integrity != [("ok",)]:
            raise RuntimeError("backup integrity_check failed: " + repr(integrity))


def extract_verified(archive, snapshot):
    archive = safe_path(archive)
    if archive.name.endswith(".sqlite.zst"):
        compression = "zst"
    elif archive.name.endswith(".sqlite.gz"):
        compression = "gz"
    elif archive.name.endswith(".sqlite"):
        compression = None
    else:
        raise ValueError("unsupported backup format: " + str(archive))
    check_checksum(archive)
    decompress_snapshot(archive, snapshot, compression)
    verify_sqlite(snapshot)


def verify_backup(archive):
    temporary = temporary_file(archive.parent, ".dueling-verify-")
    try:
        extract_verified(archive, temporary)
    finally:
        clean_temporary(temporary)


def rename_new(source, target):
    # Ubuntu's renameat2 provides an atomic rename that cannot replace an existing file.
    libc = ctypes.CDLL(None, use_errno=True)
    rename = libc.renameat2
    rename.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    rename.restype = ctypes.c_int
    # AT_FDCWD=-100; RENAME_NOREPLACE=1. Both paths are absolute.
    if rename(-100, os.fsencode(source), -100, os.fsencode(target), 1) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), str(target))


def restore_backup(archive, target):
    target = safe_path(target)

    def require_absent():
        for suffix in ("", "-wal", "-shm", "-journal"):
            if os.path.lexists(str(target) + suffix):
                raise RuntimeError("restore target or journal already exists: " + str(target) + suffix)

    require_absent()
    temporary = temporary_file(target.parent, ".dueling-restore-")
    try:
        extract_verified(archive, temporary)
        with temporary.open("rb") as data:
            os.fsync(data.fileno())
        require_absent()
        rename_new(temporary, target)
        directory_fd = os.open(str(target.parent), os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        clean_temporary(temporary)


def automatic_backups(directory, release_stamp=None):
    backups = []
    for path in directory.iterdir():
        match = AUTOMATIC_NAME.fullmatch(path.name)
        if not match or path.is_symlink() or not path.is_file():
            continue
        try:
            stamp = datetime.strptime(match.group(1), "%Y%m%d-%H%M%S").replace(tzinfo=UTC)
        except ValueError:
            continue
        backups.append((release_stamp or stamp, safe_path(path, directory)))
    return sorted(backups, key=lambda entry: (entry[0], entry[1].name), reverse=True)


def retained_backups(backups, keep, cutoff, verified=None):
    if not backups:
        return set()
    good = None
    for _, path in backups:
        try:
            if path != verified:
                verify_backup(path)
            good = path
            break
        except Exception as error:
            print("WARNING: dueling-backup: cannot verify {}: {}".format(path, " ".join(str(error).split())),
                  file=sys.stderr)
    if good is None:
        # Disk or codec errors must never turn an unverified retention run into data loss.
        return {path for _, path in backups}
    retained = [path for stamp, path in backups[:keep] if stamp >= cutoff]
    if good not in retained:
        retained = retained[:keep - 1] + [good]
    return set(retained)


def remove_backup(path, root):
    safe_path(path, root).unlink()
    sidecar = Path(str(path) + ".sha256")
    if not sidecar.is_symlink():
        try:
            safe_path(sidecar, root).unlink()
        except FileNotFoundError:
            pass


def backup_context(destination):
    if destination.name in DEPLOY_KINDS and RELEASE_NAME.fullmatch(destination.parent.name):
        return safe_path(destination.parent.parent), destination.name
    return destination, None


def prune_releases(root=None, verified=None):
    root = safe_path(root or DEST_DIR)
    keep = integer_setting(DEPLOY_KEEP_ENV, 3, 1)
    try:
        keep_days = int(os.environ.get(RELEASE_KEEP_ENV, str(MAX_BACKUP_DAYS)))
        if not 1 <= keep_days <= MAX_BACKUP_DAYS:
            raise ValueError
    except ValueError:
        warn_release_pruning(RELEASE_KEEP_ENV + " must be an integer from 1 to 14; using 14 days")
        keep_days = MAX_BACKUP_DAYS

    releases = []
    for path in root.iterdir():
        match = RELEASE_NAME.fullmatch(path.name)
        if not match:
            continue
        try:
            stamp = datetime.strptime(match.group(1), "%Y%m%d-%H%M%S").replace(tzinfo=UTC)
        except ValueError:
            continue
        try:
            path = safe_path(path, root)
            if path.is_dir():
                releases.append((stamp, path, release_tree(path, root)))
        except Exception as error:
            warn_release_pruning(error)

    releases.sort(key=lambda entry: entry[0], reverse=True)
    now = datetime.now(UTC)
    # Never shorter than one day, so a run during a deploy cannot delete the copy being written.
    database_cutoff = now - max(timedelta(days=keep_days) - RUN_INTERVAL, RUN_INTERVAL)
    directory_cutoff = now - timedelta(days=MAX_BACKUP_DAYS) + RUN_INTERVAL
    copies = {kind: [] for kind in DEPLOY_KINDS}
    for stamp, path, _ in releases:
        for kind in DEPLOY_KINDS:
            directory = path / kind
            if directory.is_dir():
                copies[kind].extend(automatic_backups(directory, stamp))
    retained = set()
    stats = {}
    for kind, backups in copies.items():
        backups.sort(key=lambda entry: (entry[0], entry[1].name), reverse=True)
        selected = retained_backups(backups, keep, database_cutoff, verified)
        retained.update(selected)
        stats[kind] = (len(selected), sum(path.stat().st_size for path in selected))

    for index, (stamp, path, paths) in enumerate(releases):
        try:
            if index > 0 and stamp < directory_cutoff and not any(path in p.parents for p in retained):
                remove_release_path(path, root)
                continue
            for kind in DEPLOY_KINDS:
                for _, copy in copies[kind]:
                    if path in copy.parents and copy not in retained:
                        remove_backup(copy, root)
            if stamp >= database_cutoff:
                continue
            # Keep rollback metadata and the last verified copy of each kind.
            removed_dirs = []
            for child in paths[1:]:
                if any(parent in removed_dirs for parent in child.parents):
                    continue
                if child in retained or any(child in p.parents for p in retained):
                    continue
                if not child.exists():
                    continue
                if child.name.endswith(".sha256") and Path(str(child)[:-7]) in retained:
                    continue
                if child == path / "online" or child == path / "drained" or ".sqlite" in child.name:
                    is_directory = child.is_dir()
                    remove_release_path(child, root)
                    if is_directory:
                        removed_dirs.append(child)
        except Exception as error:
            warn_release_pruning(error)
    return stats


def prune_backups(keep, verified=None):
    root = safe_path(DEST_DIR)
    cutoff = datetime.now(UTC) - timedelta(days=MAX_BACKUP_DAYS) + RUN_INTERVAL
    backups = automatic_backups(root)
    retained = retained_backups(backups, keep, cutoff, verified)
    for _, path in backups:
        if path not in retained:
            remove_backup(path, root)
    return len(retained), sum(path.stat().st_size for path in retained)


def create_backup():
    keep = integer_setting(KEEP_ENV, 7, 1)
    integer_setting(DEPLOY_KEEP_ENV, 3, 1)
    reserve = integer_setting(MIN_FREE_ENV, DEFAULT_MIN_FREE_BYTES, 0)

    destination = safe_path(DEST_DIR)
    destination.mkdir(mode=0o700, parents=True, exist_ok=True)
    root, kind = backup_context(destination)
    temporary_paths = []
    directory_fd = os.open(str(root), os.O_RDONLY | os.O_DIRECTORY)
    try:
        # Lock the directory itself, avoiding an extra lock file or overlapping runs.
        try:
            fcntl.flock(directory_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("another backup is already running for " + str(root))

        source = SRC.absolute()
        source_size = source.stat().st_size
        try:
            wal_size = Path(str(source) + "-wal").stat().st_size
        except FileNotFoundError:
            wal_size = 0
        required = reserve + SPACE_MULTIPLIER * (source_size + wal_size)
        free = shutil.disk_usage(destination).free
        if free < required:
            raise BackupSkipped("insufficient free space: need {} bytes (including {} reserve), have {} in {}".format(
                required, reserve, free, destination))

        fd, temporary_name = tempfile.mkstemp(prefix=".dueling-backup-", suffix=".tmp", dir=str(destination))
        temporary = Path(temporary_name)
        temporary_paths.append(temporary)
        os.close(fd)
        # URI escaping handles spaces, '?' and '#'. Never use immutable=1 on live WAL.
        # mode=ro still needs access to the live -shm file; the data directory is writable.
        with closing(sqlite3.connect(source.as_uri() + "?mode=ro", uri=True, timeout=CONNECT_TIMEOUT)) as live:
            with closing(sqlite3.connect(str(temporary), timeout=CONNECT_TIMEOUT)) as copy:
                # One WAL read transaction gives a consistent snapshot without blocking writers; incremental steps can restart indefinitely under steady writes.
                live.backup(copy)
                journal = copy.execute("PRAGMA journal_mode=DELETE").fetchone()
                if journal != ("delete",):
                    raise RuntimeError("could not switch backup to journal_mode=DELETE")
        compression = "zst" if shutil.which("zstd") else "gz"
        archive = temporary_file(destination, ".dueling-compressed-")
        temporary_paths.append(archive)
        compress_snapshot(temporary, archive, compression)
        # Reuse the raw snapshot's space for the decompressed verification file.
        temporary.unlink()
        decompress_snapshot(archive, temporary, compression)
        verify_sqlite(temporary)
        temporary.unlink()
        with archive.open("rb") as data:
            os.fsync(data.fileno())
        checksum = checksum_file(archive)
        size = archive.stat().st_size
        now = datetime.now(UTC)
        stem = destination / now.strftime("bot-%Y%m%d-%H%M%SZ.sqlite")
        final = Path(str(stem) + "." + compression)
        sidecar = Path(str(final) + ".sha256")
        for suffix in ("", ".gz", ".zst"):
            candidate = Path(str(stem) + suffix)
            if os.path.lexists(candidate) or os.path.lexists(str(candidate) + ".sha256"):
                raise RuntimeError("backup name already exists; retry in the next second: " + str(candidate))

        fd, checksum_name = tempfile.mkstemp(prefix=".dueling-sha256-", suffix=".tmp", dir=str(destination))
        checksum_temporary = Path(checksum_name)
        temporary_paths.append(checksum_temporary)
        with os.fdopen(fd, "w", encoding="ascii") as output:
            os.fchmod(output.fileno(), 0o600)
            output.write(checksum + "  " + final.name + "\n")
            output.flush()
            os.fsync(output.fileno())

        os.rename(archive, final)
        temporary_paths.append(final)
        os.rename(checksum_temporary, sidecar)
        temporary_paths.append(sidecar)
        snapshot_directory_fd = os.open(str(destination), os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(snapshot_directory_fd)
        finally:
            os.close(snapshot_directory_fd)
        temporary_paths.remove(final)
        temporary_paths.remove(sidecar)
        if kind is None:
            try:
                kept, total_bytes = prune_backups(keep, verified=final)
            finally:
                # A failed daily prune must not prevent deploy retention.
                try:
                    prune_releases(root)
                except Exception as error:
                    warn_release_pruning(error)
        else:
            kept, total_bytes = 1, size
            try:
                stats = prune_releases(root, verified=final)
                kept, total_bytes = stats[kind]
            except Exception as error:
                warn_release_pruning(error)
        os.fsync(directory_fd)
        return final, size, checksum, kept, total_bytes
    finally:
        try:
            # Remove only our own temporary files and SQLite's associated journals.
            for temporary in temporary_paths:
                clean_temporary(temporary)
        finally:
            os.close(directory_fd)


def main():
    try:
        path, size, checksum, kept, total_bytes = create_backup()
        print("{} {} {} kept={} total_bytes={}".format(path, size, checksum, kept, total_bytes))
        return 0
    except (Exception, KeyboardInterrupt) as error:
        message = " ".join(str(error).split()) or type(error).__name__
        label = "SKIPPED" if isinstance(error, BackupSkipped) else "ERROR"
        print(label + ": dueling-backup: " + message, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
