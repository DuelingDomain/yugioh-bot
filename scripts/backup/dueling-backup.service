[Unit]
Description=Compressed and verified SQLite backup for the Dueling System

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/yugioh-bot/scripts/backup/dueling-backup
# Use a service drop-in to change DUELING_BACKUP_KEEP (7),
# DUELING_DEPLOY_BACKUP_KEEP (3), or DUELING_BACKUP_MIN_FREE_BYTES (1073741824).
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
# Live WAL readers need write access to -shm: keep the data directory writable.
