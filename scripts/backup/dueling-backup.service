[Unit]
Description=Compressed and verified SQLite backup for the Dueling System

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/yugioh-bot/scripts/backup/dueling-backup
# Share count, age, space and lock settings with deployment runs.
EnvironmentFile=-/etc/default/dueling-backup
Nice=10
CPUWeight=20
IOWeight=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
# Live WAL readers need write access to -shm: keep the data directory writable.
