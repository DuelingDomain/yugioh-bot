# PR 1: only literal 1 enables bot startup and command deployment.
DISCORD_BOT_ENABLED=1
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REMINDER_CHANNEL_ID=
DISCORD_DEFAULT_CHANNEL_ID=

# App hostname without scheme, used by Caddy.
SITE_DOMAIN=localhost
# Optional static marketing and legacy redirect hosts (no scheme).
# Empty/unset uses reserved .localhost defaults: no public ACME requests.
# Local preview: MARKETING_DOMAIN=marketing.localhost
# Production: SITE_DOMAIN=app.duelingdomain.com, MARKETING_DOMAIN=duelingdomain.com,
# LEGACY_DOMAIN=duelistskingdom.com. See docs/deployment/domains.md.
MARKETING_DOMAIN=
LEGACY_DOMAIN=

# --- Web App Auth (packages/web) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Production: https://${SITE_DOMAIN} (Compose expands it)
# If AUTH_URL is also set, keep it on the same app origin.
# Local: http://localhost:3000
NEXTAUTH_URL=
# Marketing site URL without a trailing slash; leave empty to hide external sign-in links.
MARKETING_URL=

# --- Bot Web URL (used in Discord announcement messages) ---
# Production: https://${SITE_DOMAIN}; keep aligned with NEXTAUTH_URL.
# Local: http://localhost:3000
WEB_URL=http://localhost:3000

# --- WebSocket Server (packages/ws) ---
# Dev only (separate ws port). Production: leave unset; the browser uses the page origin.
NEXT_PUBLIC_WS_URL=http://localhost:3001

# --- Internal HMAC channel: web/bot/duel/worker -> ws (packages/ws/src/internal-http.ts) ---
# Same secret on web, bot, duel, worker, and ws. Draft/tournament broadcasts and
# /internal/duel/changed invalidations use signed HTTP requests.
# Duel browser subscriptions use short-lived room-scoped tokens with this secret.
# Generate with: openssl rand -hex 32
WS_INTERNAL_SECRET=
# In docker-compose, web reaches ws by service name on the internal network:
WS_INTERNAL_URL=http://ws:4002

# --- Internal HMAC channel: web/worker -> bot announces (packages/bot/src/announce/server.ts) ---
# Same shape as WS_INTERNAL_*. Web posts signed announces about new drafts and
# tournaments so the bot can echo them into Discord channels.
# Generate with: openssl rand -hex 32
BOT_ANNOUNCE_SECRET=
BOT_ANNOUNCE_URL=http://bot:4001

# --- Private automated duel engine (never expose port 4003 publicly) ---
# Generate with: openssl rand -hex 32; same secret on web and duel processes.
DUEL_INTERNAL_SECRET=
# Host development uses loopback; Compose overrides this to http://duel:4003.
DUEL_INTERNAL_URL=http://127.0.0.1:4003
# Run npm run duel:prepare before starting the engine.
DUEL_DATA_DIR=./data/duel-engine
# Archive terminal tables after 10 minutes; retain database records/final boards.
DUEL_ARCHIVE_AFTER_MS=600000
# Release idle engine workers after 5 minutes; reconnect replays accepted inputs.
DUEL_IDLE_WORKER_MS=300000

# --- In-app Report bug button (web only; server side, never sent to the browser) ---
# Fine-grained GitHub token with Issues: read and write on the repo below. Leave it empty to only save reports
# in the database (the dialog then says "Saved"). See docs/deployment/vm-runbook.md.
BUG_REPORT_GITHUB_TOKEN=
BUG_REPORT_GITHUB_REPO=imran443/yugioh-bot

# --- Shared ---
# Native development: set both to absolute paths in your checkout before starting services.
# Compose overrides these with /app/data paths shared by every consumer.
DATABASE_PATH=
CARD_IMAGE_CACHE_DIR=
CARD_IMAGE_CACHE_MAX_BYTES=16106127360
SETS_SYNC_CRON=0 6 * * *
SETS_SYNC_TIMEZONE=UTC
IMAGE_CLEANUP_CRON=0 4 * * *
IMAGE_CLEANUP_TIMEZONE=UTC
# Optional native override; choose a unique heartbeat path per isolated database.
WORKER_HEALTH_PATH=/tmp/yugidraft-worker-health.json
REMINDER_CRON=0 10 * * *
REMINDER_TIMEZONE=America/New_York
