# Admin Discord bot. See docs/deployment/discord-bot.md. Only literal 1 enables it.
DISCORD_BOT_ENABLED=0
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Existing site data guild. Do not change this to move the bot.
DISCORD_GUILD_ID=
# Discord server for the admin bot. Empty uses DISCORD_GUILD_ID.
DISCORD_BOT_GUILD_ID=
DISCORD_MODERATOR_ROLE_ID=
DISCORD_MOD_LOG_CHANNEL_ID=
# Private #signups channel; this variable retains the waitlist service name.
DISCORD_WAITLIST_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
# Optional member welcome cards; empty disables automatic welcomes.
DISCORD_WELCOME_CHANNEL_ID=
# Native development only. Compose uses a container-local path.
BOT_HEALTH_PATH=/tmp/yugidraft-bot-health.json

# Caddy hosts without schemes. See docs/deployment/domains.md.
SITE_DOMAIN=localhost
# Cutover: SITE_DOMAIN=app.duelingdomain.com, MARKETING_DOMAIN=duelingdomain.com,
# LEGACY_DOMAIN=duelistskingdom.com. Empty extras use reserved .localhost defaults.
# Local preview: MARKETING_DOMAIN=marketing.localhost
MARKETING_DOMAIN=
LEGACY_DOMAIN=

# --- Clerk custom auth (packages/web) ---
# Production publishable key: repository variable and web build arg only.
# Local dev: pull dev keys into ignored packages/web/.env.local; never reuse them in staging/prod.
# Staging uses its own instance/source, not production keys or dev keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Runtime web and admin bot secret. Never supply this to docker build or commit it.
# Owner CLI: pass explicitly with docker compose run --rm --no-deps -e CLERK_SECRET_KEY worker ...
CLERK_SECRET_KEY=
# Optional signed Clerk events. See docs/deployment/discord-join-alerts.md.
CLERK_WEBHOOK_SIGNING_SECRET=
# Web-only durable alerts through the admin bot. Independent of legacy gameplay Discord effects.
# Requires DISCORD_WAITLIST_CHANNEL_ID; missing channel falls back to the webhook below.
DISCORD_ADMIN_OUTBOX_ENABLED=0
# Private admin channel webhook; runtime web only, independent of DISCORD_BOT_ENABLED.
DISCORD_ADMIN_WEBHOOK_URL=
# Literal 1 enables an alert type. Join requests default on; sign-ups default off.
DISCORD_JOIN_REQUEST_ALERTS_ENABLED=1
DISCORD_SIGNUP_ALERTS_ENABLED=0
# Mask email by default. Use 1 only if the private channel may show full emails.
DISCORD_ADMIN_SHOW_FULL_EMAIL=0
# Optional HTTPS admin page. Empty uses https://dashboard.clerk.com/.
DISCORD_ADMIN_DASHBOARD_URL=
# Canonical app origin; required by WS CORS and web links. No trailing slash.
WEB_URL=http://localhost:3000
# Marketing URL without a trailing slash; empty hides external sign-in links.
MARKETING_URL=
# Comma-separated users.id values that may open owner-only pages (card data status). Empty = nobody.
OWNER_USER_IDS=
# E2E_AUTH=1 and a >=32-character E2E_AUTH_SECRET are isolated-test-only.
# Compose production/staging do not forward these to web.

# --- Product analytics (PostHog EU) ---
# Keep keys empty until the approved privacy policy is live; enable cookieless server hash mode in the project.
# App: Actions repository variable/web build arg. Landing page: VM runtime env passed only to Caddy.
NEXT_PUBLIC_POSTHOG_KEY=
# Worker-only project key, persons write key and project ID. Never supply the personal key to a build.
POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Empty uses the EU ingest default. Persons requests use the EU application API host.
POSTHOG_HOST=https://eu.i.posthog.com
# Admin console (/admin) Usage section: link to your PostHog dashboard.
POSTHOG_DASHBOARD_URL=
# Admin console presence heartbeat; set 0 to turn the Online now data off.
PRESENCE_ENABLED=1

# --- WebSocket Server (packages/ws) ---
# Dev only (separate ws port). Production: leave unset; the browser uses the page origin.
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Compose memory limit for the WebSocket server.
WS_MEM_LIMIT=384m

# --- Internal HMAC channel: web/duel/worker -> ws (packages/ws/src/internal-http.ts) ---
# Same secret on web, duel, worker, and ws. Draft/tournament broadcasts and
# /internal/duel/changed invalidations use signed HTTP requests.
# Duel browser subscriptions use short-lived room-scoped tokens with this secret.
# Generate with: openssl rand -hex 32
WS_INTERNAL_SECRET=
# In docker-compose, web reaches ws by service name on the internal network:
WS_INTERNAL_URL=http://ws:4002

# --- Private automated duel engine (never expose port 4003 publicly) ---
# Generate with: openssl rand -hex 32; same secret on web and duel processes.
DUEL_INTERNAL_SECRET=
# Host development uses loopback; Compose overrides this to http://duel:4003.
DUEL_INTERNAL_URL=http://127.0.0.1:4003
# Run npm run duel:prepare before starting the engine.
DUEL_DATA_DIR=./data/duel-engine
# Archive terminal tables after 10 minutes; retain database records/final boards.
DUEL_ARCHIVE_AFTER_MS=600000
# Compress old final boards in bounded background batches. No board data is deleted.
# Off for this release; set 1 after a stable codec release to enable compression and fork cleanup.
# Turn-only backfill runs even while retention is off; set its separate switch to 0 to stop it.
DUEL_TURN_BACKFILL_ENABLED=1
DUEL_SNAPSHOT_RETENTION_ENABLED=0
DUEL_SNAPSHOT_RETENTION_DAYS=30
DUEL_SNAPSHOT_RETENTION_INTERVAL_MS=21600000
# Release idle engine workers after 5 minutes; reconnect replays accepted inputs.
DUEL_IDLE_WORKER_MS=300000
# Live games and replay rebuilds share worker capacity; at most 32 rebuilds wait.
DUEL_MAX_WORKERS=12
DUEL_MAX_TABLES_PER_PLAYER=3
DUEL_WORKER_HEAP_MB=256
DUEL_OP_TIMEOUT_MS=15000
DUEL_CREATE_TIMEOUT_MS=120000

# --- In-app Report bug button (web only; server side, never sent to the browser) ---
# Fine-grained GitHub token with resource owner DuelingDomain and Issues: read and write on the repo below.
# The org must allow/approve the token. Leave it empty to only save reports
# in the database (the dialog then says "Saved"). See docs/deployment/vm-runbook.md.
BUG_REPORT_GITHUB_TOKEN=
BUG_REPORT_GITHUB_REPO=DuelingDomain/yugioh-bot

# --- Web feature gates (server runtime) ---
MULTIPLAYER_TABLES=1
DUEL_SCENARIOS=0
DUEL_FX_LAB=0
DRAFT_TEST_BOTS=0
# Archetype bridges (Bridges tab, "See bridges" offer, /api/cards/bridges/*). Off unless set to 1.
BRIDGES_ENABLED=0

# --- Shared ---
# Native development: set both to absolute paths in your checkout before starting services.
# Compose overrides these with /app/data paths shared by every consumer.
DATABASE_PATH=
CARD_IMAGE_CACHE_DIR=
CARD_IMAGE_CACHE_MAX_BYTES=16106127360
SETS_SYNC_CRON=0 6 * * *
SETS_SYNC_TIMEZONE=UTC
IMAGE_CLEANUP_CRON=0 4 * * *
IMAGE_CLEANUP_TIMEZONE=UTC
# Optional native override; choose a unique heartbeat path per isolated database.
WORKER_HEALTH_PATH=/tmp/yugidraft-worker-health.json

# --- Error reporting (empty DSNs keep console output) ---
# Create projects in the Sentry EU region. Server services share the server DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Deployed git SHA; the production deploy supplies it for build and runtime.
SENTRY_RELEASE=
# Source-map upload destinations (also set these GitHub repository variables).
# SENTRY_PROJECT accepts a comma-separated list; include both web DSN projects.
SENTRY_ORG=
SENTRY_PROJECT=
# Admin console (/admin) Errors section. Read-only token; see docs/deployment/admin-console.md.
SENTRY_API_TOKEN=
# API host for the Errors section; https://de.sentry.io for the EU region (default https://sentry.io).
SENTRY_BASE_URL=
# SENTRY_AUTH_TOKEN is a production GitHub environment secret, never runtime env.
# For a manual upload, set SENTRY_UPLOAD_SOURCEMAPS=1 and point
# SENTRY_AUTH_TOKEN_FILE to a private token file.
# Without that override Compose uses /dev/null and skips upload.

# Remote physical-card tables. Enable on both web and ws for local development.
REMOTE_DUELS=0
# Multiplayer media (web server only). Solo needs none of these.
# Local: ws://127.0.0.1:7880, devkey, secret. Cloud: wss://<project>.livekit.cloud.
# See docs/remote-duels/video.md; never prefix the API secret with NEXT_PUBLIC_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Card recognition feedback: explicit deployment opt-in, plus each user's opt-in.
# Crops live beside DATABASE_PATH under vision-feedback/; worker prunes hourly.
REMOTE_VISION_FEEDBACK=0
# Optional absolute asset directory; must match the index loaded by the browser.
# VISION_DATA_DIR=/absolute/path/to/data/vision

# Local sandbox access: comma-separated Discord user IDs.
SANDBOX_DISCORD_IDS=
