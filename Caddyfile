# Real client IP. The web app reads the first X-Forwarded-For entry for rate
# limits, so Caddy must write the real address there. Only Cloudflare ranges are
# trusted to send CF-Connecting-IP; any other peer is used as the client address,
# so this is the same with or without Cloudflare in front. Source:
# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
# (checked 2026-10-25). See docs/deployment/cloudflare.md before you edit this list.
{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

(posthog_ingest) {
    handle /ingest/static/* {
        uri strip_prefix /ingest
        reverse_proxy https://eu-assets.i.posthog.com {
            header_up Host {upstream_hostport}
            header_up X-Forwarded-For {client_ip}
            header_up -Cookie
            header_up -Authorization
            header_up -Referer
        }
    }
    @ingest path /ingest /ingest/*
    handle @ingest {
        uri strip_prefix /ingest
        reverse_proxy https://eu.i.posthog.com {
            header_up Host {upstream_hostport}
            header_up X-Forwarded-For {client_ip}
            header_up -Cookie
            header_up -Authorization
            header_up -Referer
        }
    }
}

{$SITE_DOMAIN} {
    request_body {
        max_size 1MB
    }
    # Allow crawling so search engines can read noindex, including on redirects.
    # Authentication still protects private app content.
    header >X-Robots-Tag "noindex, nofollow"
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://clerk.app.duelingdomain.com https://challenges.cloudflare.com https://*.protect.clerk.com; connect-src 'self' wss://{$SITE_DOMAIN} https://clerk.app.duelingdomain.com https://*.protect.clerk.com:* https://clerk-telemetry.com https://*.clerk-telemetry.com https://img.clerk.com; img-src 'self' data: blob: https://img.clerk.com https://images.ygoprodeck.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://challenges.cloudflare.com https://*.protect.clerk.com https://www.youtube-nocookie.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
    handle /robots.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond "User-agent: *
Allow: /
" 200
    }
    handle /socket.io/* {
        reverse_proxy ws:3001
    }
    # Health check for the maintenance page. It asks web for a public static file
    # and answers 200 only when web itself answered 2xx. No retry hold, so a down
    # web fails at once. A failure lands in the JSON branch of handle_errors below,
    # never in the maintenance page (fetch sends Sec-Fetch-Dest: empty).
    handle /healthz {
        rewrite * /icon.svg
        reverse_proxy web:3000 {
            @up status 2xx
            handle_response @up {
                header Cache-Control "no-store"
                header Content-Type "text/plain; charset=utf-8"
                respond "ok" 200
            }
        }
    }
    import posthog_ingest
    handle {
        reverse_proxy web:3000 {
            # Hold through a web-only restart. Keep the default GET-only
            # round-trip retries: POST may retry only if dialing failed.
            lb_try_duration 30s
            lb_try_interval 250ms
            fail_duration 1s
            max_fails 1
            # One trusted value for rate limits, never a client-supplied list.
            # Host and scheme come from this request: a client behind a trusted
            # Cloudflare peer cannot set them (Clerk and Next read them).
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Caddy could not reach web or ws (restart, crash) and the 30 s hold is over.
    # Upstream 5xx replies from the app pass through unchanged; only Caddy's own
    # 502/503/504 land here. Browser page loads get the static maintenance page;
    # API, Socket.IO and asset callers get a small JSON error with the real status.
    # The page lives in site/maintenance (mounted at /srv/maintenance).
    handle_errors 502 503 504 {
        @document {
            method GET HEAD
            header Accept *text/html*
            not header Sec-Fetch-Dest empty
            not path /socket.io/* /ingest/*
        }
        handle @document {
            root * /srv/maintenance
            rewrite * /index.html
            header Cache-Control "no-store"
            header Retry-After "15"
            header X-Robots-Tag "noindex, nofollow"
            file_server {
                status 503
            }
        }
        handle {
            header Cache-Control "no-store"
            header Retry-After "15"
            header Content-Type "application/json; charset=utf-8"
            respond `{"error":"service_unavailable","retryable":true}` {err.status_code}
        }
    }
}

# Canonical host, including old HTTP IP links posted in Discord.
www.{$SITE_DOMAIN}, http:// {
    redir https://{$SITE_DOMAIN}{uri} 308
}

# Reserved local defaults never request public ACME certificates. Compose also
# substitutes these when a variable is present but empty. SITE_DOMAIN stays the app.
{$MARKETING_DOMAIN:marketing-disabled.localhost} {
    root * /srv/site
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        # Inline styles are used by the SVG effects and generated dust particles.
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }

    # The app shares a routing hint, never a credential, on .duelingdomain.com.
    # Keep both HTML and redirect variants out of shared/browser caches.
    @marketingHome path / /index.html
    header @marketingHome {
        Vary Cookie
        Cache-Control "private, no-store"
    }
    @returningMember {
        method GET
        path / /index.html
        header_regexp Cookie "(^|;[[:blank:]]*)dd_signed_in=1(;|$)"
        not query home=1
    }
    redir @returningMember https://{$SITE_DOMAIN}/ 302

    @waitlist {
        path /api/waitlist
        method POST
    }
    handle @waitlist {
        reverse_proxy web:3000 {
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    import posthog_ingest
    handle /login {
        redir https://{$SITE_DOMAIN}/login 302
    }
    @notFound path /404 /404.html
    handle @notFound {
        error 404
    }
    handle {
        encode zstd gzip
        # Files aren't fingerprinted; browsers revalidate after a short cache.
        header ?Cache-Control "public, max-age=300, must-revalidate"
        @media {
            path *.png *.jpg *.jpeg *.gif *.webp *.avif *.svg *.ico *.woff *.woff2 *.ttf *.otf
            not path /fonts/*.woff2
        }
        header @media Cache-Control "public, max-age=86400"
        @fonts path /fonts/*.woff2
        header @fonts Cache-Control "public, max-age=31536000"
        @manifest path /site.webmanifest
        header @manifest Content-Type "application/manifest+json"
        @llms path /llms.txt
        header @llms Content-Type "text/plain; charset=utf-8"
        templates @marketingHome {
            mime text/html
        }
        try_files {path} {path}.html {path}/index.html =404
        file_server
    }
    handle_errors 404 {
        header Cache-Control "no-store"
        header X-Robots-Tag "noindex"
        rewrite * /404.html
        file_server
    }
}

# Explicit HTTP matches take precedence over the app's existing HTTP catch-all.
www.{$MARKETING_DOMAIN:marketing-disabled.localhost}, http://{$MARKETING_DOMAIN:marketing-disabled.localhost}, http://www.{$MARKETING_DOMAIN:marketing-disabled.localhost} {
    redir https://{$MARKETING_DOMAIN:marketing-disabled.localhost}{uri} 308
}

{$LEGACY_DOMAIN:legacy-disabled.localhost}, www.{$LEGACY_DOMAIN:legacy-disabled.localhost}, http://{$LEGACY_DOMAIN:legacy-disabled.localhost}, http://www.{$LEGACY_DOMAIN:legacy-disabled.localhost} {
    redir https://{$SITE_DOMAIN}{uri} 308
}
